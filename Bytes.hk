[package]
-> name        => legendaryos-builder
-> version     => 0.6
-> description => Narzędzie do budowy dystrybucji LegendaryOS (bazującej na HackerOS) — nakładka na live-build
-> author      => LegendaryOS Team
-> license     => MIT

[build]
-> lang     => h#
-> entry    => src/main.h#
-> output   => build/legendaryos-builder
-> include  => src/

[deps]
-> git => newest
