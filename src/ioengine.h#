mod text
mod sys
mod store
use "std -> fs" from "fs"

;; Silnik wsadowego I/O.
;;
;; H# 0.9 nie ma async I/O ani wiązań do liburing, więc jest jeden,
;; sekwencyjny backend z API gotowym pod szybszy backend (IoJob, read_batch,
;; write_batch). Dla najcięższej
;; operacji — składania plików z chunków przy materializacji — jest szybka
;; ścieżka `concat_files`, która deleguje do `cat` (kopiowanie jądro->jądro
;; bez trzymania danych w pamięci procesu).

pub struct IoJob is
    pub path: string
    pub data: [int]
end

pub struct IoEngine is
    pub concurrency: int
end

pub fn new_engine(concurrency: int) -> IoEngine is
    return IoEngine { concurrency: concurrency }
end

pub fn default_engine() -> IoEngine is
    return IoEngine { concurrency: 64 }
end

pub fn close(eng: IoEngine) is
end

pub fn read_file(eng: IoEngine, path: string) -> [int] is
    let b: bytes = fs::read_bytes(path)
    return store::bytes_to_ints(b)
end

pub fn write_file(eng: IoEngine, path: string, data: [int]) -> bool is
    let b: bytes = data
    fs::write_bytes(path, b)
    let n: int = data.len()
    return fs::size(path) == n
end

pub fn read_batch(eng: IoEngine, paths: [string]) -> [[int]] is
    let mut out: [[int]] = []
    for p in paths is
        out.push(read_file(eng, p))
    end
    return out
end

;; Zwraca liczbę poprawnie zapisanych zadań (== jobs.len() gdy wszystko ok).
pub fn write_batch(eng: IoEngine, jobs: [IoJob]) -> int is
    let mut done: int = 0
    for j in jobs is
        if write_file(eng, j.path, j.data) is done += 1 end
    end
    return done
end

;; Składa `dest` z konkatenacji plików `parts` (po kolei). Pusta lista =
;; pusty plik. Porcjuje wywołania, by nie przekroczyć ARG_MAX.
pub fn concat_files(parts: [string], dest: string) -> bool is
    let r0: sys::Exec = sys::exec(": > " + sys::sq(dest))
    if r0.code != 0 is return false end
    let n: int = parts.len()
    let batch: int = 200
    let mut i: int = 0
    while i < n is
        let mut j: int = i + batch
        if j > n is j = n end
        let mut args: string = ""
        let mut k: int = i
        while k < j is
            args = args + " " + sys::sq(parts[k])
            k += 1
        end
        let r: sys::Exec = sys::exec("cat" + args + " >> " + sys::sq(dest))
        if r.code != 0 is return false end
        i = j
    end
    return true
end
