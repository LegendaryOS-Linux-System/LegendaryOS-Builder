;; Statystyki: rozmiar store, rozmiar drzewa z manifestu, współczynnik
;; deduplikacji (rozmiar logiczny / bajty unikalnych chunków) oraz ile miejsca
;; zwolniłby `fasttree gc`.

pub struct ManifestStats is
    pub files:         int
    pub executables:   int
    pub dirs:          int
    pub symlinks:      int
    pub logical_bytes: int
    pub chunk_refs:    int
    pub unique_chunks: int
    pub unique_bytes:  int
end

;; Liczy statystyki jednego manifestu. Rozmiary unikalnych chunków czytane
;; ze store (chunk nieobecny w store liczy się jako 0 B).
pub fn manifest_stats(m: manifest::Manifest, s: store::Store) -> ManifestStats is
    let mut files: int = 0
    let mut execs: int = 0
    let mut dirs: int = 0
    let mut links: int = 0
    let mut logical: int = 0
    let mut refs: int = 0
    let mut uniq: int = 0
    let mut ubytes: int = 0
    let mut seen = col::hashmap_new()
    let n: int = m.entries.len()
    let mut i: int = 0
    while i < n is
        let e: manifest::FileEntry = m.entries[i]
        i += 1
        let mode: string = e.mode
        if mode == "directory" is
            dirs += 1
        else if mode == "symlink" is
            links += 1
        else is
            files += 1
            if mode == "executable" is execs += 1 end
            logical += e.size
            let nc: int = e.chunks.len()
            let mut k: int = 0
            while k < nc is
                let h: string = e.chunks[k]
                k += 1
                refs += 1
                if !col::hashmap_contains(seen, h) is
                    seen = col::hashmap_insert(seen, h, "1")
                    uniq += 1
                    ubytes += store::object_size(s, h)
                end
            end
        end
    end
    return ManifestStats { files: files, executables: execs, dirs: dirs, symlinks: links,
        logical_bytes: logical, chunk_refs: refs, unique_chunks: uniq, unique_bytes: ubytes }
end

pub struct RepoStats is
    pub ok:                bool
    pub error:             string
    pub tags:              int
    pub store_objects:     int
    pub store_bytes:       int
    pub referenced_objects: int
    pub referenced_bytes:  int
    pub orphan_objects:    int
    pub orphan_bytes:      int
    pub logical_bytes:     int
    pub gc_reclaimable:    int
end

fn rs_fail(msg: string) -> RepoStats is
    return RepoStats { ok: false, error: msg, tags: 0, store_objects: 0, store_bytes: 0,
        referenced_objects: 0, referenced_bytes: 0, orphan_objects: 0, orphan_bytes: 0,
        logical_bytes: 0, gc_reclaimable: 0 }
end

;; Statystyki całego repo pod `root`. "Referenced" = chunki użyte przez
;; dowolny manifest w manifests/; "orphan" = reszta store. `gc_reclaimable`
;; to wynik `gc --dry-run` (GC trzyma tylko CURRENT_TAG + pins, więc zwykle
;; zwolni więcej niż same sieroty).
pub fn repo_stats(root: string) -> RepoStats is
    let o: store::OpenResult = store::open(text::path_join(root, "store"))
    if !o.ok is return rs_fail(o.error) end
    let tags: [string] = repo::list_tags(root)
    let nt: int = tags.len()
    let mut refset = col::hashmap_new()
    let mut logical: int = 0
    let mut t: int = 0
    while t < nt is
        let tag: string = tags[t]
        t += 1
        let pr: manifest::ParseResult = manifest::load(manifest::manifest_path_in(root, tag))
        if !pr.ok is return rs_fail("manifest '" + tag + "': " + pr.error) end
        let n: int = pr.manifest.entries.len()
        let mut i: int = 0
        while i < n is
            let e: manifest::FileEntry = pr.manifest.entries[i]
            i += 1
            logical += e.size
            let nc: int = e.chunks.len()
            let mut k: int = 0
            while k < nc is
                let h: string = e.chunks[k]
                k += 1
                refset = col::hashmap_insert(refset, h, "1")
            end
        end
    end
    let all: [string] = store::list_all(o.store)
    let na: int = all.len()
    let mut sbytes: int = 0
    let mut rbytes: int = 0
    let mut robjs: int = 0
    let mut a: int = 0
    while a < na is
        let h2: string = all[a]
        a += 1
        let sz: int = store::object_size(o.store, h2)
        sbytes += sz
        if col::hashmap_contains(refset, h2) is
            robjs += 1
            rbytes += sz
        end
    end
    let mut reclaim: int = 0
    let g: gc::GcResult = gc::run_gc(root, true)
    if g.ok is reclaim = g.freed_bytes end
    return RepoStats { ok: true, error: "", tags: nt, store_objects: na, store_bytes: sbytes,
        referenced_objects: robjs, referenced_bytes: rbytes, orphan_objects: na - robjs,
        orphan_bytes: sbytes - rbytes, logical_bytes: logical, gc_reclaimable: reclaim }
end

;; Współczynnik deduplikacji ×100 (np. 235 = 2.35x); 0 gdy brak danych.
pub fn ratio_x100(logical: int, physical: int) -> int is
    if physical <= 0 is return 0 end
    return (logical * 100) / physical
end

pub fn fmt_ratio(x100: int) -> string is
    let whole: int = x100 / 100
    let frac: int = x100 % 100
    let mut fs2: string = text::istr(frac)
    if frac < 10 is fs2 = "0" + fs2 end
    return text::istr(whole) + "." + fs2 + "x"
end

;; Rozmiar czytelny dla człowieka (binarnie, jedno miejsce po przecinku).
pub fn human_bytes(n: int) -> string is
    if n < 1024 is return text::istr(n) + " B" end
    let mut units: [string] = ["KiB", "MiB", "GiB", "TiB"]
    let mut v: int = n * 10
    let mut u: int = 0
    v = v / 1024
    while v >= 10240 && u < 3 is
        v = v / 1024
        u += 1
    end
    let whole: int = v / 10
    let frac: int = v % 10
    return text::istr(whole) + "." + text::istr(frac) + " " + units[u]
end
