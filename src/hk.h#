mod text
use "std -> fs" from "fs"

;; ── Parser formatu .hk (HackerOS) ───────────────────────────────────────────
;;
;;   ! komentarz całej linii
;;   [sekcja]
;;   -> klucz => wartość            wartość = reszta linii (bez cudzysłowów)
;;   -> klucz => [a, "b c", d]      lista (elementy po przecinku, cudzysłowy opcjonalne)
;;   -> grupa                       klucz bez wartości: nagłówek zagnieżdżenia
;;   --> pod => wartość             zagnieżdżenie: zapisane jako "grupa.pod"
;;
;; To jest implementacja zgodna z opisem gramatyki hk-parser z projektu bit/nula.
;; Wartości są trzymane jako tekst; listy jako elementy rozdzielone "\n".
;; Rozszerzenie LegendaryOS: pusta wartość po `=>` jest dozwolona (""), a sekcje
;; mogą się powtarzać (wpisy dopisują się do tej samej sekcji).

pub struct Entry is
    pub section: string
    pub key:     string
    pub value:   string
    pub is_list: bool
end

pub struct Doc is
    pub entries: [Entry]
end

pub struct ParseResult is
    pub ok:    bool
    pub error: string
    pub doc:   Doc
end

pub fn empty() -> Doc is
    let e: [Entry] = []
    return Doc { entries: e }
end

fn unquote(s: string) -> string is
    let t: string = text::trim(s)
    let n: int = t.len()
    if n >= 2 is
        let a: string = t[0..1]
        let b: string = t[n - 1..n]
        if (a == __builtin_char_code_to_str(34) && b == a) || (a == "'" && b == "'") is return t[1..n - 1] end
    end
    return t
end

;; Dzieli listę po przecinkach poza cudzysłowami.
fn split_list(inner: string) -> [string] is
    let mut out: [string] = []
    let n: int = inner.len()
    let mut cur: string = ""
    let mut quote: string = ""
    let mut i: int = 0
    while i < n is
        let c: string = inner[i..i + 1]
        if quote != "" is
            if c == quote is quote = "" end
            cur = cur + c
        else is
            if c == __builtin_char_code_to_str(34) || c == "'" is
                quote = c
                cur = cur + c
            else is
                if c == "," is
                    out.push(unquote(cur))
                    cur = ""
                else is
                    cur = cur + c
                end
            end
        end
        i += 1
    end
    let last: string = unquote(cur)
    if last != "" || out.len() > 0 is out.push(last) end
    return out
end

pub fn parse(src: string) -> ParseResult is
    let lines: [string] = text::lines(src)
    let mut doc: Doc = empty()
    let mut section: string = ""
    let mut group: string = ""
    let mut i: int = 0
    while i < lines.len() is
        let ln: int = i + 1
        let line: string = text::trim(lines[i])
        i += 1
        if line == "" || text::starts_with(line, "!") is
            ;; pomiń
        else is
            let n: int = line.len()
            if text::starts_with(line, "[") && text::ends_with(line, "]") && !text::starts_with(line, "->") is
                section = text::trim(line[1..n - 1])
                group = ""
            else is
                let nested: bool = text::starts_with(line, "-->")
                let top: bool = text::starts_with(line, "->") && !nested
                if !nested && !top is
                    return ParseResult { ok: false, doc: doc, error: "linia " + text::istr(ln) + ": oczekiwano '-> klucz => wartość', '--> ...' lub [sekcja]" }
                end
                let mut body: string = ""
                if nested is body = text::trim(line[3..n]) else is body = text::trim(line[2..n]) end
                let arrow: int = text::find(body, "=>")
                let mut key: string = body
                let mut val: string = ""
                let mut has_val: bool = false
                if arrow >= 0 is
                    key = text::trim(body[0..arrow])
                    val = text::trim(body[arrow + 2..body.len()])
                    has_val = true
                end
                if key == "" is
                    return ParseResult { ok: false, doc: doc, error: "linia " + text::istr(ln) + ": pusty klucz" }
                end
                if nested is
                    if group == "" is
                        return ParseResult { ok: false, doc: doc, error: "linia " + text::istr(ln) + ": '-->' bez nadrzędnego '-> grupa'" }
                    end
                    key = group + "." + key
                else is
                    if has_val is group = "" else is group = key end
                end
                if has_val is
                    let mut is_list: bool = false
                    let mut stored: string = val
                    if val.len() >= 2 && val[0..1] == "[" && text::ends_with(val, "]") is
                        is_list = true
                        stored = text::join(split_list(val[1..val.len() - 1]), "\n")
                    else is
                        stored = unquote(val)
                    end
                    let mut es: [Entry] = doc.entries
                    es.push(Entry { section: section, key: key, value: stored, is_list: is_list })
                    doc = Doc { entries: es }
                end
            end
        end
    end
    return ParseResult { ok: true, error: "", doc: doc }
end

pub fn load(path: string) -> ParseResult is
    if !fs::exists(path) is return ParseResult { ok: false, doc: empty(), error: "brak pliku " + path } end
    return parse(fs::read(path))
end

pub fn has(d: Doc, section: string, key: string) -> bool is
    let mut i: int = 0
    while i < d.entries.len() is
        if d.entries[i].section == section && d.entries[i].key == key is return true end
        i += 1
    end
    return false
end

;; Ostatnia wartość klucza wygrywa (jak w nula/bit).
pub fn get(d: Doc, section: string, key: string, dflt: string) -> string is
    let mut out: string = dflt
    let mut i: int = 0
    while i < d.entries.len() is
        let e: Entry = d.entries[i]
        if e.section == section && e.key == key is out = e.value end
        i += 1
    end
    return out
end

pub fn get_int(d: Doc, section: string, key: string, dflt: int) -> int is
    return text::parse_int(get(d, section, key, ""), dflt)
end

pub fn get_bool(d: Doc, section: string, key: string, dflt: bool) -> bool is
    let v: string = text::trim(get(d, section, key, ""))
    if v == "true" || v == "yes" || v == "on" || v == "1" is return true end
    if v == "false" || v == "no" || v == "off" || v == "0" is return false end
    return dflt
end

;; Lista: element tablicowy albo pojedyncza wartość jako jednoelementowa lista.
pub fn get_list(d: Doc, section: string, key: string) -> [string] is
    let v: string = get(d, section, key, "")
    let mut out: [string] = []
    if v == "" is return out end
    return text::split(v, "\n")
end

;; Klucze sekcji (unikalne, w kolejności pierwszego użycia).
pub fn keys(d: Doc, section: string) -> [string] is
    let mut out: [string] = []
    let mut i: int = 0
    while i < d.entries.len() is
        let e: Entry = d.entries[i]
        i += 1
        if e.section == section is
            let mut seen: bool = false
            let mut j: int = 0
            while j < out.len() is
                if out[j] == e.key is seen = true end
                j += 1
            end
            if !seen is out.push(e.key) end
        end
    end
    return out
end

;; Unikalne nazwy sekcji w kolejności występowania.
pub fn sections(d: Doc) -> [string] is
    let mut out: [string] = []
    let mut i: int = 0
    while i < d.entries.len() is
        let s: string = d.entries[i].section
        i += 1
        let mut seen: bool = false
        let mut j: int = 0
        while j < out.len() is
            if out[j] == s is seen = true end
            j += 1
        end
        if !seen is out.push(s) end
    end
    return out
end

;; Podklucze grupy: dla "check" zwraca ["run", "description"] (z wpisów "check.run").
pub fn group_keys(d: Doc, section: string, group: string) -> [string] is
    let mut out: [string] = []
    let pre: string = group + "."
    let ks: [string] = keys(d, section)
    let mut i: int = 0
    while i < ks.len() is
        if text::starts_with(ks[i], pre) is out.push(ks[i][pre.len()..ks[i].len()]) end
        i += 1
    end
    return out
end
