;; Manifest = drzewo Merkle całego rootfs (format v1):
;;   entries[] posortowane po `path` (porównanie bajtowe),
;;   entryHash(e) = hashChildren([hash(path|mode), chunks...]),
;;   root = hashChildren(entryHash(e) dla e w entries).

pub fn format_version() -> int is return 1 end

;; mode: "regular" | "executable" | "symlink" | "directory"
pub struct FileEntry is
    pub path:        string
    pub mode:        string
    pub size:        int
    pub chunks:      [string]
    pub link_target: string
end

pub struct Manifest is
    pub format_version: int
    pub hash_algo:      string
    pub min_size:       int
    pub avg_size:       int
    pub max_size:       int
    pub root:           string
    pub entries:        [FileEntry]
end

pub struct BuildResult is
    pub ok:       bool
    pub error:    string
    pub manifest: Manifest
end

pub fn empty_manifest() -> Manifest is
    return Manifest { format_version: 1, hash_algo: "", min_size: 0, avg_size: 0, max_size: 0, root: "", entries: [] }
end

pub fn valid_mode(m: string) -> bool is
    return m == "regular" || m == "executable" || m == "symlink" || m == "directory"
end

;; Hash pojedynczego wpisu: wykrywa zmianę metadanych bez zmiany zawartości.
pub fn entry_hash(e: FileEntry) -> string is
    let p: string = e.path
    let m: string = e.mode
    let mut parts: [string] = [hashing::hash_bytes(hashing::string_bytes(p + "|" + m))]
    for c in e.chunks is
        parts.push(c)
    end
    return hashing::hash_children(parts)
end

pub fn compute_root(entries: [FileEntry]) -> string is
    let mut hs: [string] = []
    for e in entries is
        hs.push(entry_hash(e))
    end
    return hashing::hash_children(hs)
end

;; Sortowanie przez scalanie po `path` (bajtowo).
pub fn sort_entries(xs: [FileEntry]) -> [FileEntry] is
    let n: int = xs.len()
    if n <= 1 is return xs end
    let mid: int = n / 2
    let left: [FileEntry] = sort_entries(xs[0..mid])
    let right: [FileEntry] = sort_entries(xs[mid..n])
    let ln: int = left.len()
    let rn: int = right.len()
    let mut out: [FileEntry] = []
    let mut i: int = 0
    let mut j: int = 0
    while i < ln && j < rn is
        let a: string = left[i].path
        let b: string = right[j].path
        if b < a is
            out.push(right[j])
            j += 1
        else is
            out.push(left[i])
            i += 1
        end
    end
    while i < ln is
        out.push(left[i])
        i += 1
    end
    while j < rn is
        out.push(right[j])
        j += 1
    end
    return out
end

fn fail_build(msg: string) -> BuildResult is
    return BuildResult { ok: false, error: msg, manifest: empty_manifest() }
end

;; Przechodzi po `source_dir`, dzieli pliki na chunki (FastCDC), zapisuje je
;; do `s` (automatyczny dedup) i buduje manifest.
pub fn build(source_dir: string, s: store::Store, cfg: chunker::ChunkerConfig) -> BuildResult is
    let tr: sys::TreeResult = sys::list_tree(source_dir)
    if !tr.ok is return fail_build(tr.error) end
    let mut entries: [FileEntry] = []
    let n: int = tr.entries.len()
    let mut i: int = 0
    while i < n is
        let t: sys::TreeEntry = tr.entries[i]
        let kind: string = t.kind
        let rel: string = t.path
        if kind == "d" is
            entries.push(FileEntry { path: rel, mode: "directory", size: 0, chunks: [], link_target: "" })
        else if kind == "l" is
            entries.push(FileEntry { path: rel, mode: "symlink", size: 0, chunks: [], link_target: t.target })
        else is
            let full: string = text::path_join(source_dir, rel)
            let b: bytes = fs::read_bytes(full)
            let data: [int] = store::bytes_to_ints(b)
            let ranges: [chunker::Range] = chunker::chunk_ranges(data, cfg)
            let mut hashes: [string] = []
            for r in ranges is
                let off: int = r.offset
                let stop: int = r.offset + r.size
                let part: [int] = data[off..stop]
                let pr: store::PutResult = store::put(s, part)
                if !pr.ok is return fail_build("zapis chunku dla '" + rel + "': " + pr.error) end
                hashes.push(pr.hash)
            end
            let md: int = t.mode
            let ub: int = (md / 64) % 2
            let mut mode: string = "regular"
            if ub == 1 is mode = "executable" end
            entries.push(FileEntry { path: rel, mode: mode, size: t.size, chunks: hashes, link_target: "" })
        end
        i += 1
    end
    let sorted: [FileEntry] = sort_entries(entries)
    let m: Manifest = Manifest {
        format_version: format_version(), hash_algo: hashing::algo_name(),
        min_size: cfg.min_size, avg_size: cfg.avg_size, max_size: cfg.max_size,
        root: compute_root(sorted), entries: sorted }
    return BuildResult { ok: true, error: "", manifest: m }
end

pub fn build_default(source_dir: string, s: store::Store) -> BuildResult is
    return build(source_dir, s, chunker::default_config())
end

;; ── JSON ─────────────────────────────────────────────────────────────────────

pub fn to_json_value(m: Manifest) -> json::J is
    let o: json::J = json::jobj()
    json::set(o, "formatVersion", json::jint(m.format_version))
    json::set(o, "hashAlgo", json::jstr(m.hash_algo))
    let c: json::J = json::jobj()
    json::set(c, "minSize", json::jint(m.min_size))
    json::set(c, "avgSize", json::jint(m.avg_size))
    json::set(c, "maxSize", json::jint(m.max_size))
    json::set(o, "chunker", c)
    json::set(o, "root", json::jstr(m.root))
    let mut arr: [json::J] = []
    for e in m.entries is
        let je: json::J = json::jobj()
        json::set(je, "path", json::jstr(e.path))
        json::set(je, "mode", json::jstr(e.mode))
        json::set(je, "size", json::jint(e.size))
        let mut cs: [json::J] = []
        for h in e.chunks is
            cs.push(json::jstr(h))
        end
        json::set(je, "chunks", json::jarr(cs))
        json::set(je, "linkTarget", json::jstr(e.link_target))
        arr.push(je)
    end
    json::set(o, "entries", json::jarr(arr))
    return o
end

;; Postać "pretty" (2 spacje) — to trafia do manifests/<tag>.json.
pub fn to_json(m: Manifest) -> string is
    return json::to_pretty(to_json_value(m))
end

pub struct ParseResult is
    pub ok:       bool
    pub error:    string
    pub warning:  string
    pub manifest: Manifest
end

fn pfail(msg: string) -> ParseResult is
    return ParseResult { ok: false, error: msg, warning: "", manifest: empty_manifest() }
end

;; Reguła zgodności: formatVersion nowszy niż obsługiwany -> błąd; brak pola
;; (0) -> błąd. Niezgodny `hashAlgo` -> tylko ostrzeżenie w `warning`.
pub fn from_json(txt: string) -> ParseResult is
    let p: json::Parsed = json::parse(txt)
    if !p.ok is return pfail("niepoprawny JSON manifestu: " + p.error) end
    let j: json::J = p.value
    if j.kind != 5 is return pfail("manifest nie jest obiektem JSON") end
    let fv: int = json::as_int(json::get(j, "formatVersion"), 0)
    let cur: int = format_version()
    if fv > cur is
        return pfail("Manifest ma formatVersion=" + text::istr(fv) + ", ta wersja FastTree obsługuje do " + text::istr(cur) + ". Zaktualizuj fasttree.")
    end
    if fv == 0 is
        return pfail("Manifest bez pola 'formatVersion' — nierozpoznany/przedwersyjny format.")
    end
    let algo: string = json::as_str(json::get(j, "hashAlgo"), "")
    let mut warning: string = ""
    let here: string = hashing::algo_name()
    if algo != "" && algo != here is
        warning = "manifest policzony algorytmem '" + algo + "', bieżąca kompilacja używa '" + here + "'."
    end
    let dc: chunker::ChunkerConfig = chunker::default_config()
    let mut mn: int = dc.min_size
    let mut av: int = dc.avg_size
    let mut mx: int = dc.max_size
    if json::has(j, "chunker") is
        let jc: json::J = json::get(j, "chunker")
        mn = json::as_int(json::get(jc, "minSize"), mn)
        av = json::as_int(json::get(jc, "avgSize"), av)
        mx = json::as_int(json::get(jc, "maxSize"), mx)
    end
    let root: string = json::as_str(json::get(j, "root"), "")
    if !hashing::is_valid_hash(root) is return pfail("niepoprawny 'root' w manifeście") end
    let je: json::J = json::get(j, "entries")
    if je.kind != 4 is return pfail("brak tablicy 'entries' w manifeście") end
    let mut entries: [FileEntry] = []
    let n: int = je.items.len()
    let mut i: int = 0
    while i < n is
        let e: json::J = je.items[i]
        let path: string = json::as_str(json::get(e, "path"), "")
        let mode: string = json::as_str(json::get(e, "mode"), "")
        if !valid_mode(mode) is return pfail("nieznany tryb pliku: " + mode) end
        let mut chunks: [string] = []
        let jc2: json::J = json::get(e, "chunks")
        let cn: int = jc2.items.len()
        let mut k: int = 0
        while k < cn is
            let hx: string = json::as_str(jc2.items[k], "")
            if !hashing::is_valid_hash(hx) is return pfail("niepoprawny hash chunku w '" + path + "'") end
            chunks.push(hx)
            k += 1
        end
        entries.push(FileEntry { path: path, mode: mode, size: json::as_int(json::get(e, "size"), 0),
            chunks: chunks, link_target: json::as_str(json::get(e, "linkTarget"), "") })
        i += 1
    end
    let ha: string = if algo != "" then algo else here
    let m: Manifest = Manifest { format_version: fv, hash_algo: ha, min_size: mn, avg_size: av,
        max_size: mx, root: root, entries: entries }
    return ParseResult { ok: true, error: "", warning: warning, manifest: m }
end

;; Ścieżka manifestu taga pod korzeniem FastTree: <root>/manifests/<tag>.json.
pub fn manifest_path_in(root: string, tag: string) -> string is
    return text::path_join(text::path_join(root, "manifests"), tag + ".json")
end

pub fn load(path: string) -> ParseResult is
    if !fs::exists(path) is return pfail("brak manifestu '" + path + "'") end
    return from_json(fs::read(path))
end

;; ── Diff ─────────────────────────────────────────────────────────────────────

;; kind: "added" | "removed" | "modified"
pub struct DiffEntry is
    pub kind:          string
    pub path:          string
    pub old_chunks:    int
    pub new_chunks:    int
    pub reused_chunks: int
end

;; Porównanie na poziomie plików i chunków: O(liczba wpisów), nie O(rozmiar).
pub fn diff(old: Manifest, nw: Manifest) -> [DiffEntry] is
    let mut out: [DiffEntry] = []
    let mut old_idx = col::hashmap_new()
    let on: int = old.entries.len()
    let mut i: int = 0
    while i < on is
        old_idx = col::hashmap_insert(old_idx, old.entries[i].path, text::istr(i))
        i += 1
    end
    let mut seen = col::hashmap_new()
    let nn: int = nw.entries.len()
    let mut k: int = 0
    while k < nn is
        let ne: FileEntry = nw.entries[k]
        let np: string = ne.path
        seen = col::hashmap_insert(seen, np, "1")
        if !col::hashmap_contains(old_idx, np) is
            let nc: int = ne.chunks.len()
            out.push(DiffEntry { kind: "added", path: np, old_chunks: 0, new_chunks: nc, reused_chunks: 0 })
        else is
            let oi: int = text::parse_int(col::hashmap_get(old_idx, np), 0)
            let oe: FileEntry = old.entries[oi]
            if entry_hash(oe) != entry_hash(ne) is
                let mut oset = col::hashmap_new()
                for c in oe.chunks is
                    oset = col::hashmap_insert(oset, c, "1")
                end
                let mut reused: int = 0
                for c in ne.chunks is
                    if col::hashmap_contains(oset, c) is reused += 1 end
                end
                let oc: int = oe.chunks.len()
                let nc2: int = ne.chunks.len()
                out.push(DiffEntry { kind: "modified", path: np, old_chunks: oc, new_chunks: nc2, reused_chunks: reused })
            end
        end
        k += 1
    end
    for oe in old.entries is
        let op: string = oe.path
        if !col::hashmap_contains(seen, op) is
            let oc2: int = oe.chunks.len()
            out.push(DiffEntry { kind: "removed", path: op, old_chunks: oc2, new_chunks: 0, reused_chunks: 0 })
        end
    end
    return out
end
