pub fn istr(n: int) -> string is
    return to_string(n)
end

pub fn bstr(b: bool) -> string is
    if b is return "true" end
    return "false"
end

;; Indeks pierwszego wystąpienia `sub` w `s` lub -1. (std `index_of` w
;; backendzie LLVM zwraca śmieci, więc mamy własną implementację.)
pub fn find(s: string, sub: string) -> int is
    let n: int = s.len()
    let m: int = sub.len()
    if m == 0 is return 0 end
    let mut i: int = 0
    while i + m <= n is
        if s[i..i + m] == sub is return i end
        i += 1
    end
    return -1
end

;; Indeks ostatniego wystąpienia `sub` w `s` lub -1.
pub fn rfind(s: string, sub: string) -> int is
    let n: int = s.len()
    let m: int = sub.len()
    if m == 0 is return n end
    let mut i: int = n - m
    while i >= 0 is
        if s[i..i + m] == sub is return i end
        i -= 1
    end
    return -1
end

pub fn starts_with(s: string, p: string) -> bool is
    let n: int = s.len()
    let m: int = p.len()
    if m > n is return false end
    return s[0..m] == p
end

pub fn ends_with(s: string, p: string) -> bool is
    let n: int = s.len()
    let m: int = p.len()
    if m > n is return false end
    return s[n - m..n] == p
end

pub fn contains(s: string, sub: string) -> bool is
    return find(s, sub) >= 0
end

;; Podział po pierwszym wystąpieniu `sep`; zwraca [s] gdy brak separatora.
pub fn split_once(s: string, sep: string) -> [string] is
    let i: int = find(s, sep)
    if i < 0 is return [s] end
    let m: int = sep.len()
    let n: int = s.len()
    return [s[0..i], s[i + m..n]]
end

;; Dzieli po `sep`, zachowując puste elementy.
pub fn split(s: string, sep: string) -> [string] is
    let mut out: [string] = []
    let m: int = sep.len()
    let n: int = s.len()
    let mut start: int = 0
    let mut i: int = 0
    while i + m <= n is
        if s[i..i + m] == sep is
            out.push(s[start..i])
            i += m
            start = i
        else is
            i += 1
        end
    end
    out.push(s[start..n])
    return out
end

;; Podział na linie (bez końcowego pustego elementu po ostatnim '\n').
pub fn lines(s: string) -> [string] is
    let parts: [string] = split(s, "\n")
    let mut out: [string] = []
    let n: int = parts.len()
    let mut i: int = 0
    while i < n is
        let last: bool = i == n - 1
        if !(last && parts[i] == "") is
            out.push(parts[i])
        end
        i += 1
    end
    return out
end

pub fn join(parts: [string], sep: string) -> string is
    let mut s: string = ""
    let n: int = parts.len()
    let mut i: int = 0
    while i < n is
        if i > 0 is s = s + sep end
        s = s + parts[i]
        i += 1
    end
    return s
end

pub fn trim(s: string) -> string is
    let n: int = s.len()
    let mut a: int = 0
    let mut b: int = n
    while a < b && is_space(s[a..a + 1]) is a += 1 end
    while b > a && is_space(s[b - 1..b]) is b -= 1 end
    return s[a..b]
end

fn is_space(c: string) -> bool is
    return c == " " || c == "\n" || c == "\t" || c == "\r"
end

;; Parsuje nieujemną liczbę dziesiętną; zwraca `dflt`, gdy `s` nią nie jest.
pub fn parse_int(s: string, dflt: int) -> int is
    let t: string = trim(s)
    let n: int = t.len()
    if n == 0 is return dflt end
    let mut neg: bool = false
    let mut i: int = 0
    if t[0..1] == "-" is
        neg = true
        i = 1
    end
    if i >= n is return dflt end
    let mut v: int = 0
    while i < n is
        let c: int = __builtin_str_to_char_code(t[i..i + 1])
        if c < 48 || c > 57 is return dflt end
        v = v * 10 + (c - 48)
        i += 1
    end
    if neg is return 0 - v end
    return v
end

;; Parsuje liczbę ósemkową (np. wynik `find -printf %m`).
pub fn parse_octal(s: string) -> int is
    let t: string = trim(s)
    let n: int = t.len()
    let mut v: int = 0
    let mut i: int = 0
    while i < n is
        let c: int = __builtin_str_to_char_code(t[i..i + 1])
        if c < 48 || c > 55 is return 0 end
        v = v * 8 + (c - 48)
        i += 1
    end
    return v
end

;; Łączenie ścieżek bez podwójnych ukośników.
pub fn path_join(a: string, b: string) -> string is
    if a == "" is return b end
    if b == "" is return a end
    let an: int = a.len()
    if a[an - 1..an] == "/" is return a + b end
    return a + "/" + b
end

pub fn dirname(p: string) -> string is
    let i: int = rfind(p, "/")
    if i < 0 is return "." end
    if i == 0 is return "/" end
    return p[0..i]
end

pub fn basename(p: string) -> string is
    let i: int = rfind(p, "/")
    let n: int = p.len()
    if i < 0 is return p end
    return p[i + 1..n]
end

;; Nawiasy klamrowe jako napisy — literały `"{...}"` są w H# interpolowane.
pub fn lbrace() -> string is return __builtin_char_code_to_str(123) end
pub fn rbrace() -> string is return __builtin_char_code_to_str(125) end
