fn usage() -> string is
    return "legendaryos-builder " + build::version() + " — builder obrazów ISO i OCI dla LegendaryOS (wiele edycji)\n\n  new <katalog>               nowy projekt dystrybucji (szablon + branding zastępczy)\n  validate [katalog]          sprawdź config.hk, user.hk, branding, katalog narzędzi i WSZYSTKIE edycje\n  editions [katalog]          lista edycji (środowisko, menedżer logowania, instalator, narzędzia)\n  tools [katalog]             narzędzia z tools.hk dla edycji (--edition ID|all)\n  fetch-tools [katalog]       pobierz narzędzia do cache i pokaż wersje (bez roota, bez budowy)\n  check-packages [katalog]    sprawdź rozwiązywalność list pakietów edycji (lepm --dry-run)\n  doctor                      sprawdź narzędzia potrzebne do budowy\n  plan [katalog]              kroki i polecenia (dry-run)\n  build [katalog]             zbuduj ISO i/albo OCI (root)\n  clean [katalog]             usuń build/<edycja> (--cache usuwa też cache)\n  steps                       lista kroków\n\nOpcje:\n  --edition ID|ID,ID|all   edycje (plasma xfce gnome cosmic blue server); domyślnie editions.default z config.hk\n  --target iso|oci|both    formaty         --only KROK   jeden krok       --dry-run  tylko pokaż polecenia\n  --strict                 ostrzeżenia są błędami\n  --allow-missing          buduj mimo brakujących wydań narzędzi (np. repozytorium bez release)\n  --offline                tylko cache i LEGENDARY_TOOLS_LOCAL, bez sieci\n  --keep-going             przy --edition all: nie przerywaj po błędzie jednej edycji\n\nŚrodowisko: LEGENDARY_TOOLS_LOCAL=katalog z gotowymi binarkami, LPM_BIN, ZENITD_BIN, LEGENDARY_MANIFEST_HK=plik manifest.hk\nSkrypty/CI: NO_COLOR=1; token w user.hk jako env:NAZWA (nigdy nie jest drukowany)"
end

fn doctor() -> int is
    ui::head("doctor")
    let need: [string] = ["git", "curl", "lepm", "gawk", "bsdtar", "zstd", "chroot", "mount", "mksquashfs", "sha256sum", "grub2-mkrescue", "xorriso", "podman", "tar", "z#", "hl", "hlpp"]
    let mut bad: int = 0
    let mut i: int = 0
    while i < need.len() is
        if ft::sys::have_tool(need[i]) is ui::ok(need[i]) else is
            ui::warn("brak: " + need[i])
            bad += 1
        end
        i += 1
    end
    if bad > 0 is ui::info("wymagane zawsze: curl, mksquashfs, sha256sum, lepm (pakiety), chroot/mount (root). `z#`/`hl` opcjonalne (ZENITD_BIN, hooki .hl); `hlpp` pobiera się jako narzędzie (Z#); `podman` tylko dla OCI; grub2/xorriso tylko dla ISO") end
    return 0
end

fn tabc() -> string is return __builtin_char_code_to_str(9) end

fn fld(f: [string], n: int) -> string is
    if n < f.len() is return f[n] end
    return ""
end

fn load_eds(p: proj::Project, want: string) -> [proj::Edition] is
    let ids: [string] = proj::select_editions(p, want)
    let mut out: [proj::Edition] = []
    let mut i: int = 0
    while i < ids.len() is
        let r: proj::LoadEdition = proj::load_edition(p, ids[i])
        if r.ok is out.push(r.edition) else is ui::err("brak definicji edycji '" + ids[i] + "'") end
        i += 1
    end
    if out.len() == 0 is ui::err("nie wybrano żadnej edycji (--edition " + want + "; dostępne: " + ft::text::join(p.editions, ", ") + ")") end
    return out
end

fn cmd_editions(p: proj::Project, eds: [proj::Edition]) -> int is
    ui::head("edycje " + p.name + " " + p.version)
    let mut i: int = 0
    while i < eds.len() is
        let e: proj::Edition = eds[i]
        let n: int = proj::edition_tools(p, e).len()
        ui::info(e.id + " — " + e.name + " (" + e.summary + ")")
        ui::kv("środowisko", e.desktop + " · logowanie: " + e.dm + " · cel: " + e.target)
        ui::kv("instalator", e.installer + " · narzędzi w /tools: " + ft::text::istr(n) + " · ISO: " + e.iso_label)
        ui::kv("pakiety", ft::text::istr(proj::packages(p, e).len()) + " nazw w " + ft::text::istr(proj::package_files(p, e).len()) + " listach")
        i += 1
    end
    return 0
end

fn cmd_tools(p: proj::Project, eds: [proj::Edition]) -> int is
    let mut i: int = 0
    while i < eds.len() is
        let e: proj::Edition = eds[i]
        ui::head("narzędzia: " + e.id)
        let rows: [string] = proj::edition_tools(p, e)
        let mut k: int = 0
        while k < rows.len() is
            let f: [string] = ft::text::split(rows[k], tabc())
            let mut flags: string = f[2]
            if f[4] == "true" is flags = flags + ", +/system/bin" end
            if f[3] == "false" is flags = flags + ", opcjonalne" end
            ui::kv(f[1], f[5] + "  ←  " + f[6] + "  (" + flags + ")")
            k += 1
        end
        i += 1
    end
    return 0
end

fn cmd_fetch(p: proj::Project, eds: [proj::Edition], allow_missing: bool, offline: bool) -> int is
    let cat: string = ft::text::path_join(p.dir, p.tools_catalog)
    let cache: string = ft::text::path_join(ft::text::path_join(p.dir, "build"), "cache")
    let mut failed: int = 0
    let mut i: int = 0
    while i < eds.len() is
        let e: proj::Edition = eds[i]
        ui::head("fetch-tools: " + e.id)
        let want: [string] = proj::edition_tools(p, e)
        let rows: [string] = ft::api::tb_fetch(cat, e.id, e.exclude, cache, ft::sys::getenv_or("LEGENDARY_TOOLS_LOCAL", ""), offline)
        let mut k: int = 0
        while k < rows.len() is
            let f: [string] = ft::text::split(rows[k], tabc())
            k += 1
            if f[0] == "#manifest" is
                if f.len() > 2 && f[2] != "" is ui::warn("manifest.hk: " + f[2]) else is ui::info("manifest.hk: " + f[1]) end
            else is
                if f[0] == "OK" is ui::ok(f[1] + " " + f[3] + "  sha256 " + f[5][0..12]) end
                if f[0] == "WARN" is ui::warn(f[1] + " " + f[3] + ": " + fld(f, 10)) end
                if f[0] == "ERR" is
                    let mut req: bool = true
                    let mut w: int = 0
                    while w < want.len() is
                        let wf: [string] = ft::text::split(want[w], tabc())
                        if wf[0] == f[1] is req = wf[3] == "true" end
                        w += 1
                    end
                    if req && !allow_missing is
                        failed += 1
                        ui::err(f[1] + ": " + fld(f, 10))
                    else is
                        ui::warn(f[1] + " pominięte: " + fld(f, 10))
                    end
                end
            end
        end
        i += 1
    end
    if failed > 0 is return 1 end
    return 0
end

fn cmd_check_packages(p: proj::Project, eds: [proj::Edition]) -> int is
    let mut bad: int = 0
    let mut i: int = 0
    while i < eds.len() is
        let e: proj::Edition = eds[i]
        ui::head("check-packages: " + e.id)
        let c: build::Ctx = build::new_ctx(p, e, false, false, false, false)
        let pk: [string] = proj::packages(p, e)
        let mut k: int = 0
        while k < pk.len() is
            if !proj::safe_pkg(pk[k]) is
                ui::err("niepoprawna nazwa pakietu: '" + pk[k] + "'")
                bad += 1
            end
            k += 1
        end
        if !ft::sys::have_tool(p.lepm) is
            ui::warn("brak " + p.lepm + " — sprawdzono tylko składnię nazw (" + ft::text::istr(pk.len()) + ")")
        else is
            let mut cmd: string = p.lepm + " bootstrap --dry-run --root " + ft::sys::sq(ft::text::path_join(c.base, "check-root")) + " --release " + ft::sys::sq(p.base_release) + " --arch " + ft::sys::sq(p.arch) + " --cache " + ft::sys::sq(ft::text::path_join(c.cache, "rpm")) + " --repos " + ft::sys::sq(ft::text::path_join(p.dir, p.repos)) + " --policy " + ft::sys::sq(ft::text::path_join(p.dir, p.compat))
            let lists: [string] = proj::package_files(p, e)
            let mut j: int = 0
            while j < lists.len() is
                cmd = cmd + " --list " + ft::sys::sq(lists[j])
                j += 1
            end
            let r: sys::Exec = ft::sys::exec(cmd)
            if r.code != 0 is
                bad += 1
                ui::err("lepm nie rozwiązał pakietów edycji " + e.id + ":\n" + ft::text::trim(r.out))
            else is
                ui::ok(e.id + ": wszystkie pakiety rozwiązywalne")
            end
        end
        i += 1
    end
    if bad > 0 is return 1 end
    return 0
end

fn main() -> int is
    let argv: [string] = env::args()
    let mut args: [string] = []
    let mut dry: bool = false
    let mut strict: bool = false
    let mut allow_missing: bool = false
    let mut offline: bool = false
    let mut keep_going: bool = false
    let mut clean_cache: bool = false
    let mut target: string = ""
    let mut only: string = ""
    let mut edition: string = ""
    let mut i: int = 1
    while i < argv.len() is
        let a: string = argv[i]
        i += 1
        if a == "--dry-run" is dry = true
        else is if a == "--strict" is strict = true
        else is if a == "--allow-missing" is allow_missing = true
        else is if a == "--offline" is offline = true
        else is if a == "--keep-going" is keep_going = true
        else is if a == "--cache" is clean_cache = true
        else is if a == "--target" && i < argv.len() is
            target = argv[i]
            i += 1
        else is if a == "--only" && i < argv.len() is
            only = argv[i]
            i += 1
        else is if a == "--edition" && i < argv.len() is
            edition = argv[i]
            i += 1
        else is args.push(a) end end end end end end end end end
    end
    if args.len() == 0 || args[0] == "help" || args[0] == "--help" is
        write(usage())
        return 0
    end
    let cmd: string = args[0]
    let mut dir: string = "."
    if args.len() > 1 is dir = args[1] end
    if cmd == "version" is
        write("legendaryos-builder " + build::version())
        return 0
    end
    if cmd == "steps" is
        let names: [string] = build::step_names(["iso", "oci"])
        write(ft::text::join(names, "\n"))
        return 0
    end
    if cmd == "doctor" is return doctor() end
    if cmd == "new" is
        if args.len() < 2 is
            ui::err("legendaryos-builder new <katalog>")
            return 1
        end
        let e: string = scaffold::create(args[1])
        if e != "" is
            ui::err(e)
            return 1
        end
        ui::ok("projekt utworzony w " + args[1] + " — podmień pliki w branding/, uzupełnij user.hk")
        return 0
    end
    let known: [string] = ["validate", "editions", "tools", "fetch-tools", "check-packages", "plan", "build", "clean"]
    if !proj::has(known, cmd) is
        ui::err("nieznana komenda: " + cmd)
        return 1
    end
    let lr: proj::LoadResult = proj::load(dir)
    if !lr.ok is return 1 end
    let mut p: proj::Project = lr.project
    if target == "iso" is p = proj::with_formats(p, ["iso"]) end
    if target == "oci" is p = proj::with_formats(p, ["oci"]) end
    if target == "both" is p = proj::with_formats(p, ["iso", "oci"]) end
    if target != "" && target != "iso" && target != "oci" && target != "both" is
        ui::err("--target: iso | oci | both")
        return 1
    end
    let probs: [string] = proj::validate(p)
    let mut k: int = 0
    while k < probs.len() is
        ui::err(probs[k])
        k += 1
    end
    if probs.len() > 0 is return 1 end
    if cmd == "validate" is
        ui::ok(p.name + " " + p.version + " (" + p.arch + ", Fedora " + p.base_release + ") — projekt poprawny, edycje: " + ft::text::join(p.editions, ", "))
        return 0
    end
    let want: string = edition
    let mut sel: string = want
    if cmd == "editions" || cmd == "tools" || cmd == "fetch-tools" || cmd == "check-packages" || cmd == "clean" is
        if sel == "" is sel = "all" end
    end
    let eds: [proj::Edition] = load_eds(p, sel)
    if eds.len() == 0 is return 1 end
    if cmd == "editions" is return cmd_editions(p, eds) end
    if cmd == "tools" is return cmd_tools(p, eds) end
    if cmd == "fetch-tools" is return cmd_fetch(p, eds, allow_missing, offline) end
    if cmd == "check-packages" is return cmd_check_packages(p, eds) end
    if cmd == "clean" is
        let b: string = ft::text::path_join(p.dir, "build")
        let mut c: int = 0
        while c < eds.len() is
            ft::sys::rm_rf(ft::text::path_join(b, eds[c].id))
            ui::ok("usunięto build/" + eds[c].id)
            c += 1
        end
        if clean_cache is
            ft::sys::rm_rf(ft::text::path_join(b, "cache"))
            ui::ok("usunięto build/cache")
        end
        return 0
    end
    ;; plan / build — po kolei dla każdej wybranej edycji
    let mut failed: [string] = []
    let mut done: [string] = []
    let mut e: int = 0
    while e < eds.len() is
        let ctx: build::Ctx = build::new_ctx(p, eds[e], dry || cmd == "plan", strict, allow_missing, offline)
        ui::head(eds[e].name + " " + p.version)
        let rc: int = build::run(ctx, only)
        if rc != 0 is
            failed.push(eds[e].id)
            if !keep_going is
                e = eds.len()
            end
        else is
            done.push(eds[e].id)
        end
        e += 1
    end
    if eds.len() > 1 is
        ui::head("podsumowanie")
        if done.len() > 0 is ui::ok("zbudowane: " + ft::text::join(done, ", ")) end
        if failed.len() > 0 is ui::err("niepowodzenie: " + ft::text::join(failed, ", ")) end
    end
    if failed.len() > 0 is return 1 end
    return 0
end
