use "std -> fs" from "fs"
mod ui
mod proj

;; Pipeline budowy LegendaryOS — JEDNA EDYCJA na przebieg (Fedora RPM -> układ /system /state /packages /tools -> FastTree -> OCI/ISO).
;;
;; BEZ dnf: rootfs składa `lepm` (rpm-md -> satsolv -> pobranie -> rozpakowanie; cały silnik w bibliotece lrpm).
;; FastTree, układ, manifest, /tools — WYŁĄCZNIE jako biblioteka: ft::api::* (use "bit -> libfasttree" w main.h#).
;; Każdy krok zwraca "" (OK) albo komunikat błędu. W trybie --dry-run polecenia są tylko drukowane.
;;
;; Kroki: prepare → packages → zenitd → overlay → hooks → layout → identity → tools → zsharp → toolbox → fasttree → iso|oci → checksums
;;   tools   — pobranie binarek wg tools.hk (wersje z manifest.hk / Bit.hk), stage: bin/ share/ TOOLS.hk
;;   zsharp  — instalacja Z# skryptem install.hlpp uruchamianym przez hlpp (do tego samego stage)
;;   toolbox — stage -> JEDEN obraz squashfs /tools/tools.sqfs (+ kopie "system" w /system/bin)

pub struct Ctx is
    pub p:             proj::Project
    pub ed:            proj::Edition
    pub base:          string      ;; build/<edycja>
    pub work:          string
    pub rootfs:        string
    pub out:           string
    pub cache:         string      ;; build/cache — wspólny dla wszystkich edycji (RPM-y, narzędzia, manifest.hk)
    pub dry:           bool
    pub strict:        bool
    pub allow_missing: bool
    pub offline:       bool
    pub tag:           string
end

pub fn new_ctx(p: proj::Project, ed: proj::Edition, dry: bool, strict: bool, allow_missing: bool, offline: bool) -> Ctx is
    let b: string = ft::text::path_join(p.dir, "build")
    let base: string = ft::text::path_join(b, ed.id)
    return Ctx { p: p, ed: ed, base: base, work: ft::text::path_join(base, "work"), rootfs: ft::text::path_join(base, "rootfs"),
        out: ft::text::path_join(base, "out"), cache: ft::text::path_join(b, "cache"), dry: dry, strict: strict,
        allow_missing: allow_missing, offline: offline, tag: p.id + "-" + ed.id + "-" + p.version }
end

pub fn now_iso() -> string is
    let r: sys::Exec = ft::sys::exec("date -u +%Y-%m-%dT%H:%M:%SZ")
    return ft::text::trim(r.out)
end

;; Dziennik budowy: build/<edycja>/out/build.log (tylko poza dry-run).
fn logline(c: Ctx, msg: string) is
    if c.dry is return end
    ft::sys::mkdir_p(c.out)
    let r: sys::Exec = ft::sys::exec("printf '%s %s\\n' " + ft::sys::sq(now_iso()) + " " + ft::sys::sq(msg) + " >> " + ft::sys::sq(ft::text::path_join(c.out, "build.log")))
end

;; Uruchamia polecenie (lub je drukuje w dry-run). Zwraca "" albo błąd z końcówką wyjścia.
fn sh(c: Ctx, cmd: string) -> string is
    if c.dry is
        write("    $ " + cmd)
        return ""
    end
    logline(c, "$ " + cmd)
    let r: sys::Exec = ft::sys::exec(cmd)
    if r.code != 0 is
        let o: string = ft::text::trim(r.out)
        let n: int = o.len()
        let mut tail: string = o
        if n > 1500 is tail = "..." + o[n - 1500..n] end
        logline(c, "BŁĄD kod " + ft::text::istr(r.code) + ": " + tail)
        return "polecenie zakończone kodem " + ft::text::istr(r.code) + ": " + cmd + "\n" + tail
    end
    return ""
end

fn mkdirs(c: Ctx, path: string) is
    if !c.dry is ft::sys::mkdir_p(path) end
end

fn tabs() -> string is return __builtin_char_code_to_str(9) end
fn stage_dir(c: Ctx) -> string is return ft::text::path_join(c.work, "tools-stage") end
fn local_dir(c: Ctx) -> string is return ft::text::path_join(c.work, "tools-local") end

;; ── Kroki ────────────────────────────────────────────────────────────────────

pub fn step_prepare(c: Ctx) -> string is
    if !c.dry && !ft::sys::ok("test \"$(id -u)\" = 0") is
        return "budowa wymaga roota (chroot, mount, rozpakowanie z zachowaniem właścicieli). Uruchom przez sudo albo w kontenerze --privileged"
    end
    if !c.dry is
        ft::sys::rm_rf(c.rootfs)
        ft::sys::rm_rf(c.work)
        ft::sys::rm_rf(c.out)
    end
    mkdirs(c, c.rootfs)
    mkdirs(c, c.work)
    mkdirs(c, c.out)
    mkdirs(c, c.cache)
    logline(c, "budowa " + c.tag)
    return ""
end

;; Rootfs z RPM-ów: `lepm bootstrap` (satsolv + compat.hk; zob. ../lepm/README.md, ../lrpm/docs/POLICY.md).
;; Cache metadanych i RPM-ów (build/cache) jest wspólny dla edycji i przeżywa kolejne budowy.
pub fn step_packages(c: Ctx) -> string is
    let pk: [string] = proj::packages(c.p, c.ed)
    if pk.len() == 0 is return "listy pakietów edycji są puste" end
    let mut k: int = 0
    while k < pk.len() is
        if !proj::safe_pkg(pk[k]) is return "niepoprawna nazwa pakietu w listach: '" + pk[k] + "'" end
        k += 1
    end
    ui::info("edycja " + c.ed.id + ": pakietów " + ft::text::istr(pk.len()) + " (menedżer: " + c.p.lepm + ", bez dnf)")
    if !c.dry && !ft::sys::have_tool(c.p.lepm) is
        return "brak narzędzia '" + c.p.lepm + "' (lepm) — zbuduj ../lepm (bit build) i dodaj do PATH albo ustaw packages.manager w config.hk"
    end
    let mut cmd: string = c.p.lepm + " bootstrap --root " + ft::sys::sq(c.rootfs) + " --release " + ft::sys::sq(c.p.base_release)
    cmd = cmd + " --arch " + ft::sys::sq(c.p.arch) + " --cache " + ft::sys::sq(ft::text::path_join(c.cache, "rpm"))
    cmd = cmd + " --repos " + ft::sys::sq(ft::text::path_join(c.p.dir, c.p.repos))
    cmd = cmd + " --policy " + ft::sys::sq(ft::text::path_join(c.p.dir, c.p.compat))
    let lists: [string] = proj::package_files(c.p, c.ed)
    let mut i: int = 0
    while i < lists.len() is
        cmd = cmd + " --list " + ft::sys::sq(lists[i])
        i += 1
    end
    if c.dry is cmd = cmd + " --dry-run" end
    return sh(c, cmd)
end

;; Instalacja zenitd: pobranie skryptu install.sh (adres z config.hk) i uruchomienie z DESTDIR.
;; Binarka gotowa: ZENITD_BIN=... albo LEGENDARY_TOOLS_LOCAL/zenitd (wtedy --no-build, bez kompilatora z#).
pub fn step_zenitd(c: Ctx) -> string is
    let repo: string = ft::text::path_join(c.work, "zenitd")
    let mut e: string = sh(c, "git clone --depth 1 " + ft::sys::sq(c.p.zenitd_repo) + " " + ft::sys::sq(repo))
    if e != "" is return e end
    e = sh(c, "curl -fsSL --retry 3 " + ft::sys::sq(c.p.zenitd_script) + " -o " + ft::sys::sq(ft::text::path_join(repo, "scripts/install.sh")))
    if e != "" is return e end
    let mut flags: string = ""
    let mut prebuilt: string = ft::sys::getenv_or("ZENITD_BIN", "")
    let local: string = ft::sys::getenv_or("LEGENDARY_TOOLS_LOCAL", "")
    if prebuilt == "" && local != "" && fs::exists(ft::text::path_join(local, "zenitd")) is prebuilt = ft::text::path_join(local, "zenitd") end
    if prebuilt != "" is
        e = sh(c, "install -D -m 0755 " + ft::sys::sq(prebuilt) + " " + ft::sys::sq(ft::text::path_join(repo, "target/release/zenitd")))
        if e != "" is return e end
        flags = " --no-build"
    else is
        if !c.dry && !ft::sys::have_tool("z#") is
            return "brak kompilatora z# na hoście; podaj gotową binarkę: ZENITD_BIN=/ścieżka/zenitd (zob. docs/BUILDING.md)"
        end
    end
    e = sh(c, "DESTDIR=" + ft::sys::sq(c.rootfs) + " PREFIX=/usr bash " + ft::sys::sq(ft::text::path_join(repo, "scripts/install.sh")) + flags)
    if e != "" is return e end
    if !c.dry && fs::exists(ft::text::path_join(c.rootfs, "usr/lib/systemd/systemd")) is
        ui::warn("w obrazie jest binarka systemd mimo [exclude] w compat.hk — sprawdź politykę (PID 1 ma być zenitd)")
    end
    return ""
end

;; Nakładka: files/ (wspólne) → editions/<id>/files/ (edycja nadpisuje) + branding + repos/compat/tools/edition do /usr/share/legendaryos.
pub fn step_overlay(c: Ctx) -> string is
    let files: string = ft::text::path_join(c.p.dir, "files")
    if !c.dry && !fs::is_dir(files) is return "brak katalogu files/" end
    let mut e: string = sh(c, "cp -a " + ft::sys::sq(files) + "/. " + ft::sys::sq(c.rootfs) + "/")
    if e != "" is return e end
    let own: string = ft::text::path_join(c.ed.dir, "files")
    if c.dry || fs::is_dir(own) is
        e = sh(c, "cp -a " + ft::sys::sq(own) + "/. " + ft::sys::sq(c.rootfs) + "/")
        if e != "" is return e end
    end
    let br: string = ft::text::path_join(c.p.dir, "branding")
    let dst: string = ft::text::path_join(c.rootfs, "usr/share/legendaryos/branding")
    e = sh(c, "mkdir -p " + ft::sys::sq(dst) + " && cp -a " + ft::sys::sq(br) + "/. " + ft::sys::sq(dst) + "/")
    if e != "" is return e end
    ;; repos.hk, compat.hk, tools.hk, edition.hk jadą w obrazie: lpm (na urządzeniu) używa tej samej polityki i katalogu co builder
    let share: string = ft::text::path_join(c.rootfs, "usr/share/legendaryos")
    let q: string = ft::sys::sq(share)
    let mut cmd: string = "mkdir -p " + q
    cmd = cmd + " && cp -f " + ft::sys::sq(ft::text::path_join(c.p.dir, c.p.repos)) + " " + q + "/repos.hk"
    cmd = cmd + " && cp -f " + ft::sys::sq(ft::text::path_join(c.p.dir, c.p.compat)) + " " + q + "/compat.hk"
    cmd = cmd + " && cp -f " + ft::sys::sq(ft::text::path_join(c.p.dir, c.p.tools_catalog)) + " " + q + "/tools.hk"
    cmd = cmd + " && cp -f " + ft::sys::sq(ft::text::path_join(c.ed.dir, "edition.hk")) + " " + q + "/edition.hk"
    return sh(c, cmd)
end

fn run_hook(c: Ctx, src: string, f: string, label: string) -> string is
    if ft::text::ends_with(f, ".sh") is
        ui::info("hook " + label)
        let tmp: string = ft::text::path_join(c.rootfs, "tmp/legendary-hook-" + f)
        let mut e: string = sh(c, "install -D -m 0755 " + ft::sys::sq(src) + " " + ft::sys::sq(tmp))
        if e != "" is return e end
        let envs: string = "LEGENDARY_EDITION=" + ft::sys::sq(c.ed.id) + " LEGENDARY_DISPLAY_MANAGER=" + ft::sys::sq(c.ed.dm) + " LEGENDARY_DEFAULT_TARGET=" + ft::sys::sq(c.ed.target) + " LEGENDARY_DESKTOP=" + ft::sys::sq(c.ed.desktop)
        e = sh(c, "chroot " + ft::sys::sq(c.rootfs) + " /usr/bin/env " + envs + " /bin/sh /tmp/legendary-hook-" + f)
        let rm: string = sh(c, "rm -f " + ft::sys::sq(tmp))
        if e != "" is return "hook " + label + ": " + e end
        return ""
    end
    if ft::text::ends_with(f, ".hl") is
        if fs::size(src) == 0 && !c.dry is
            ui::info("hook " + label + " pusty — pominięty")
            return ""
        end
        if ft::sys::have_tool("hl") is
            ui::info("hook " + label + " (hl)")
            let e2: string = sh(c, "LEGENDARY_ROOTFS=" + ft::sys::sq(c.rootfs) + " LEGENDARY_EDITION=" + ft::sys::sq(c.ed.id) + " hl " + ft::sys::sq(src))
            if e2 != "" is return "hook " + label + ": " + e2 end
            return ""
        end
        if c.strict is return "hook " + label + ": brak `hl` na hoście (--strict)" end
        ui::warn("hook " + label + " pominięty: brak `hl` na hoście")
    end
    return ""
end

;; Skrypty: scripts/ (wspólne) potem editions/<id>/scripts/ — każdy katalog alfabetycznie; *.sh w chroocie, *.hl przez `hl`.
pub fn step_hooks(c: Ctx) -> string is
    let dirs: [string] = [ft::text::path_join(c.p.dir, "scripts"), ft::text::path_join(c.ed.dir, "scripts")]
    let labels: [string] = ["", c.ed.id + "/"]
    let mut d: int = 0
    while d < dirs.len() is
        if fs::is_dir(dirs[d]) is
            let files: [string] = proj::sort(fs::list_dir(dirs[d]))
            let mut i: int = 0
            while i < files.len() is
                let f: string = files[i]
                i += 1
                let e: string = run_hook(c, ft::text::path_join(dirs[d], f), f, labels[d] + f)
                if e != "" is return e end
            end
        end
        d += 1
    end
    return ""
end

;; Zamiana układu Fedory na LegendaryOS: usr->system, etc/var/root/srv->state, nowe korzenie, symlinki zgodności.
pub fn step_layout(c: Ctx) -> string is
    let r: string = c.rootfs
    let mut cmds: [string] = []
    cmds.push("cd " + ft::sys::sq(r) + " && rm -f bin sbin lib lib64")
    cmds.push("cd " + ft::sys::sq(r) + " && mv usr system")
    cmds.push("cd " + ft::sys::sq(r) + " && mkdir -p state && mv etc state/etc && mv var state/var")
    cmds.push("cd " + ft::sys::sq(r) + " && for d in root srv; do [ -e $d ] && [ ! -L $d ] && mv $d state/$d; done; true")
    let mut i: int = 0
    while i < cmds.len() is
        let e: string = sh(c, cmds[i])
        if e != "" is return e end
        i += 1
    end
    if c.dry is
        write("    # ft::api::layout_ensure + layout_apply_compat w " + r)
        return ""
    end
    let le: string = ft::api::layout_ensure(r)
    if le != "" is return le end
    let made: [string] = ft::api::layout_apply_compat(r)
    ui::info("układ: /system /state /packages /tools /home + " + ft::text::istr(made.len()) + " symlinków zgodności")
    return ""
end

pub fn manifest_fields(c: Ctx) -> [string] is
    return ["name=" + c.ed.name, "version=" + c.p.version, "base=fedora", "base_release=" + c.p.base_release,
        "arch=" + c.p.arch, "channel=" + c.p.channel, "tag=" + c.tag, "generation=1", "kind=base",
        "created=" + now_iso(), "desktop.environment=" + c.ed.desktop, "desktop.display_manager=" + c.ed.dm,
        "os.edition=" + c.ed.id, "deployment.base=" + c.tag]
end

;; os-release, issue, hostname i manifest.toml (po zamianie układu: etc -> state/etc).
pub fn step_identity(c: Ctx) -> string is
    let p: proj::Project = c.p
    let q: string = __builtin_char_code_to_str(34)
    let osr: string = "NAME=" + q + p.name + q + "\nID=" + p.id + "\nID_LIKE=fedora\nVERSION=" + q + p.version + q + "\nVERSION_ID=" + p.version + "\nPRETTY_NAME=" + q + c.ed.name + " " + p.version + q + "\nVARIANT=" + q + c.ed.name + q + "\nVARIANT_ID=" + c.ed.id + "\nHOME_URL=" + q + "https://github.com/LegendaryOS-Linux-System" + q + "\n"
    let etc: string = ft::text::path_join(c.rootfs, "state/etc")
    if c.dry is
        write("    # zapis state/etc/os-release, issue, hostname oraz manifest.toml (ft::api::os_manifest_write)")
        return ""
    end
    if !fs::write(ft::text::path_join(etc, "os-release"), osr) is return "nie można zapisać os-release" end
    let w1: bool = fs::write(ft::text::path_join(etc, "hostname"), p.id + "-" + c.ed.id + "\n")
    let w2: bool = fs::write(ft::text::path_join(etc, "issue"), c.ed.name + " " + p.version + " \\l\n")
    ;; zapis + walidacja (m.in. init.service_manager == zenitd) robi biblioteka
    return ft::api::os_manifest_write(ft::text::path_join(c.rootfs, "manifest.toml"), manifest_fields(c))
end

;; ── Narzędzia: pobranie (tools) → Z# (zsharp) → jeden obraz squashfs (toolbox) ────────────────────────

;; Lokalne binarki (zamiast pobierania): LEGENDARY_TOOLS_LOCAL/<nazwa>, LPM_BIN, zenitd z kroku zenitd (ta sama binarka co w /system).
fn gather_local(c: Ctx) -> string is
    let ld: string = local_dir(c)
    ft::sys::mkdir_p(ld)
    let user: string = ft::sys::getenv_or("LEGENDARY_TOOLS_LOCAL", "")
    if user != "" is
        if !fs::is_dir(user) is return "LEGENDARY_TOOLS_LOCAL=" + user + " nie jest katalogiem" end
        let e: string = sh(c, "cp -a " + ft::sys::sq(user) + "/. " + ft::sys::sq(ld) + "/")
        if e != "" is return e end
    end
    let lpm: string = ft::sys::getenv_or("LPM_BIN", "")
    if lpm != "" is
        let e2: string = sh(c, "install -m 0755 " + ft::sys::sq(lpm) + " " + ft::sys::sq(ft::text::path_join(ld, "lpm")))
        if e2 != "" is return e2 end
    end
    let zen: string = ft::text::path_join(c.rootfs, "system/lib/zenit/zenitd")
    if fs::exists(zen) is
        let e3: string = sh(c, "install -m 0755 " + ft::sys::sq(zen) + " " + ft::sys::sq(ft::text::path_join(ld, "zenitd")))
        if e3 != "" is return e3 end
    end
    return ""
end

pub fn step_tools(c: Ctx) -> string is
    let cat: string = ft::text::path_join(c.p.dir, c.p.tools_catalog)
    let want: [string] = proj::edition_tools(c.p, c.ed)
    ui::info("edycja " + c.ed.id + ": " + ft::text::istr(want.len()) + " narzędzi z katalogu " + c.p.tools_catalog)
    if c.dry is
        let mut i: int = 0
        while i < want.len() is
            let f: [string] = ft::text::split(want[i], tabs())
            write("    # " + f[0] + " (" + f[2] + ", " + f[5] + ") <- github.com/" + f[6] + " -> /tools/bin/" + f[1])
            i += 1
        end
        write("    # ft::api::tb_fetch + tb_stage -> " + stage_dir(c))
        return ""
    end
    let ge: string = gather_local(c)
    if ge != "" is return ge end
    let rows: [string] = ft::api::tb_fetch(cat, c.ed.id, c.ed.exclude, c.cache, local_dir(c), c.offline)
    let mut bad: int = 0
    let mut warned: int = 0
    let mut good: [string] = []
    let mut i: int = 0
    while i < rows.len() is
        let row: string = rows[i]
        let f: [string] = ft::text::split(row, tabs())
        i += 1
        if f[0] == "#manifest" is
            if f.len() > 2 && f[2] != "" is ui::warn("manifest.hk: " + f[2]) else is ui::info("manifest.hk: " + f[1]) end
        else is
            if f[0] == "OK" is
                ui::ok(f[1] + " " + f[3] + " (" + ft::text::istr(ft::text::parse_int(f[4], 0) / 1024) + " KiB)")
                good.push(row)
            else is
                let msg: string = fld(f, 10)
                if f[0] == "WARN" is
                    warned += 1
                    ui::warn(f[1] + " " + f[3] + ": " + msg)
                    good.push(row)
                else is
                    ;; ERR: wymagane narzędzie to błąd (chyba że --allow-missing), opcjonalne to ostrzeżenie
                    let req: bool = is_required(want, f[1])
                    if req && !c.allow_missing is
                        bad += 1
                        ui::err(f[1] + ": " + msg)
                    else is
                        warned += 1
                        ui::warn(f[1] + " pominięte: " + msg)
                    end
                end
            end
        end
    end
    if bad > 0 is return ft::text::istr(bad) + " wymaganych narzędzi nie udało się pobrać (--allow-missing pozwala budować bez nich)" end
    if c.strict && warned > 0 is return ft::text::istr(warned) + " ostrzeżeń przy pobieraniu narzędzi (--strict)" end
    if good.len() == 0 is return "żadne narzędzie nie zostało pobrane" end
    let se: string = ft::api::tb_stage(stage_dir(c), good, cat, c.ed.id, c.p.version, now_iso())
    if se != "" is return se end
    ui::ok("stage /tools: " + ft::text::istr(good.len()) + " narzędzi")
    ;; rows do kroku toolbox (kopie "system") — zapis obok stage
    let w: bool = fs::write(ft::text::path_join(c.work, "tools-rows.tsv"), ft::text::join(good, "\n") + "\n")
    return ""
end

fn fld(f: [string], n: int) -> string is
    if n < f.len() is return f[n] end
    return ""
end

fn is_required(want: [string], id: string) -> bool is
    let mut i: int = 0
    while i < want.len() is
        let f: [string] = ft::text::split(want[i], tabs())
        if f[0] == id is return f[3] == "true" end
        i += 1
    end
    return true
end

;; Z#: install.hlpp z repozytorium Zenit-Linux/Z-Sharp, uruchamiany przez hlpp (narzędzie z katalogu) NA hoście.
;; Środowisko skryptu: DESTDIR=<stage /tools> PREFIX=/ LEGENDARY_ROOTFS LEGENDARY_TOOLS_STAGE LEGENDARY_EDITION.
pub fn step_zsharp(c: Ctx) -> string is
    if c.p.zsharp_script == "" is
        ui::info("Z#: [zsharp] script nie ustawiony — pominięto")
        return ""
    end
    let stage: string = stage_dir(c)
    let script: string = ft::text::path_join(c.work, "zsharp-install.hlpp")
    if c.dry is
        write("    $ curl -fsSL " + c.p.zsharp_script + " -o " + script)
        write("    $ DESTDIR=" + stage + " PREFIX=/ hlpp " + script)
        return ""
    end
    let hlpp: string = ft::text::path_join(stage, "bin/hlpp")
    if !fs::exists(hlpp) is
        if c.p.zsharp_required || c.strict is return "Z#: brak hlpp w narzędziach (potrzebny do install.hlpp)" end
        ui::warn("Z#: brak hlpp — pominięto instalację Z#")
        return ""
    end
    if c.offline is
        ui::warn("Z#: tryb offline — pominięto")
        return ""
    end
    let mut e: string = sh(c, "curl -fsSL --retry 3 " + ft::sys::sq(c.p.zsharp_script) + " -o " + ft::sys::sq(script))
    if e != "" is
        if c.p.zsharp_required || c.strict is return "Z#: " + e end
        ui::warn("Z#: nie pobrano install.hlpp — pominięto")
        return ""
    end
    if fs::size(script) < 8 is
        let m: string = "Z#: install.hlpp w repozytorium jest pusty (" + c.p.zsharp_script + ") — Z# nie został zainstalowany"
        if c.p.zsharp_required || c.strict is return m end
        ui::warn(m)
        return ""
    end
    let wd: string = ft::text::path_join(c.work, "zsharp")
    ft::sys::mkdir_p(wd)
    let envs: string = "DESTDIR=" + ft::sys::sq(stage) + " PREFIX=/ LEGENDARY_ROOTFS=" + ft::sys::sq(c.rootfs) + " LEGENDARY_TOOLS_STAGE=" + ft::sys::sq(stage) + " LEGENDARY_EDITION=" + ft::sys::sq(c.ed.id)
    e = sh(c, "cd " + ft::sys::sq(wd) + " && env " + envs + " " + ft::sys::sq(hlpp) + " " + ft::sys::sq(script))
    if e != "" is
        if c.p.zsharp_required || c.strict is return "Z#: " + e end
        ui::warn("Z#: instalacja nie powiodła się — " + e)
        return ""
    end
    let sha: string = ft::api::tb_sha256(script)
    let ap: sys::Exec = ft::sys::exec("printf '\\n[zsharp]\\n-> script => %s\\n-> sha256 => %s\\n' " + ft::sys::sq(c.p.zsharp_script) + " " + ft::sys::sq(sha) + " >> " + ft::sys::sq(ft::text::path_join(stage, "TOOLS.hk")))
    ui::ok("Z# zainstalowany do /tools")
    return ""
end

;; stage -> /tools/<image>.sqfs (jeden obraz) + kopie narzędzi "system" w /system/bin.
pub fn step_toolbox(c: Ctx) -> string is
    let img: string = ft::text::path_join(ft::text::path_join(c.rootfs, "tools"), c.p.tools_image)
    if c.dry is
        write("    # ft::api::tb_pack " + stage_dir(c) + " -> " + img + " (squashfs zstd, jeden plik)")
        write("    # kopie narzędzi system=true -> " + ft::text::path_join(c.rootfs, "system/bin"))
        return ""
    end
    ft::sys::mkdir_p(ft::text::path_join(c.rootfs, "tools"))
    let r: [string] = ft::api::tb_pack(stage_dir(c), img)
    if r[0] != "" is return r[0] end
    ui::ok("tools.sqfs: " + ft::text::istr(ft::text::parse_int(r[1], 0) / 1024) + " KiB, sha256 " + r[2][0..12])
    ;; kopie systemowe: lpm i zenitd muszą działać zanim /tools się zamontuje
    let rf: string = ft::text::path_join(c.work, "tools-rows.tsv")
    if fs::exists(rf) is
        let rows: [string] = ft::text::lines(fs::read(rf))
        let mut i: int = 0
        while i < rows.len() is
            if rows[i] != "" is
                let f: [string] = ft::text::split(rows[i], tabs())
                if f.len() >= 10 && f[7] == "1" is
                    let e: string = sh(c, "install -D -m 0755 " + ft::sys::sq(ft::text::path_join(ft::text::path_join(stage_dir(c), "bin"), f[2])) + " " + ft::sys::sq(ft::text::path_join(c.rootfs, "system/bin/" + f[2])))
                    if e != "" is return e end
                    ui::info("/system/bin/" + f[2] + " (kopia systemowa)")
                end
            end
            i += 1
        end
    end
    let lock: string = sh(c, "cp -f " + ft::sys::sq(ft::text::path_join(stage_dir(c), "TOOLS.hk")) + " " + ft::sys::sq(ft::text::path_join(c.out, "tools.lock.hk")))
    ;; sprawdzenie: lpm musi być w obrazie, inaczej system nie zamontuje /tools ani nie zainstaluje pakietów
    if !fs::exists(ft::text::path_join(c.rootfs, "system/bin/lpm")) is
        if c.strict && !c.allow_missing is return "w /system/bin brak lpm (nie pobrano ani LPM_BIN)" end
        ui::warn("obraz powstanie BEZ lpm w /system/bin — system nie zamontuje /tools przy starcie")
    end
    return ""
end

;; Snapshot FastTree całego rootfs + rejestracja wdrożenia bazowego.
pub fn step_fasttree(c: Ctx) -> string is
    let ftroot: string = ft::text::path_join(c.out, "fasttree")
    if c.dry is
        write("    # ft::api::snapshot " + ftroot + " <- " + c.rootfs + " tag=" + c.tag)
        write("    # ft::api::register_base " + c.tag)
        return ""
    end
    let e: string = ft::api::snapshot(ftroot, c.rootfs, c.tag)
    if e != "" is return e end
    ui::ok("snapshot FastTree: " + ft::text::istr(ft::api::manifest_entries(ftroot, c.tag)) + " wpisów")
    return ft::api::register_base(c.out, c.tag, ft::text::path_join(c.rootfs, "manifest.toml"), now_iso())
end

fn artifact_name(c: Ctx) -> string is
    return c.p.oci_name + "-" + c.ed.id + "-" + c.p.version + "-" + c.p.arch
end

pub fn step_oci(c: Ctx) -> string is
    if !c.dry && !ft::sys::have_tool("podman") is return "brak podmana (potrzebny do obrazu OCI)" end
    let ref: string = proj::lower(c.p.registry + "/" + c.p.org + "/" + c.p.oci_name + "-" + c.ed.id) + ":" + c.p.version
    let archive: string = ft::text::path_join(c.out, artifact_name(c) + ".oci.tar")
    let init: string = "/system/lib/zenit/zenitd"
    let dq: string = __builtin_char_code_to_str(34)
    let mut e: string = sh(c, "tar --numeric-owner --xattrs -C " + ft::sys::sq(c.rootfs) + " -cf - . | podman import --change " + ft::sys::sq("CMD [" + dq + init + dq + "]") + " --change " + ft::sys::sq("LABEL org.opencontainers.image.title=" + c.ed.name) + " --change " + ft::sys::sq("LABEL org.opencontainers.image.version=" + c.p.version) + " --change " + ft::sys::sq("LABEL org.legendaryos.edition=" + c.ed.id) + " - " + ft::sys::sq(ref))
    if e != "" is return e end
    e = sh(c, "podman save --format oci-archive -o " + ft::sys::sq(archive) + " " + ft::sys::sq(ref))
    return e
end

fn grub_cfg(c: Ctx) -> string is
    let lb: string = ft::text::lbrace()
    let rb: string = ft::text::rbrace()
    let args: string = "root=live:CDLABEL=" + c.ed.iso_label + " rd.live.image init=/sbin/init " + c.ed.kernel_args
    let title: string = c.ed.name + " " + c.p.version
    return "set default=0\nset timeout=5\nmenuentry '" + title + " (live)' " + lb + "\n  linux /boot/vmlinuz " + args + "\n  initrd /boot/initramfs.img\n" + rb + "\nmenuentry '" + title + " (tryb awaryjny)' " + lb + "\n  linux /boot/vmlinuz " + args + " zenit.unit=rescue\n  initrd /boot/initramfs.img\n" + rb + "\n"
end

;; ISO live: squashfs rootfs w LiveOS/ + kernel/initramfs + GRUB (grub2-mkrescue: BIOS + UEFI). Etykieta = iso_label edycji.
pub fn step_iso(c: Ctx) -> string is
    let iso: string = ft::text::path_join(c.work, "iso")
    let out: string = ft::text::path_join(c.out, artifact_name(c) + ".iso")
    let mut e: string = sh(c, "mkdir -p " + ft::sys::sq(iso) + "/LiveOS " + ft::sys::sq(iso) + "/boot/grub")
    if e != "" is return e end
    e = sh(c, "mksquashfs " + ft::sys::sq(c.rootfs) + " " + ft::sys::sq(iso) + "/LiveOS/squashfs.img -noappend -comp zstd -Xcompression-level 15 -quiet")
    if e != "" is return e end
    e = sh(c, "k=$(ls " + ft::sys::sq(c.rootfs) + "/system/lib/modules | sort -V | tail -1) && cp " + ft::sys::sq(c.rootfs) + "/system/lib/modules/$k/vmlinuz " + ft::sys::sq(iso) + "/boot/vmlinuz && if [ -f " + ft::sys::sq(c.rootfs) + "/system/lib/modules/$k/initramfs.img ]; then cp " + ft::sys::sq(c.rootfs) + "/system/lib/modules/$k/initramfs.img " + ft::sys::sq(iso) + "/boot/initramfs.img; else chroot " + ft::sys::sq(c.rootfs) + " dracut --no-hostonly --add 'dmsquash-live' -f /tmp/initramfs.img $k && cp " + ft::sys::sq(c.rootfs) + "/tmp/initramfs.img " + ft::sys::sq(iso) + "/boot/initramfs.img; fi")
    if e != "" is return e end
    if !c.dry is
        if !fs::write(ft::text::path_join(iso, "boot/grub/grub.cfg"), grub_cfg(c)) is return "nie można zapisać grub.cfg" end
    else is
        write("    # zapis boot/grub/grub.cfg")
    end
    return sh(c, "grub2-mkrescue -o " + ft::sys::sq(out) + " " + ft::sys::sq(iso) + " -volid " + ft::sys::sq(c.ed.iso_label))
end

;; Sumy sha256 + build-info.hk (edycja, wersje, czas) — artefakty wydania.
pub fn step_checksums(c: Ctx) -> string is
    let e: string = sh(c, "cd " + ft::sys::sq(c.out) + " && for f in *.iso *.oci.tar; do [ -f \"$f\" ] && sha256sum \"$f\" > \"$f.sha256\"; done; true")
    if e != "" is return e end
    if c.dry is return "" end
    let info: string = "! build-info.hk — metadane budowy (generowane)\n[build]\n-> distro => " + c.p.id + "\n-> edition => " + c.ed.id + "\n-> name => " + c.ed.name + "\n-> version => " + c.p.version + "\n-> arch => " + c.p.arch + "\n-> base_release => " + c.p.base_release + "\n-> created => " + now_iso() + "\n-> builder => legendaryos-builder " + version() + "\n"
    if !fs::write(ft::text::path_join(c.out, "build-info.hk"), info) is return "nie można zapisać build-info.hk" end
    return ""
end

pub fn version() -> string is return "0.3.0" end

;; Lista kroków dla `plan` i `build`.
pub fn step_names(formats: [string]) -> [string] is
    let mut s: [string] = ["prepare", "packages", "zenitd", "overlay", "hooks", "layout", "identity", "tools", "zsharp", "toolbox", "fasttree"]
    let mut i: int = 0
    while i < formats.len() is
        s.push(formats[i])
        i += 1
    end
    s.push("checksums")
    return s
end

pub fn run_step(c: Ctx, name: string) -> string is
    if name == "prepare" is return step_prepare(c) end
    if name == "packages" is return step_packages(c) end
    if name == "zenitd" is return step_zenitd(c) end
    if name == "overlay" is return step_overlay(c) end
    if name == "hooks" is return step_hooks(c) end
    if name == "layout" is return step_layout(c) end
    if name == "identity" is return step_identity(c) end
    if name == "tools" is return step_tools(c) end
    if name == "zsharp" is return step_zsharp(c) end
    if name == "toolbox" is return step_toolbox(c) end
    if name == "fasttree" is return step_fasttree(c) end
    if name == "oci" is return step_oci(c) end
    if name == "iso" is return step_iso(c) end
    if name == "checksums" is return step_checksums(c) end
    return "nieznany krok: " + name
end

;; Jedna edycja. `only` ("" = wszystkie kroki) ogranicza do jednego kroku. 0 = OK.
pub fn run(c: Ctx, only: string) -> int is
    let names: [string] = step_names(c.p.formats)
    let mut i: int = 0
    while i < names.len() is
        let n: string = names[i]
        i += 1
        if only == "" || only == n is
            ui::step(i, names.len(), c.ed.id + " · " + n)
            logline(c, "krok " + n)
            let e: string = run_step(c, n)
            if e != "" is
                ui::err("edycja " + c.ed.id + ", krok '" + n + "': " + e)
                logline(c, "KROK " + n + " NIE POWIÓDŁ SIĘ")
                return 1
            end
        end
    end
    ui::ok("edycja " + c.ed.id + " gotowa: " + c.out)
    return 0
end
