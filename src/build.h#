;; Pipeline budowy LegendaryOS (Fedora -> układ /system /state /packages /tools -> FastTree -> OCI/ISO).
;; Każdy krok zwraca "" (OK) albo komunikat błędu. W trybie --dry-run polecenia są tylko drukowane.

pub struct Ctx is
    pub p:       proj::Project
    pub work:    string
    pub rootfs:  string
    pub out:     string
    pub dry:     bool
    pub strict:  bool
    pub tag:     string
end

pub fn new_ctx(p: proj::Project, dry: bool, strict: bool) -> Ctx is
    let b: string = text::path_join(p.dir, "build")
    return Ctx { p: p, work: text::path_join(b, "work"), rootfs: text::path_join(b, "rootfs"),
        out: text::path_join(b, "out"), dry: dry, strict: strict, tag: p.id + "-" + p.version }
end

;; Uruchamia polecenie (lub je drukuje w dry-run). Zwraca "" albo błąd z końcówką wyjścia.
fn sh(c: Ctx, cmd: string) -> string is
    if c.dry is
        write("    $ " + cmd)
        return ""
    end
    let r: sys::Exec = sys::exec(cmd)
    if r.code != 0 is
        let o: string = text::trim(r.out)
        let n: int = o.len()
        let mut tail: string = o
        if n > 1500 is tail = "..." + o[n - 1500..n] end
        return "polecenie zakończone kodem " + text::istr(r.code) + ": " + cmd + "\n" + tail
    end
    return ""
end

fn mkdirs(c: Ctx, path: string) is
    if !c.dry is sys::mkdir_p(path) end
end

;; ── Kroki ────────────────────────────────────────────────────────────────────

pub fn step_prepare(c: Ctx) -> string is
    if !c.dry && !sys::ok("test \"$(id -u)\" = 0") is
        return "budowa wymaga roota (chroot, dnf --installroot, mount). Uruchom przez sudo albo w kontenerze --privileged"
    end
    if !c.dry is
        sys::rm_rf(c.rootfs)
        sys::rm_rf(c.work)
    end
    mkdirs(c, c.rootfs)
    mkdirs(c, c.work)
    mkdirs(c, c.out)
    return ""
end

pub fn step_packages(c: Ctx) -> string is
    let pk: [string] = proj::packages(c.p)
    if pk.len() == 0 is return "package-list/ jest pusta" end
    let mut i: int = 0
    let mut args: string = ""
    while i < pk.len() is
        if !proj::safe_pkg(pk[i]) is return "niepoprawna nazwa pakietu w package-list/: '" + pk[i] + "'" end
        args = args + " " + sys::sq(pk[i])
        i += 1
    end
    ui::info("pakietów z list: " + text::istr(pk.len()))
    let mut cmd: string = c.p.dnf + " install -y --installroot=" + sys::sq(c.rootfs) + " --releasever=" + c.p.base_release
    if c.p.arch == "aarch64" is cmd = cmd + " --forcearch=aarch64" end
    cmd = cmd + " --setopt=install_weak_deps=False --setopt=tsflags=nodocs" + args
    return sh(c, cmd)
end

;; Instalacja zenitd: pobranie skryptu install.sh (adres z config.hk) i uruchomienie z DESTDIR.
;; Skrypt liczy HERE=<katalog skryptu>/.. i oczekuje data/ oraz (bez --no-build) źródeł Z#,
;; więc klonujemy repo, a pobrany skrypt kładziemy w jego scripts/.
pub fn step_zenitd(c: Ctx) -> string is
    let repo: string = text::path_join(c.work, "zenitd")
    let mut e: string = sh(c, "git clone --depth 1 " + sys::sq(c.p.zenitd_repo) + " " + sys::sq(repo))
    if e != "" is return e end
    e = sh(c, "curl -fsSL " + sys::sq(c.p.zenitd_script) + " -o " + sys::sq(text::path_join(repo, "scripts/install.sh")))
    if e != "" is return e end
    let mut flags: string = ""
    let prebuilt: string = sys::getenv_or("ZENITD_BIN", "")
    if prebuilt != "" is
        e = sh(c, "install -D -m 0755 " + sys::sq(prebuilt) + " " + sys::sq(text::path_join(repo, "target/release/zenitd")))
        if e != "" is return e end
        flags = " --no-build"
    else is
        if !c.dry && !sys::have_tool("z#") is
            return "brak kompilatora z# na hoście; podaj gotową binarkę: ZENITD_BIN=/ścieżka/zenitd (zob. docs/BUILDING.md)"
        end
    end
    e = sh(c, "DESTDIR=" + sys::sq(c.rootfs) + " PREFIX=/usr bash " + sys::sq(text::path_join(repo, "scripts/install.sh")) + flags)
    if e != "" is return e end
    if !c.dry && fs::exists(text::path_join(c.rootfs, "usr/lib/systemd/systemd")) is
        ui::warn("w obrazie jest pakiet systemd (zależność innych pakietów) — nie jest używany jako init; init=/sbin/init -> zenitd")
    end
    return ""
end

pub fn step_overlay(c: Ctx) -> string is
    let files: string = text::path_join(c.p.dir, "files")
    if !c.dry && !fs::is_dir(files) is return "brak katalogu files/" end
    let mut e: string = sh(c, "cp -a " + sys::sq(files) + "/. " + sys::sq(c.rootfs) + "/")
    if e != "" is return e end
    let br: string = text::path_join(c.p.dir, "branding")
    let dst: string = text::path_join(c.rootfs, "usr/share/legendaryos/branding")
    e = sh(c, "mkdir -p " + sys::sq(dst) + " && cp -a " + sys::sq(br) + "/. " + sys::sq(dst) + "/")
    return e
end

;; Skrypty z scripts/ (kolejność alfabetyczna): *.sh w chroocie; *.hl przez `hl` (w obrazie albo na hoście).
pub fn step_hooks(c: Ctx) -> string is
    let dir: string = text::path_join(c.p.dir, "scripts")
    if !fs::is_dir(dir) is return "" end
    let files: [string] = proj::sort(fs::list_dir(dir))
    let mut i: int = 0
    while i < files.len() is
        let f: string = files[i]
        i += 1
        let src: string = text::path_join(dir, f)
        if text::ends_with(f, ".sh") is
            ui::info("hook " + f)
            let tmp: string = text::path_join(c.rootfs, "tmp/legendary-hook-" + f)
            let mut e: string = sh(c, "install -D -m 0755 " + sys::sq(src) + " " + sys::sq(tmp))
            if e != "" is return e end
            e = sh(c, "chroot " + sys::sq(c.rootfs) + " /bin/sh /tmp/legendary-hook-" + f)
            if e != "" is return "hook " + f + ": " + e end
            let rm: string = sh(c, "rm -f " + sys::sq(tmp))
        else is
            if text::ends_with(f, ".hl") is
                if fs::size(src) == 0 && !c.dry is
                    ui::info("hook " + f + " pusty — pominięty")
                else is
                    if sys::have_tool("hl") is
                        ui::info("hook " + f + " (hl)")
                        let e2: string = sh(c, "LEGENDARY_ROOTFS=" + sys::sq(c.rootfs) + " hl " + sys::sq(src))
                        if e2 != "" is return "hook " + f + ": " + e2 end
                    else is
                        if c.strict is return "hook " + f + ": brak `hl` na hoście (--strict)" end
                        ui::warn("hook " + f + " pominięty: brak `hl` na hoście")
                    end
                end
            end
        end
    end
    return ""
end

;; Zamiana układu Fedory na LegendaryOS: usr->system, etc/var/root/srv->state, nowe korzenie, symlinki zgodności.
pub fn step_layout(c: Ctx) -> string is
    let r: string = c.rootfs
    let mut cmds: [string] = []
    cmds.push("cd " + sys::sq(r) + " && rm -f bin sbin lib lib64")
    cmds.push("cd " + sys::sq(r) + " && mv usr system")
    cmds.push("cd " + sys::sq(r) + " && mkdir -p state && mv etc state/etc && mv var state/var")
    cmds.push("cd " + sys::sq(r) + " && for d in root srv; do [ -e $d ] && [ ! -L $d ] && mv $d state/$d; done; true")
    let mut i: int = 0
    while i < cmds.len() is
        let e: string = sh(c, cmds[i])
        if e != "" is return e end
        i += 1
    end
    if c.dry is
        write("    # layout::ensure + apply_compat_links w " + r)
        return ""
    end
    let l: layout::Layout = layout::at(r)
    let le: layout::LayoutResult = layout::ensure(l)
    if !le.ok is return le.error end
    let made: [string] = layout::apply_compat_links(l)
    ui::info("układ: /system /state /packages /tools /home + " + text::istr(made.len()) + " symlinków zgodności")
    return ""
end

pub fn now_iso() -> string is
    let r: sys::Exec = sys::exec("date -u +%Y-%m-%dT%H:%M:%SZ")
    return text::trim(r.out)
end

pub fn manifest_doc(c: Ctx) -> lmanifest::Doc is
    let mut d: lmanifest::Doc = lmanifest::new_os_manifest(lmanifest::NewOs { name: c.p.name, version: c.p.version,
        base: "fedora", base_release: c.p.base_release, arch: c.p.arch, channel: c.p.channel, tag: c.tag,
        parent: "", generation: 1, kind: "base", created: now_iso() })
    d = lmanifest::put_str(d, "desktop", "environment", c.p.desktop)
    d = lmanifest::put_str(d, "desktop", "display_manager", c.p.dm)
    d = lmanifest::put_str(d, "deployment", "base", c.tag)
    return d
end

;; os-release, issue, hostname i manifest.toml (po zamianie układu: etc -> state/etc).
pub fn step_identity(c: Ctx) -> string is
    let p: proj::Project = c.p
    let q: string = __builtin_char_code_to_str(34)
    let osr: string = "NAME=" + q + p.name + q + "\nID=" + p.id + "\nID_LIKE=fedora\nVERSION=" + q + p.version + q + "\nVERSION_ID=" + p.version + "\nPRETTY_NAME=" + q + p.name + " " + p.version + q + "\nVARIANT_ID=" + p.channel + "\nHOME_URL=" + q + "https://github.com/LegendaryOS" + q + "\n"
    let etc: string = text::path_join(c.rootfs, "state/etc")
    if c.dry is
        write("    # zapis state/etc/os-release, issue, hostname oraz manifest.toml")
        return ""
    end
    if !fs::write(text::path_join(etc, "os-release"), osr) is return "nie można zapisać os-release" end
    let w1: bool = fs::write(text::path_join(etc, "hostname"), p.id + "\n")
    let w2: bool = fs::write(text::path_join(etc, "issue"), p.name + " " + p.version + " \\l\n")
    let e: string = lmanifest::save(text::path_join(c.rootfs, "manifest.toml"), manifest_doc(c))
    if e != "" is return e end
    let probs: [string] = lmanifest::validate_manifest(manifest_doc(c))
    if probs.len() > 0 is return "manifest.toml: " + probs[0] end
    return ""
end

;; Narzędzia HackerOS/Zenit: katalog tools.hk -> /tools/<nazwa>/*.sqfs w obrazie.
pub fn step_tools(c: Ctx) -> string is
    let cat: string = text::path_join(c.p.dir, c.p.tools_catalog)
    if !fs::exists(cat) is
        ui::info("brak katalogu narzędzi (" + c.p.tools_catalog + ") — pominięto /tools")
        return ""
    end
    let r: hk::ParseResult = hk::load(cat)
    if !r.ok is return "tools.hk: " + r.error end
    let ks: [string] = hk::keys(r.doc, "tools")
    let l: layout::Layout = layout::at(c.rootfs)
    let mut fails: int = 0
    let mut i: int = 0
    while i < ks.len() is
        if text::ends_with(ks[i], ".git") is
            let name: string = ks[i][0..ks[i].len() - 4]
            let git: string = hk::get(r.doc, "tools", name + ".git", "")
            if c.dry is
                write("    # tools::pack " + name + " <- " + git)
            else is
                let t: tools::ToolResult = tools::pack(l, tools::new_spec(name, git, hk::get(r.doc, "tools", name + ".rev", ""),
                    hk::get(r.doc, "tools", name + ".entry", ""), hk::get(r.doc, "tools", name + ".build", "")))
                if !t.ok is
                    fails += 1
                    if c.strict is return "narzędzie " + name + ": " + t.error end
                    ui::warn("narzędzie " + name + " pominięte: " + t.error)
                else is
                    ui::ok("/tools/" + name + " @ " + t.commit[0..12] + " (" + text::istr(t.size / 1024) + " KiB)")
                end
            end
        end
        i += 1
    end
    if fails > 0 is ui::warn("narzędzi pominiętych: " + text::istr(fails)) end
    return ""
end

;; Snapshot FastTree całego rootfs + rejestracja wdrożenia bazowego.
pub fn step_fasttree(c: Ctx) -> string is
    let ftroot: string = text::path_join(c.out, "fasttree")
    let e: string = sh(c, "mkdir -p " + sys::sq(ftroot) + " && FASTTREE_ROOT=" + sys::sq(ftroot) + " fasttree snapshot " + sys::sq(c.rootfs) + " " + sys::sq(c.tag))
    if e != "" is return e end
    if c.dry is
        write("    # deployment::register_base " + c.tag)
        return ""
    end
    let l: layout::Layout = layout::at(c.out)
    let re: string = deployment::register_base(l, c.tag, manifest_doc(c), now_iso())
    if re != "" is return re end
    ;; (register_base zapisuje do <out>/state/deployments)
    return ""
end

pub fn step_oci(c: Ctx) -> string is
    if !c.dry && !sys::have_tool("podman") is return "brak podmana (potrzebny do obrazu OCI)" end
    let ref: string = proj::lower(c.p.registry + "/" + c.p.org + "/" + c.p.oci_name) + ":" + c.p.version
    let archive: string = text::path_join(c.out, c.p.id + "-" + c.p.version + "-" + c.p.arch + ".oci.tar")
    let init: string = "/system/lib/zenit/zenitd"
    let mut e: string = sh(c, "tar --numeric-owner --xattrs -C " + sys::sq(c.rootfs) + " -cf - . | podman import --change " + sys::sq("CMD [" + __builtin_char_code_to_str(34) + init + __builtin_char_code_to_str(34) + "]") + " --change " + sys::sq("LABEL org.opencontainers.image.title=" + c.p.name) + " - " + sys::sq(ref))
    if e != "" is return e end
    e = sh(c, "podman save --format oci-archive -o " + sys::sq(archive) + " " + sys::sq(ref))
    return e
end

fn grub_cfg(c: Ctx) -> string is
    let lb: string = text::lbrace()
    let rb: string = text::rbrace()
    let label: string = c.p.id + "-" + c.p.version
    let args: string = "root=live:CDLABEL=" + label + " rd.live.image init=/sbin/init " + c.p.kernel_args
    return "set default=0\nset timeout=5\nmenuentry '" + c.p.name + " " + c.p.version + " (live)' " + lb + "\n  linux /boot/vmlinuz " + args + "\n  initrd /boot/initramfs.img\n" + rb + "\nmenuentry '" + c.p.name + " (tryb awaryjny)' " + lb + "\n  linux /boot/vmlinuz " + args + " zenit.unit=rescue\n  initrd /boot/initramfs.img\n" + rb + "\n"
end

;; ISO live: squashfs rootfs w LiveOS/ + kernel/initramfs + GRUB (grub2-mkrescue: BIOS + UEFI).
pub fn step_iso(c: Ctx) -> string is
    let iso: string = text::path_join(c.work, "iso")
    let label: string = c.p.id + "-" + c.p.version
    let out: string = text::path_join(c.out, label + "-" + c.p.arch + ".iso")
    let mut e: string = sh(c, "mkdir -p " + sys::sq(iso) + "/LiveOS " + sys::sq(iso) + "/boot/grub")
    if e != "" is return e end
    e = sh(c, "mksquashfs " + sys::sq(c.rootfs) + " " + sys::sq(iso) + "/LiveOS/squashfs.img -noappend -comp zstd -Xcompression-level 15 -quiet")
    if e != "" is return e end
    ;; kernel i initramfs z obrazu (po zamianie układu: system/lib/modules/<ver>/vmlinuz)
    e = sh(c, "k=$(ls " + sys::sq(c.rootfs) + "/system/lib/modules | sort -V | tail -1) && cp " + sys::sq(c.rootfs) + "/system/lib/modules/$k/vmlinuz " + sys::sq(iso) + "/boot/vmlinuz && if [ -f " + sys::sq(c.rootfs) + "/system/lib/modules/$k/initramfs.img ]; then cp " + sys::sq(c.rootfs) + "/system/lib/modules/$k/initramfs.img " + sys::sq(iso) + "/boot/initramfs.img; else chroot " + sys::sq(c.rootfs) + " dracut --no-hostonly --add 'dmsquash-live' -f /tmp/initramfs.img $k && cp " + sys::sq(c.rootfs) + "/tmp/initramfs.img " + sys::sq(iso) + "/boot/initramfs.img; fi")
    if e != "" is return e end
    if !c.dry is
        if !fs::write(text::path_join(iso, "boot/grub/grub.cfg"), grub_cfg(c)) is return "nie można zapisać grub.cfg" end
    else is
        write("    # zapis boot/grub/grub.cfg")
    end
    e = sh(c, "grub2-mkrescue -o " + sys::sq(out) + " " + sys::sq(iso) + " -volid " + sys::sq(label))
    return e
end

pub fn step_checksums(c: Ctx) -> string is
    return sh(c, "cd " + sys::sq(c.out) + " && for f in *.iso *.oci.tar; do [ -f \"$f\" ] && sha256sum \"$f\" > \"$f.sha256\"; done; true")
end

;; Lista kroków dla `plan` i `build`.
pub fn step_names(p: proj::Project) -> [string] is
    let mut s: [string] = ["prepare", "packages", "zenitd", "overlay", "hooks", "layout", "identity", "tools", "fasttree"]
    let mut i: int = 0
    while i < p.formats.len() is
        s.push(p.formats[i])
        i += 1
    end
    s.push("checksums")
    return s
end

pub fn run_step(c: Ctx, name: string) -> string is
    if name == "prepare" is return step_prepare(c) end
    if name == "packages" is return step_packages(c) end
    if name == "zenitd" is return step_zenitd(c) end
    if name == "overlay" is return step_overlay(c) end
    if name == "hooks" is return step_hooks(c) end
    if name == "layout" is return step_layout(c) end
    if name == "identity" is return step_identity(c) end
    if name == "tools" is return step_tools(c) end
    if name == "fasttree" is return step_fasttree(c) end
    if name == "oci" is return step_oci(c) end
    if name == "iso" is return step_iso(c) end
    if name == "checksums" is return step_checksums(c) end
    return "nieznany krok: " + name
end

;; Cały pipeline. `only` ("" = wszystkie) ogranicza do jednego kroku.
pub fn run(c: Ctx, only: string) -> int is
    let names: [string] = step_names(c.p)
    let mut i: int = 0
    while i < names.len() is
        let n: string = names[i]
        i += 1
        if only == "" || only == n is
            ui::step(i, names.len(), n)
            let e: string = run_step(c, n)
            if e != "" is
                ui::err("krok '" + n + "': " + e)
                return 1
            end
        end
    end
    ui::ok("gotowe: " + c.out)
    return 0
end
