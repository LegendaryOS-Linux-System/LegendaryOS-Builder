pub fn mask32() -> int is return 4294967295 end

fn iv(i: int) -> int is
    if i == 0 is return 1779033703 end
    if i == 1 is return 3144134277 end
    if i == 2 is return 1013904242 end
    if i == 3 is return 2773480762 end
    if i == 4 is return 1359893119 end
    if i == 5 is return 2600822924 end
    if i == 6 is return 528734635 end
    return 1541459225
end

fn perm(i: int) -> int is
    if i == 0 is return 2 end
    if i == 1 is return 6 end
    if i == 2 is return 3 end
    if i == 3 is return 10 end
    if i == 4 is return 7 end
    if i == 5 is return 0 end
    if i == 6 is return 4 end
    if i == 7 is return 13 end
    if i == 8 is return 1 end
    if i == 9 is return 11 end
    if i == 10 is return 12 end
    if i == 11 is return 5 end
    if i == 12 is return 9 end
    if i == 13 is return 14 end
    if i == 14 is return 15 end
    return 8
end

fn rotr(x: int, n: int) -> int is
    let lo: int = x >> n
    let k: int = 32 - n
    let hi: int = x << k
    let r: int = lo | hi
    return r & 4294967295
end

;; stan v[16], słowa komunikatu m[16]; a,b,c,d — indeksy; mx,my — słowa.
fn g(v: [int], a: int, b: int, c: int, d: int, mx: int, my: int) is
    let mut va: int = v[a]
    let mut vb: int = v[b]
    let mut vc: int = v[c]
    let mut vd: int = v[d]
    va = (va + vb + mx) & 4294967295
    vd = rotr(vd ^ va, 16)
    vc = (vc + vd) & 4294967295
    vb = rotr(vb ^ vc, 12)
    va = (va + vb + my) & 4294967295
    vd = rotr(vd ^ va, 8)
    vc = (vc + vd) & 4294967295
    vb = rotr(vb ^ vc, 7)
    v[a] = va
    v[b] = vb
    v[c] = vc
    v[d] = vd
end

fn round(v: [int], m: [int]) is
    g(v, 0, 4, 8, 12, m[0], m[1])
    g(v, 1, 5, 9, 13, m[2], m[3])
    g(v, 2, 6, 10, 14, m[4], m[5])
    g(v, 3, 7, 11, 15, m[6], m[7])
    g(v, 0, 5, 10, 15, m[8], m[9])
    g(v, 1, 6, 11, 12, m[10], m[11])
    g(v, 2, 7, 8, 13, m[12], m[13])
    g(v, 3, 4, 9, 14, m[14], m[15])
end

fn permute(m: [int]) -> [int] is
    let mut out: [int] = []
    let mut i: int = 0
    while i < 16 is
        out.push(m[perm(i)])
        i += 1
    end
    return out
end

;; Zwraca pełny 16-słowowy stan po kompresji (pierwsze 8 słów = nowy CV
;; po XOR-ze z drugą połową; słowa 8..15 potrzebne tylko przy wyjściu ROOT).
fn compress(cv: [int], block: [int], counter: int, block_len: int, flags: int) -> [int] is
    let mut v: [int] = []
    let mut i: int = 0
    while i < 8 is
        v.push(cv[i])
        i += 1
    end
    v.push(iv(0))
    v.push(iv(1))
    v.push(iv(2))
    v.push(iv(3))
    v.push(counter & 4294967295)
    let chi: int = counter >> 32
    v.push(chi & 4294967295)
    v.push(block_len)
    v.push(flags)

    let mut m: [int] = block
    round(v, m)
    m = permute(m)
    round(v, m)
    m = permute(m)
    round(v, m)
    m = permute(m)
    round(v, m)
    m = permute(m)
    round(v, m)
    m = permute(m)
    round(v, m)
    m = permute(m)
    round(v, m)

    let mut j: int = 0
    while j < 8 is
        let lo: int = v[j] ^ v[j + 8]
        let hi: int = v[j + 8] ^ cv[j]
        v[j] = lo
        v[j + 8] = hi
        j += 1
    end
    return v
end

fn first8(v: [int]) -> [int] is
    let mut o: [int] = []
    let mut i: int = 0
    while i < 8 is
        o.push(v[i])
        i += 1
    end
    return o
end

fn iv_cv() -> [int] is
    let mut o: [int] = []
    let mut i: int = 0
    while i < 8 is
        o.push(iv(i))
        i += 1
    end
    return o
end

;; bajty [off, off+len) -> 16 słów little-endian, dopełnione zerami.
fn words_of(data: [int], off: int, len: int) -> [int] is
    let mut w: [int] = []
    let mut i: int = 0
    while i < 16 is
        let base: int = i * 4
        let mut x: int = 0
        let mut k: int = 0
        while k < 4 is
            let p: int = base + k
            if p < len is
                let b: int = data[off + p] & 255
                let sh: int = k * 8
                let part: int = b << sh
                x = x | part
            end
            k += 1
        end
        w.push(x)
        i += 1
    end
    return w
end

;; "Wyjście" węzła: wszystko, czego trzeba do policzenia CV albo roota.
pub struct Out is
    pub cv:        [int]
    pub block:     [int]
    pub counter:   int
    pub block_len: int
    pub flags:     int
end

fn out_cv(o: Out) -> [int] is
    return first8(compress(o.cv, o.block, o.counter, o.block_len, o.flags))
end

;; Przetwarza jeden chunk (<= 1024 B) i zwraca jego `Out` (jeszcze bez
;; CHUNK_END policzonego do CV — ostatni blok zostaje do finalizacji).
fn chunk_out(data: [int], off: int, len: int, chunk_counter: int) -> Out is
    let mut cv: [int] = iv_cv()
    let mut nblocks: int = (len + 63) / 64
    if nblocks == 0 is nblocks = 1 end
    let mut b: int = 0
    while b < nblocks - 1 is
        let mut fl: int = 0
        if b == 0 is fl = 1 end
        let w: [int] = words_of(data, off + b * 64, 64)
        cv = first8(compress(cv, w, chunk_counter, 64, fl))
        b += 1
    end
    let last_off: int = b * 64
    let last_len: int = len - last_off
    let mut fl2: int = 2
    if b == 0 is fl2 = 3 end
    let lw: [int] = words_of(data, off + last_off, last_len)
    return Out { cv: cv, block: lw, counter: chunk_counter, block_len: last_len, flags: fl2 }
end

fn parent_words(l: [int], r: [int]) -> [int] is
    let mut w: [int] = []
    let mut i: int = 0
    while i < 8 is
        w.push(l[i])
        i += 1
    end
    i = 0
    while i < 8 is
        w.push(r[i])
        i += 1
    end
    return w
end

fn parent_out(l: [int], r: [int]) -> Out is
    return Out { cv: iv_cv(), block: parent_words(l, r), counter: 0, block_len: 64, flags: 4 }
end

;; 32-bajtowy digest jako [int] 0..255.
fn root_bytes(o: Out) -> [int] is
    let st: [int] = compress(o.cv, o.block, 0, o.block_len, o.flags | 8)
    let mut out: [int] = []
    let mut i: int = 0
    while i < 8 is
        let w: int = st[i]
        let mut k: int = 0
        while k < 4 is
            let sh: int = k * 8
            let sv: int = w >> sh
            out.push(sv & 255)
            k += 1
        end
        i += 1
    end
    return out
end

;; Hash dowolnego bufora bajtów -> 32 bajty.
pub fn hash(data: [int]) -> [int] is
    let n: int = data.len()
    if n <= 1024 is
        return root_bytes(chunk_out(data, 0, n, 0))
    end
    let nchunks: int = (n + 1023) / 1024
    ;; stos CV-ów (lewe poddrzewa) z jawnym wskaźnikiem `sp` — `.pop()` na
    ;; tablicach nie ma kodowania w backendzie LLVM H# 0.9, więc nie używamy.
    let mut stack: [[int]] = []
    let mut sp: int = 0
    let mut ci: int = 0
    while ci < nchunks - 1 is
        let o: Out = chunk_out(data, ci * 1024, 1024, ci)
        let mut cv: [int] = out_cv(o)
        let mut total: int = ci + 1
        while (total & 1) == 0 is
            sp -= 1
            let left: [int] = stack[sp]
            cv = out_cv(parent_out(left, cv))
            total = total / 2
        end
        let slen: int = stack.len()
        if sp < slen is
            stack[sp] = cv
        else is
            stack.push(cv)
        end
        sp += 1
        ci += 1
    end
    let lastoff: int = (nchunks - 1) * 1024
    let mut cur: Out = chunk_out(data, lastoff, n - lastoff, nchunks - 1)
    let mut rem: int = sp
    while rem > 0 is
        rem -= 1
        cur = parent_out(stack[rem], out_cv(cur))
    end
    return root_bytes(cur)
end
