;; Wbudowane testy (`legendaryos-builder selftest`). Sprawdzają czyste
;; funkcje -- bez sieci, live-build ani roota. Kod wyjścia != 0 = porażka.

struct Counter is
    pass: int
    fail: int
end

fn check(c: Counter, name: string, cond: bool) -> Counter is
    if cond is
        return Counter { pass: c.pass + 1, fail: c.fail }
    end
    ui::fail("FAIL: " + name)
    return Counter { pass: c.pass, fail: c.fail + 1 }
end

fn sample_project(cfg: string) -> project::Project is
    return project::Project {
        root: "/tmp/lo-selftest",
        config: hkconf::parse_text(cfg, "config.hk"),
        user: hkconf::parse_text("[account]\n-> name => org\n", "user.hk"),
    }
end

fn count_msgs(v: project::ValidationResult, code: string) -> int is
    let mut n: int = 0
    let mut i: int = 0
    while i < array_len(v.issues) is
        if v.issues[i].code == code is n += 1 end
        i += 1
    end
    return n
end

fn first_off(v: project::ValidationResult, code: string) -> int is
    let mut i: int = 0
    while i < array_len(v.issues) is
        if v.issues[i].code == code is return v.issues[i].off end
        i += 1
    end
    return -1
end

;; ── Blue Environment, sdm, znaczniki .live*, baza Fedora ──
fn run_blue_fedora(c0: Counter) -> Counter is
    let mut c: Counter = c0
    let o: opts::Options = opts::defaults()
    let cfg_h: string = "[project]\n-> name => LegendaryOS\n-> tag => stable\n-> targets => [pc:amd64, phone:arm64:pinephone]\n[release]\n-> base => hackeros\n[packages]\n-> desktop => blue-environment\n[mobile]\n-> shell => blue-environment\n"
    let ph: project::Project = sample_project(cfg_h)
    let th: [target::Target] = target::resolve_all(ph, o, "amd64")

    ;; pakiety + display manager
    let pk: [string] = packages::package_names(ph, o, th[0])
    c = check(c, "blue pc: pakiet blue-environment", array_contains(pk, "blue-environment"))
    c = check(c, "blue pc: domyślny DM = sdm", array_contains(pk, "sdm") && project::display_manager(ph, o, "pc") == "sdm")
    c = check(c, "blue pc: bez task-xfce", !array_contains(pk, "task-xfce-desktop"))
    c = check(c, "blue pc: Blue Installer zamiast calamares", !array_contains(pk, "calamares") && array_contains(pk, "rsync") && array_contains(pk, "parted"))
    let pkm: [string] = packages::package_names(ph, o, th[1])
    c = check(c, "blue phone: pakiet telefoniczny", array_contains(pkm, version::blue_phone_package()))
    c = check(c, "blue phone: DM = sdm", array_contains(pkm, "sdm") && !array_contains(pkm, "phosh"))
    let px: project::Project = sample_project("[project]\n-> name => X\n[packages]\n-> desktop => xfce\n")
    c = check(c, "xfce: brak domyślnego DM", project::display_manager(px, o, "pc") == "")
    let pn: project::Project = sample_project("[project]\n-> name => X\n[packages]\n-> desktop => blue-environment\n-> display-manager => none\n")
    c = check(c, "display-manager none", project::display_manager(pn, o, "pc") == "")
    let pg: project::Project = sample_project("[project]\n-> name => X\n[packages]\n-> desktop => blue-environment\n-> display-manager => gdm\n")
    c = check(c, "display-manager jawny", project::display_manager(pg, o, "pc") == "gdm")

    ;; znaczniki .live
    let m: [string] = livemarkers::marker_names(ph, o, th[0])
    c = check(c, "live hackeros: .live + .live-legendaryos", array_len(m) == 2 && m[0] == ".live" && m[1] == ".live-legendaryos")
    c = check(c, "live: telefon bez znaczników", array_len(livemarkers::marker_names(ph, o, th[1])) == 0)
    c = check(c, "live: xfce (auto) bez znaczników", array_len(livemarkers::marker_names(px, o, target::make(px, o, "pc", "amd64", "", "amd64"))) == 0)
    let pt: project::Project = sample_project("[project]\n-> name => X\n[packages]\n-> desktop => xfce\n[live]\n-> markers => true\n")
    c = check(c, "live: markers => true wymusza", array_len(livemarkers::marker_names(pt, o, target::make(pt, o, "pc", "amd64", "", "amd64"))) == 2)

    ;; baza Fedora
    let cfg_f: string = "[project]\n-> name => LegendaryOS\n-> tag => stable\n-> version => 1.0\n-> targets => [pc:amd64]\n[release]\n-> base => fedora\n[fedora]\n-> version => 44\n[container]\n-> registry => ghcr.io/legendaryos-linux-system\n-> image => legendaryos\n[system]\n-> timezone => Europe/Warsaw\n-> services-enable => [sshd]\n[packages]\n-> desktop => blue-environment\n-> include => [vim]\n"
    let pf: project::Project = sample_project(cfg_f)
    let tf: [target::Target] = target::resolve_all(pf, o, "amd64")
    c = check(c, "fedora: baza rozpoznana", project::is_fedora(pf, o) && project::build_mode(pf, o) == "bootc")
    let mf: [string] = livemarkers::marker_names(pf, o, tf[0])
    c = check(c, "live fedora: 3 znaczniki", array_len(mf) == 3 && mf[2] == ".live-fedora-legendaryos")
    c = check(c, "fedora: obraz bazowy", fedora::base_image(pf) == "quay.io/fedora-ostree-desktops/silverblue:44")
    c = check(c, "fedora: nazwa obrazu", fedora::image_ref(pf) == "ghcr.io/legendaryos-linux-system/legendaryos:stable")
    let cf: string = fedora::containerfile(pf, o, tf[0])
    c = check(c, "containerfile: FROM", string_find(cf, "FROM quay.io/fedora-ostree-desktops/silverblue:44") >= 0)
    c = check(c, "containerfile: dnf install blue+sdm", string_find(cf, "'blue-environment'") >= 0 && string_find(cf, "'sdm'") >= 0 && string_find(cf, "'vim'") >= 0)
    c = check(c, "containerfile: nakładka", string_find(cf, "COPY includes.chroot_after_packages/ /") >= 0)
    c = check(c, "containerfile: display-manager.service -> sdm", string_find(cf, "/usr/lib/systemd/system/sdm.service") >= 0)
    c = check(c, "containerfile: strefa czasowa + usługa", string_find(cf, "Europe/Warsaw") >= 0 && string_find(cf, "sshd.service") >= 0)
    let ba: [string] = fedora::bib_args(pf, tf[0], "/x/bib-config.toml")
    c = check(c, "bib: anaconda-iso + obraz", array_contains(ba, "anaconda-iso") && array_contains(ba, "ghcr.io/legendaryos-linux-system/legendaryos:stable"))
    c = check(c, "fedora: pakiety rpm", array_contains(packages::rpm_package_names(pf, o), "blue-environment") && array_contains(packages::rpm_package_names(pf, o), "sdm"))
    let osr: string = identity::os_release(pf, o)
    c = check(c, "os-release fedora: ID_LIKE i VERSION_ID", string_find(osr, "ID_LIKE=fedora") >= 0 && string_find(osr, "VERSION_ID=\"44\"") >= 0)
    c = check(c, "os-release hackeros: ID_LIKE=debian", string_find(identity::os_release(ph, o), "ID_LIKE=debian") >= 0)

    ;; nadpisania z flag
    let mut o_f: opts::Options = opts::defaults()
    o_f.base = "fedora"
    o_f.desktop = "blue-environment"
    let pov: project::Project = project::apply_overrides(sample_project("[project]\n-> name => X\n[release]\n-> base => hackeros\n"), o_f)
    c = check(c, "--base nadpisuje config", project::is_fedora(pov, o_f) && hkconf::get(pov.config, "release", "base") == "fedora")
    c = check(c, "--desktop dopisuje klucz", project::desktop(pov, o_f) == "blue-environment")

    ;; walidacja
    let bad1: project::ValidationResult = project::validate(sample_project("[project]\n-> name => X\n-> targets => [phone:arm64:pinephone]\n[release]\n-> base => fedora\n"))
    c = check(c, "walidacja: fedora + telefon", count_msgs(bad1, "config::fedora_phone") == 1)
    let bad2: project::ValidationResult = project::validate(sample_project("[project]\n-> name => X\n[release]\n-> base => hackeros\n[packages]\n-> desktop => cosmic\n"))
    c = check(c, "walidacja: cosmic tylko na fedorze", count_msgs(bad2, "config::desktop_base") == 1)
    let bad3: project::ValidationResult = project::validate(sample_project("[project]\n-> name => X\n[release]\n-> base => fedra\n"))
    c = check(c, "walidacja: literówka bazy", count_msgs(bad3, "config::base") >= 1)
    let bad4: project::ValidationResult = project::validate(sample_project("[project]\n-> name => X\n[packages]\n-> display-manager => sdn\n"))
    c = check(c, "walidacja: zły display-manager", count_msgs(bad4, "config::display-manager") == 1)
    let ok1: project::ValidationResult = project::validate(sample_project(cfg_h))
    c = check(c, "walidacja: blue-environment (pc+phone) bez błędów configu", count_msgs(ok1, "config::desktop") == 0 && count_msgs(ok1, "config::shell") == 0)

    ;; skrypty puste
    sh::write_text("/tmp/lo-selftest-blank.hl", "#!/usr/bin/hl\n/// komentarz\n\n")
    sh::write_text("/tmp/lo-selftest-code.hl", "#!/usr/bin/hl\nusing <gen 2>\n")
    c = check(c, "skrypt pusty = pomijany", scriptrunner::is_blank_script("/tmp/lo-selftest-blank.hl"))
    c = check(c, "skrypt z kodem = uruchamiany", !scriptrunner::is_blank_script("/tmp/lo-selftest-code.hl"))

    ;; completions
    c = check(c, "completions: --base/--desktop", string_find(completions::bash(), "--base") >= 0 && string_find(completions::bash(), "blue-environment") >= 0)
    return c
end

pub fn run() -> int is
    let mut c: Counter = Counter { pass: 0, fail: 0 }
    let o: opts::Options = opts::defaults()

    ;; ── parser .hk ──
    let hk: hkconf::HkFile = hkconf::parse_text("[a]\n-> x => 1 ;; k\n-> u => \"http://h;;p\"\n-> l => [p, \"q r\", s]\n-> m\n--> sub => 5\n[b\nzle\n", "t")
    c = check(c, "hk: wartość", hkconf::get(hk, "a", "x") == "1")
    c = check(c, "hk: ;; w cudzysłowie", hkconf::get(hk, "a", "u") == "http://h;;p")
    c = check(c, "hk: lista", array_len(hkconf::get_list(hk, "a", "l")) == 3)
    c = check(c, "hk: pod-klucz", hkconf::get(hk, "a", "m.sub") == "5")
    c = check(c, "hk: błędy składni", array_len(hk.perr_msg) == 2)
    let loc: [int] = hkconf::locate_value(hk, "a", "x")
    c = check(c, "hk: pozycja wartości", array_len(loc) == 2 && string_slice(hk.text, loc[0], loc[0] + loc[1]) == "1")

    ;; ── tekst ──
    c = check(c, "text: levenshtein", text::distance("kitten", "sitting") == 3)
    c = check(c, "text: suggest", text::suggest("amd46", ["amd64", "arm64"]) == "amd64")
    c = check(c, "text: suggest brak", text::suggest("zzzzzz", ["amd64"]) == "")
    c = check(c, "text: hex", text::parse_hex("#6236B0")[0] == 98)
    c = check(c, "text: frac", text::frac(255) == "1.000" && text::frac(0) == "0.000")

    ;; ── cele: komputer + telefon ──
    c = check(c, "spec pc", array_len(devices::parse_spec("pc:amd64")) == 3)
    c = check(c, "spec phone", devices::parse_spec("phone:arm64:pinephone")[2] == "pinephone")
    c = check(c, "spec zły", array_len(devices::parse_spec("phone:arm64")) == 0)
    c = check(c, "device pinephone", devices::find("pinephone").boot == "u-boot")
    c = check(c, "device nieznane", devices::find("xyz").id == "")
    c = check(c, "msdos dla sunxi", image::needs_msdos(devices::find("pinephone")))
    c = check(c, "gpt dla rockchip", !image::needs_msdos(devices::find("pinephone-pro")))
    c = check(c, "qemu amd64->arm64", target::needs_qemu("amd64", "arm64"))
    c = check(c, "bez qemu natywnie", !target::needs_qemu("arm64", "arm64"))

    let p: project::Project = sample_project("[project]\n-> name => Test\n-> targets => [pc:amd64, pc:arm64, phone:arm64:pinephone]\n-> tag => beta\n[packages]\n-> include => [vim]\n-> exclude => [os-prober]\n")
    let ts: [target::Target] = target::resolve_all(p, o, "amd64")
    c = check(c, "3 cele", array_len(ts) == 3)
    c = check(c, "pc: iso", ts[0].images[0] == "iso" && ts[0].binary_images == "iso-hybrid")
    c = check(c, "pc arm64: qemu z amd64", ts[1].qemu_arch == "arm64" && ts[1].qemu_static == "/usr/bin/qemu-aarch64-static")
    c = check(c, "phone: raw-img + rootfs-tar", array_contains(ts[2].images, "raw-img") && array_contains(ts[2].images, "rootfs-tar"))
    c = check(c, "phone: system normal", ts[2].system == "normal" && ts[2].binary_images == "tar")
    c = check(c, "osobne katalogi robocze", ts[0].work_dir != ts[1].work_dir && ts[1].work_dir != ts[2].work_dir)

    let mut o2: opts::Options = opts::defaults()
    o2.target = "phone"
    c = check(c, "filtr --target phone", array_len(target::resolve_all(p, o2, "amd64")) == 1)
    let mut o3: opts::Options = opts::defaults()
    o3.arch = "arm64"
    c = check(c, "filtr --arch arm64", array_len(target::resolve_all(p, o3, "amd64")) == 2)

    ;; ── pakiety ──
    let pk_pc: [string] = packages::package_names(p, o, ts[0])
    let pk_ph: [string] = packages::package_names(p, o, ts[2])
    c = check(c, "pakiety pc: calamares", array_contains(pk_pc, "calamares"))
    c = check(c, "pakiety pc: include", array_contains(pk_pc, "vim"))
    c = check(c, "pakiety pc: exclude", !array_contains(pk_pc, "os-prober"))
    c = check(c, "pakiety phone: phosh", array_contains(pk_ph, "phosh"))
    c = check(c, "pakiety phone: u-boot", array_contains(pk_ph, "u-boot-sunxi"))
    c = check(c, "pakiety phone: bez calamares", !array_contains(pk_ph, "calamares"))
    c = check(c, "pakiety arm64 pc: grub-efi-arm64", array_contains(packages::package_names(p, o, ts[1]), "grub-efi-arm64-bin"))

    ;; ── lb config ──
    let args_pc: [string] = livebuild::lb_args(p, o, ts[0])
    let args_ph: [string] = livebuild::lb_args(p, o, ts[2])
    let args_arm: [string] = livebuild::lb_args(p, o, ts[1])
    c = check(c, "lb pc: iso-hybrid", array_contains(args_pc, "iso-hybrid") && array_contains(args_pc, "--bootappend-live"))
    c = check(c, "lb phone: tar bez bootloadera", array_contains(args_ph, "tar") && !array_contains(args_ph, "--bootloaders"))
    c = check(c, "lb arm64: qemu", array_contains(args_arm, "--bootstrap-qemu-arch"))
    c = check(c, "lb: out_name", livebuild::out_name(p, o, ts[2]) == "Test-beta-arm64-pinephone")

    ;; ── tożsamość / branding ──
    c = check(c, "os-release ID", string_find(identity::os_release(p, o), "ID=test") >= 0)
    c = check(c, "plymouth kolor", string_find(branding::plymouth_script(p), "SetBackgroundTopColor(0.070") >= 0)
    c = check(c, "extlinux", string_find(image::extlinux_conf(p, devices::find("pinephone"), "6.1-arm64"), "fdtdir /usr/lib/linux-image-6.1-arm64/") >= 0)

    ;; ── walidacja ──
    let bad: project::Project = sample_project("[project]\n-> name => X\n-> targets => [phone:arm64:pinephne, pc:amd46]\n[bulid]\n-> mode => live-build\n")
    let v: project::ValidationResult = project::validate(bad)
    c = check(c, "walidacja: literówka urządzenia", count_msgs(v, "config::device") == 1)
    c = check(c, "walidacja: zła arch", count_msgs(v, "config::targets") == 1)
    c = check(c, "walidacja: nieznana sekcja", count_msgs(v, "config::unknown_section") == 1)
    c = check(c, "walidacja: błąd ma pozycję", first_off(v, "config::device") >= 0)

    ;; ── skrypty i completions ──
    c = check(c, "completions: bash", string_find(completions::bash(), "complete -F") >= 0)
    c = check(c, "completions: urządzenia", string_find(completions::bash(), "pinephone") >= 0)

    c = run_blue_fedora(c)

    ui::blank()
    if c.fail == 0 is
        ui::ok("selftest: " + to_string(c.pass) + " testów OK")
        return 0
    end
    ui::fail("selftest: " + to_string(c.fail) + " z " + to_string(c.pass + c.fail) + " testów NIE przeszło")
    return 1
end
