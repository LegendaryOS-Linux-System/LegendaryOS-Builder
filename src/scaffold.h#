pub fn tpl_example_script(name: string) -> string is
    return "#!/usr/bin/hl\n" +
           "/// 10-prepare.hl -- przykładowy hook przed budową " + name + "\n" +
           "/// Katalogiem roboczym jest korzeń projektu; to, co trafi do files/,\n" +
           "/// zostanie skopiowane 1:1 do obrazu.\n" +
           "using <gen 2>\n" +
           "\n" +
           "~> ==> Przygotowanie files/ dla " + name + "...\n" +
           "> mkdir -p files/etc/skel\n" +
           "? err\n" +
           "    ~> BŁĄD: nie udało się przygotować files/etc/skel\n" +
           "    > exit 1\n" +
           "done\n" +
           "\n" +
           "~> ==> Gotowe.\n"
end

fn base_name(path: string) -> string is
    let mut p: string = path
    while string_len(p) > 1 && string_ends_with(p, "/") is
        p = string_slice(p, 0, string_len(p) - 1)
    end
    let parts: [string] = string_split(p, "/")
    return parts[array_len(parts) - 1]
end

;; `dir` = katalog docelowy (może być ścieżką); nazwa projektu = jego ostatni człon.
pub fn create(dir: string, o: opts::Options) -> bool is
    let name: string = base_name(dir)
    if fs_exists(dir) is
        ui::fail("katalog '" + dir + "' już istnieje")
        return false
    end
    if name == "" || name == "." || name == ".." is
        ui::fail("podaj nazwę projektu (np. MojeOS)")
        return false
    end
    let mut kind: string = o.kind
    if kind == "" is kind = "pc" end
    if kind != "pc" && kind != "phone" && kind != "both" is
        ui::fail("--kind musi być: pc, phone albo both (podano '" + kind + "')")
        return false
    end
    let mut device: string = o.device
    if (kind == "phone" || kind == "both") && device == "" is device = "pinephone" end
    if device != "" && devices::find(device).id == "" is
        ui::fail("nieznane urządzenie '" + device + "' (dostępne: " + str_join(devices::ids(), ", ") + ")")
        return false
    end

    let mut base: string = o.base
    if base == "" is base = "hackeros" end
    if !array_contains(version::known_bases(), base) is
        ui::fail("--base musi być: " + str_join(version::known_bases(), ", ") + " (podano '" + base + "')")
        return false
    end
    if base == "fedora" && kind != "pc" is
        ui::fail("baza fedora buduje tylko komputery (--kind pc); telefony: baza hackeros")
        return false
    end
    let mut desktop: string = o.desktop
    if desktop == "" is desktop = "none" end

    sh::mkdir_p(dir)
    sh::mkdir_p(path_join(dir, "branding"))
    sh::mkdir_p(path_join(dir, "scripts"))
    sh::mkdir_p(path_join(dir, "files"))

    let branding: string = path_join(dir, "branding")
    write_placeholder(path_join(branding, "logo.png"), placeholder_png_b64())
    write_placeholder(path_join(branding, "logo-bg.png"), placeholder_png_b64())
    write_placeholder(path_join(branding, "notext-bg.png"), placeholder_png_b64())
    write_placeholder(path_join(branding, "banner.png"), placeholder_png_b64())
    write_placeholder(path_join(branding, "logo-bg.jpg"), placeholder_jpg_b64())

    fs_write(path_join(dir, "scripts/10-prepare.hl"), tpl_example_script(name))
    fs_write(path_join(dir, "files/.gitkeep"), "")
    fs_write(path_join(dir, "build.hl"), tpl_build_hl(name))
    fs_write(path_join(dir, "config.hk"), tpl_config_hk(name, kind, device, base, desktop))
    fs_write(path_join(dir, "user.hk"), tpl_user_hk(name))
    fs_write(path_join(dir, ".gitignore"), "user.hk\nbuild/\n")

    ui::ok("utworzono projekt '" + name + "' w " + dir + " (cele: " + targets_for(kind, device) + ")")
    ui::blank()
    ui::plain("  Dalej:")
    ui::plain("    1. Podmień pliki w " + dir + "/branding/ na docelową grafikę")
    ui::plain("    2. Uzupełnij " + dir + "/user.hk (organizacja + token)")
    ui::plain("    3. legendaryos-builder validate " + dir)
    ui::plain("    4. legendaryos-builder doctor " + dir)
    ui::plain("    5. sudo legendaryos-builder build " + dir)
    return true
end
