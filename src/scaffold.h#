;; `legendaryos-builder new <nazwa> [--kind pc|phone|both] [--device ID]`

pub fn placeholder_png_b64() -> string is
    return "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR4nGNIMtvwHwAEjgJIbDiblwAAAABJRU5ErkJggg=="
end

;; 1x1 px, kolor #120C1E (tło LegendaryOS) jako JPEG -- dla logo-bg.jpg.
pub fn placeholder_jpg_b64() -> string is
    return ""
end

fn write_placeholder(path_out: string, b64_data: string) is
    ;; backend LLVM (--release) nie wspiera base64::decode_bytes -> systemowe base64
    sh::run("printf '%s' " + sh::sq(b64_data) + " | base64 -d > " + sh::sq(path_out))
end

;; Lista celów dla szablonu config.hk.
pub fn targets_for(kind: string, device: string) -> string is
    if kind == "phone" is return "[phone:arm64:" + device + "]" end
    if kind == "both" is return "[pc:amd64, pc:arm64, phone:arm64:" + device + "]" end
    return "[pc:amd64]"
end

pub fn tpl_config_hk(name: string, kind: string, device: string, base: string, desktop: string) -> string is
    let mut o: string = ";; config.hk -- metadane projektu i wydania " + name + "\n\n"
    o = o + "[project]\n"
    o = o + "-> name    => " + name + "\n"
    o = o + "-> tag     => stable\n"
    o = o + "-> version => 1.0\n"
    o = o + ";; cele budowy: pc:<arch> (ISO) albo phone:<arch>:<urządzenie> (obraz telefonu)\n"
    o = o + ";; urządzenia: legendaryos-builder devices\n"
    o = o + "-> targets => " + targets_for(kind, device) + "\n\n"
    o = o + "[release]\n"
    o = o + ";; hackeros = klasyczny LegendaryOS (Debian testing, live-build)\n"
    o = o + ";; fedora   = LegendaryOS na Fedora Silverblue (atomowa; bootc + bootc-image-builder)\n"
    o = o + "-> base     => " + base + "\n"
    if base == "fedora" is
        o = o + "\n[fedora]\n"
        o = o + "-> version    => " + version::fedora_default_version() + "\n"
        o = o + ";; -> image   => " + version::fedora_default_image() + "\n"
        o = o + ";; -> repos   => [https://example.org/blue-environment.repo]\n"
        o = o + ";; -> copr    => [owner/projekt]\n"
        o = o + "-> filesystem => ext4\n\n"
        o = o + "[container]\n"
        o = o + "-> registry => ghcr.io/legendaryos-linux-system\n"
        o = o + "-> image    => " + text::slug(name) + "\n"
        o = o + "-> push     => false\n\n"
    else is
        o = o + "-> base-ref => official\n"
        o = o + "-> suite    => trixie\n\n"
    end
    o = o + "[branding]\n"
    o = o + "-> distro-name => " + name + "\n"
    o = o + "-> theme       => legendary-gold\n"
    o = o + "-> accent      => #6236B0\n"
    o = o + "-> background  => #120C1E\n\n"
    o = o + "[build]\n"
    o = o + "-> mode     => " + (if base == "fedora" then "bootc" else "live-build") + "\n"
    o = o + "-> iso-name => " + name + "\n\n"
    o = o + "[packages]\n"
    o = o + ";; none | xfce | gnome | kde | cosmic (tylko fedora) | blue-environment  (tylko komputery)\n"
    o = o + "-> desktop => " + desktop + "\n"
    o = o + ";; display manager: auto (blue-environment => sdm) | none | sdm | gdm | sddm | lightdm\n"
    o = o + ";; -> display-manager => auto\n"
    o = o + ";; -> include => [vim, htop]\n"
    o = o + ";; -> exclude => [os-prober]\n\n"
    o = o + "[base]\n"
    o = o + ";; co importować z bazy HackerOS: package-lists, hooks, includes\n"
    o = o + "-> import => [package-lists]\n"
    o = o + "\n[live]\n"
    o = o + ";; znaczniki .live / .live-legendaryos / .live-fedora-legendaryos (instalator Blue Environment)\n"
    o = o + ";; auto = tylko gdy desktop => blue-environment\n"
    o = o + "-> markers => auto\n"
    if kind == "phone" || kind == "both" is
        o = o + "\n[mobile]\n"
        o = o + ";; phosh | blue-environment | none\n"
        o = o + "-> shell => " + (if desktop == "blue-environment" then "blue-environment" else "phosh") + "\n"
        o = o + ";; -> rootfs-size => 4096   ;; MiB; domyślnie liczone automatycznie\n"
        o = o + ";; -> cmdline     => quiet\n"
    end
    return o
end

pub fn tpl_user_hk(name: string) -> string is
    return "[account]\n-> type => organisation\n-> name => " + name + "\n\n[auth]\n;; token może też przyjść z env LEGENDARYOS_TOKEN (CI)\n-> token =>\n"
end

