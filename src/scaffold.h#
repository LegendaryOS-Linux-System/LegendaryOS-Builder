use "std -> fs" from "fs"
mod text
mod sys
mod ui
mod proj

;; `legendaryos-builder new <katalog>`: kopiuje szablon dystrybucji (templates/distro) i uzupełnia
;; brakujący branding minimalnymi obrazkami zastępczymi (PNG/JPEG 2x2) — podmień je na docelową grafikę.

fn png_b64() -> string is return "iVBORw0KGgoAAAANSUhEUgAAAAIAAAACCAIAAAD91JpzAAAAFklEQVR42mMU0YhiYGBgYmBgYGBgAAAG7ACafrr/8wAAAABJRU5ErkJggg==" end
fn jpg_b64() -> string is return "" end

pub fn find_templates() -> string is
    let cands: [string] = [sys::getenv_or("LEGENDARY_BUILDER_TEMPLATES", ""), "templates/distro",
        "/usr/share/legendaryos-builder/templates/distro", "/system/share/legendaryos-builder/templates/distro"]
    let mut i: int = 0
    while i < cands.len() is
        if cands[i] != "" && fs::is_dir(cands[i]) is return cands[i] end
        i += 1
    end
    return ""
end

pub fn create(dir: string) -> string is
    if fs::exists(dir) is return "'" + dir + "' już istnieje" end
    let t: string = find_templates()
    if t == "" is return "nie znaleziono szablonu (templates/distro); ustaw LEGENDARY_BUILDER_TEMPLATES" end
    sys::mkdir_p(dir)
    if !sys::ok("cp -a " + sys::sq(t) + "/. " + sys::sq(dir) + "/") is return "kopiowanie szablonu nie powiodło się" end
    let br: string = text::path_join(dir, "branding")
    sys::mkdir_p(br)
    let need: [string] = proj::required_branding()
    let mut i: int = 0
    while i < need.len() is
        let f: string = text::path_join(br, need[i])
        if !fs::exists(f) is
            let b64: string = png_b64()
            if text::ends_with(need[i], ".jpg") is
                if !sys::ok("printf %s " + sys::sq(jpg_b64()) + " | base64 -d > " + sys::sq(f)) is return "nie można utworzyć " + f end
            else is
                if !sys::ok("printf %s " + sys::sq(b64) + " | base64 -d > " + sys::sq(f)) is return "nie można utworzyć " + f end
            end
        end
        i += 1
    end
    return ""
end
