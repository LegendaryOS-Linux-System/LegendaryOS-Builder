mod sh
mod ui
mod opts

;; Uruchamianie scripts/*.hl (Hacker Lang) w kolejności alfabetycznej.
;; Skrypty działają z korzeniem PROJEKTU jako katalogiem roboczym (więc
;; `files/etc/...` w skrypcie to files/ projektu) i dostają zmienne
;; LEGENDARYOS_ROOT / LEGENDARYOS_BUILD. Sukces = kod wyjścia `hl` == 0.

pub struct ScriptResult is
    pub name:    string
    pub ok:      bool
    pub seconds: int
end

;; Nazwy *.hl posortowane alfabetycznie (ls -1 sortuje wg locale C).
pub fn list_scripts(scripts_dir: string) -> [string] is
    let raw: string = sh::capture("LC_ALL=C ls -1 " + sh::sq(scripts_dir) + " 2>/dev/null")
    let mut out: [string] = []
    if raw == "" is return out end
    let parts: [string] = string_split(raw, "\n")
    let mut i: int = 0
    while i < array_len(parts) is
        let nm: string = string_trim(parts[i])
        if nm != "" && !string_starts_with(nm, ".") && string_ends_with(nm, ".hl") is out.push(nm) end
        i += 1
    end
    return out
end

;; Skrypt bez żadnej treści wykonywalnej (puste linie, komentarze `///`, `//`, `;;`, `#`)
;; nie wymaga interpretera -- pozwala budować w CI bez `hl`, gdy skrypty są jeszcze puste.
pub fn is_blank_script(path: string) -> bool is
    let lines: [string] = string_split(fs_read(path), "\n")
    let mut i: int = 0
    while i < array_len(lines) is
        let l: string = string_trim(lines[i])
        if l != "" && !string_starts_with(l, "#") && !string_starts_with(l, "//") && !string_starts_with(l, ";;") is
            return false
        end
        i += 1
    end
    return true
end

fn count_runnable(scripts_dir: string, names: [string]) -> int is
    let mut n: int = 0
    let mut i: int = 0
    while i < array_len(names) is
        if !is_blank_script(path_join(scripts_dir, names[i])) is n += 1 end
        i += 1
    end
    return n
end

pub fn run_all(root: string, o: opts::Options) -> [ScriptResult] is
    let mut results: [ScriptResult] = []
    let names: [string] = list_scripts(path_join(root, "scripts"))
    if array_len(names) == 0 is
        ui::muted("scripts/: brak skryptów .hl -- pomijam")
        return results
    end
    let sdir: string = path_join(root, "scripts")
    if count_runnable(sdir, names) == 0 is
        ui::muted("scripts/: wszystkie skrypty .hl są puste -- pomijam")
        return results
    end
    if !sh::tool_exists("hl") && !o.dry_run is
        ui::fail("nie znaleziono `hl` (interpreter Hacker Lang) w PATH -- zainstaluj HackerOS/Hacker Lang")
        results.push(ScriptResult { name: "(interpreter)", ok: false, seconds: 0 })
        return results
    end
    env_set("LEGENDARYOS_ROOT", root)
    env_set("LEGENDARYOS_BUILD", path_join(root, "build"))

    let mut i: int = 0
    while i < array_len(names) is
        ui::step(i + 1, array_len(names), "scripts/" + names[i])
        let t0: int = sh::now()
        let mut rc: int = 0
        if is_blank_script(path_join(sdir, names[i])) is
            ui::muted("scripts/" + names[i] + ": pusty -- pomijam")
        else is
            if o.dry_run is
                ui::muted("[dry-run] hl scripts/" + names[i])
            else is
                rc = sh::in_dir(root, "hl " + sh::sq("scripts/" + names[i]))
            end
        end
        let secs: int = sh::now() - t0
        results.push(ScriptResult { name: names[i], ok: rc == 0, seconds: secs })
        if rc != 0 is
            ui::fail("scripts/" + names[i] + " zakończył się błędem (kod " + to_string(rc) + ")")
            if !o.keep_going is return results end
        end
        i += 1
    end
    return results
end

pub fn all_ok(results: [ScriptResult]) -> bool is
    let mut i: int = 0
    while i < array_len(results) is
        if !results[i].ok is return false end
        i += 1
    end
    return true
end
