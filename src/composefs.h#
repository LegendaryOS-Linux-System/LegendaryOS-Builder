;; Montowalne, weryfikowalne obrazy composefs + dm-verity.
;; Narzędzia zewnętrzne: mkcomposefs, mount.composefs, composefs-info,
;; veritysetup, losetup.

pub struct CfsResult is
    pub ok:     bool
    pub error:  string
    pub value:  string
end

fn cok(v: string) -> CfsResult is return CfsResult { ok: true, error: "", value: v } end
fn cerr(m: string) -> CfsResult is return CfsResult { ok: false, error: m, value: "" } end

fn banner_for(name: string) -> string is
    if name == "mkcomposefs" is return "Usage: mkcomposefs" end
    if name == "mount.composefs" is return "usage: mount.composefs" end
    if name == "composefs-info" is return "usage: composefs-info" end
    return ""
end

;; Samo `which` nie wystarcza — plik o tej nazwie może być atrapą. Uruchamiamy
;; narzędzie bez argumentów i szukamy charakterystycznego bannera (żadne z nich
;; nie ma `--version`). Zwraca "" gdy OK, w przeciwnym razie komunikat błędu.
pub fn require_tool(name: string) -> string is
    if !sys::have_tool(name) is
        return "Brak narzędzia '" + name + "' w PATH. Zainstaluj pakiet composefs (https://github.com/composefs/composefs — apt zwykle go nie ma, trzeba zbudować ze źródeł: meson setup build -Dfuse=disabled && ninja -C build)."
    end
    let r: sys::Exec = sys::exec(name)
    let banner: string = banner_for(name)
    if banner != "" && !text::contains(r.out, banner) is
        return "'" + name + "' w PATH nie wygląda jak composefs (brak spodziewanego komunikatu '" + banner + "' w wyjściu) — sprawdź, czy PATH nie wskazuje na inne narzędzie o tej samej nazwie."
    end
    return ""
end

;; Wariant bez bannera (veritysetup, losetup).
pub fn require_tool2(name: string) -> string is
    if !sys::have_tool(name) is return "Brak narzędzia '" + name + "' w PATH." end
    return ""
end

;; Odtwarza drzewo plików manifestu z chunków store'a do `materialized_dir`
;; (katalogi, symlinki, pliki składane z chunków przez `cat`, bity wykonania).
pub fn materialize_tree(m: manifest::Manifest, s: store::Store, materialized_dir: string) -> CfsResult is
    fs::mkdir(materialized_dir)
    ;; Walidacja WSZYSTKICH chunków przed jakimkolwiek zapisem.
    let n: int = m.entries.len()
    let mut i: int = 0
    while i < n is
        let e: manifest::FileEntry = m.entries[i]
        i += 1
        for h in e.chunks is
            if !store::has(s, h) is return cerr("brakujący chunk w store: " + h) end
        end
    end
    let mut exec_paths: [string] = []
    let mut k: int = 0
    while k < n is
        let e2: manifest::FileEntry = m.entries[k]
        k += 1
        let full: string = text::path_join(materialized_dir, e2.path)
        let mode: string = e2.mode
        if mode == "directory" is
            fs::mkdir(full)
        else if mode == "symlink" is
            fs::mkdir(text::dirname(full))
            if sys::exists_any(full) is sys::rm_f(full) end
            if !sys::symlink(e2.link_target, full) is return cerr("symlink '" + full + "' nie powiódł się") end
        else is
            fs::mkdir(text::dirname(full))
            let mut parts: [string] = []
            for h2 in e2.chunks is
                parts.push(store::object_path(s, h2))
            end
            if !ioengine::concat_files(parts, full) is return cerr("składanie pliku '" + full + "' nie powiodło się") end
            if mode == "executable" is exec_paths.push(full) end
        end
    end
    let xn: int = exec_paths.len()
    let mut x: int = 0
    while x < xn is
        let r: sys::Exec = sys::exec("chmod a+x " + sys::sq(exec_paths[x]))
        if r.code != 0 is return cerr("chmod nie powiodło się: " + r.out) end
        x += 1
    end
    return cok("")
end

;; Materializuje pliki z chunków store'a do `materialized_dir` i woła
;; `mkcomposefs --print-digest`. Zwraca digest obrazu (hex, 64 znaki).
pub fn build_image(m: manifest::Manifest, s: store::Store, materialized_dir: string, output_image: string) -> CfsResult is
    let te: string = require_tool("mkcomposefs")
    if te != "" is return cerr(te) end
    let mt: CfsResult = materialize_tree(m, s, materialized_dir)
    if !mt.ok is return mt end
    let r2: sys::Exec = sys::exec("mkcomposefs --print-digest " + sys::sq(materialized_dir) + " " + sys::sq(output_image))
    if r2.code != 0 is return cerr("mkcomposefs nie powiodło się: " + r2.out) end
    let digest: string = text::trim(r2.out)
    let dl: int = digest.len()
    if dl != 64 is
        return cerr("mkcomposefs --print-digest zwrócił nieoczekiwany format (" + text::istr(dl) + " znaków zamiast 64): " + digest)
    end
    return cok(digest)
end

;; `mount.composefs` wymaga składniowo `-o basedir=...` nawet dla obrazów
;; w pełni inline; domyślnie używamy katalogu obrazu.
pub fn mount_image(image: string, mountpoint: string, basedir: string) -> CfsResult is
    let te: string = require_tool("mount.composefs")
    if te != "" is return cerr(te) end
    fs::mkdir(mountpoint)
    let mut bd: string = basedir
    if bd == "" is bd = text::dirname(image) end
    let r: sys::Exec = sys::exec("mount.composefs -o basedir=" + sys::sq(bd) + ",ro " + sys::sq(image) + " " + sys::sq(mountpoint))
    if r.code != 0 is return cerr("montowanie composefs nie powiodło się: " + r.out) end
    return cok("")
end

;; Best-effort wykrycie CONFIG_FS_VERITY (czyta /boot/config-$(uname -r)).
pub fn fs_verity_kernel_support() -> bool is
    let u: sys::Exec = sys::exec("uname -r")
    if u.code != 0 is return false end
    let cfg: string = "/boot/config-" + text::trim(u.out)
    if !fs::exists(cfg) is return false end
    let lines: [string] = text::lines(fs::read(cfg))
    for l in lines is
        if text::trim(l) == "CONFIG_FS_VERITY=y" is return true end
    end
    return false
end

pub fn device_mapper_available() -> bool is
    return fs::exists("/dev/mapper/control")
end

;; Montowanie z `-o digest=X`: jądro odmówi, gdy digest obrazu się nie zgadza.
;; WYMAGA fs-verity na pliku obrazu (host z cechą `verity` + `fsverity enable`).
pub fn mount_verified(image: string, mountpoint: string, expected_digest: string, basedir: string) -> CfsResult is
    let te: string = require_tool("mount.composefs")
    if te != "" is return cerr(te) end
    if !fs_verity_kernel_support() is
        return cerr("fs-verity niedostępny w tym jądrze (brak CONFIG_FS_VERITY albo /boot/config-$(uname -r) nieczytelny — częste w kontenerach). Użyj zamiast tego dm_verity_format/dm_verity_open (dm-verity na poziomie device-mapper).")
    end
    fs::mkdir(mountpoint)
    let mut bd: string = basedir
    if bd == "" is bd = text::dirname(image) end
    let r: sys::Exec = sys::exec("mount.composefs -o basedir=" + sys::sq(bd) + ",digest=" + expected_digest + ",ro " + sys::sq(image) + " " + sys::sq(mountpoint))
    if r.code != 0 is
        return cerr("montowanie z weryfikacją digestu nie powiodło się (być może host nie ma włączonego fs-verity na tym systemie plików): " + r.out)
    end
    return cok("")
end

;; ── dm-verity ────────────────────────────────────────────────────────────────

pub struct DmVerityInfo is
    pub ok:             bool
    pub error:          string
    pub root_hash:      string
    pub hash_tree_path: string
end

;; Liczy hash-tree dla `data_path` do `<data_path>.verity-hashtree`.
pub fn dm_verity_format(data_path: string) -> DmVerityInfo is
    let te: string = require_tool2("veritysetup")
    if te != "" is return DmVerityInfo { ok: false, error: te, root_hash: "", hash_tree_path: "" } end
    let tree: string = data_path + ".verity-hashtree"
    if fs::exists(tree) is sys::rm_f(tree) end
    let r: sys::Exec = sys::exec("veritysetup format " + sys::sq(data_path) + " " + sys::sq(tree))
    if r.code != 0 is
        return DmVerityInfo { ok: false, error: "veritysetup format nie powiodło się: " + r.out, root_hash: "", hash_tree_path: "" }
    end
    let lines: [string] = text::lines(r.out)
    let mut root: string = ""
    for l in lines is
        if text::starts_with(l, "Root hash:") is
            let parts: [string] = text::split_once(l, ":")
            let pn: int = parts.len()
            if pn == 2 is root = text::trim(parts[1]) end
        end
    end
    let rl: int = root.len()
    if rl != 64 is
        return DmVerityInfo { ok: false, error: "nie udało się sparsować 'Root hash:' z wyjścia veritysetup format:\n" + r.out, root_hash: "", hash_tree_path: "" }
    end
    return DmVerityInfo { ok: true, error: "", root_hash: root, hash_tree_path: tree }
end

;; Weryfikacja BEZ device-mapper (plikowe porównanie hash-tree).
pub fn dm_verity_verify(data_path: string, hash_tree_path: string, root_hash: string) -> bool is
    let te: string = require_tool2("veritysetup")
    if te != "" is return false end
    return sys::ok("veritysetup verify " + sys::sq(data_path) + " " + sys::sq(hash_tree_path) + " " + sys::sq(root_hash))
end

;; Tworzy /dev/mapper/<mapper_name> zweryfikowany kernelowo blok-po-bloku.
pub fn dm_verity_open(data_path: string, hash_tree_path: string, root_hash: string, mapper_name: string) -> CfsResult is
    let t1: string = require_tool2("veritysetup")
    if t1 != "" is return cerr(t1) end
    let t2: string = require_tool2("losetup")
    if t2 != "" is return cerr(t2) end
    if !device_mapper_available() is
        return cerr("device-mapper niedostępny w tym środowisku (brak /dev/mapper/control — moduł jądra dm_mod niezaładowany albo /dev/mapper niedostępny, np. w kontenerach/sandboksach). Użyj dm_verity_verify jako alternatywy bez device-mapper.")
    end
    let d: sys::Exec = sys::exec("losetup -f --show " + sys::sq(data_path))
    if d.code != 0 is return cerr("losetup (dane) nie powiodło się: " + d.out) end
    let data_loop: string = text::trim(d.out)
    let h: sys::Exec = sys::exec("losetup -f --show " + sys::sq(hash_tree_path))
    if h.code != 0 is
        let c1: sys::Exec = sys::exec("losetup -d " + sys::sq(data_loop))
        return cerr("losetup (hash-tree) nie powiodło się: " + h.out)
    end
    let hash_loop: string = text::trim(h.out)
    let o: sys::Exec = sys::exec("veritysetup open " + sys::sq(data_loop) + " " + sys::sq(mapper_name) + " " + sys::sq(hash_loop) + " " + sys::sq(root_hash))
    if o.code != 0 is
        let c2: sys::Exec = sys::exec("losetup -d " + sys::sq(data_loop))
        let c3: sys::Exec = sys::exec("losetup -d " + sys::sq(hash_loop))
        return cerr("veritysetup open nie powiodło się (być może brak device-mapper w tym środowisku): " + o.out)
    end
    return cok("/dev/mapper/" + mapper_name)
end

pub fn dm_verity_close(mapper_name: string) is
    let r: sys::Exec = sys::exec("veritysetup close " + sys::sq(mapper_name))
end
