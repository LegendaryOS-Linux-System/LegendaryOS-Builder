pub struct Device is
    pub id:        string
    pub name:      string
    pub arch:      string
    pub boot:      string
    pub blobs:     [string]
    pub packages:  [string]   ;; dodatkowe pakiety dla tego urządzenia
    pub console:   string     ;; np. "ttyS0,115200" (pusty = brak)
    pub cmdline:   string     ;; dodatkowe parametry jądra
    pub pagesize:  int        ;; tylko android
    pub header:    int        ;; tylko android (mkbootimg --header_version)
    pub notes:     string
end

pub fn none() -> Device is
    return Device { id: "", name: "", arch: "", boot: "", blobs: [], packages: [],
                    console: "", cmdline: "", pagesize: 0, header: 0, notes: "" }
end

