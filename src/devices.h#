pub fn ids() -> [string] is
    let list: [Device] = all()
    let mut out: [string] = []
    let mut i: int = 0
    while i < array_len(list) is
        out.push(list[i].id)
        i += 1
    end
    return out
end

;; Znajdź profil po id; nieznany -> none() (id == "").
pub fn find(id: string) -> Device is
    let list: [Device] = all()
    let mut i: int = 0
    while i < array_len(list) is
        if list[i].id == id is return list[i] end
        i += 1
    end
    return none()
end

;; "pc:amd64" | "pc:arm64" | "phone:arm64:pinephone"  ->  [kind, arch, device]
;; albo [] gdy zapis jest niepoprawny.
pub fn parse_spec(spec: string) -> [string] is
    let parts: [string] = string_split(string_trim(spec), ":")
    let n: int = array_len(parts)
    if n < 2 || n > 3 is return [] end
    let kind: string = string_trim(parts[0])
    let arch: string = string_trim(parts[1])
    if kind != "pc" && kind != "phone" is return [] end
    if arch == "" is return [] end
    if kind == "phone" && n != 3 is return [] end
    if kind == "pc" && n != 2 is return [] end
    if n == 3 is return [kind, arch, string_trim(parts[2])] end
    return [kind, arch, ""]
end
