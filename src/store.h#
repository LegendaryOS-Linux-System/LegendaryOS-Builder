mod text
mod hashing
mod sys
use "std -> fs" from "fs"

;; Lokalny CAS (content-addressable storage), layout zamrożony od v1:
;;   <root>/FORMAT                       — wersja layoutu (ASCII)
;;   <root>/objects/<hex[0:2]>/<hex[2:]> — jeden plik = jeden obiekt (surowe
;;                                         bajty chunku, bez nagłówka)
;; Layout jest zamrożony: store utworzony przez dowolną wersję 0.x jest w pełni
;; czytelny dla każdej innej.

pub fn format_version() -> int is return 1 end

pub struct Store is
    pub root:           string
    pub format_version: int
end

pub struct OpenResult is
    pub ok:    bool
    pub error: string
    pub store: Store
end

fn none_store() -> Store is
    return Store { root: "", format_version: 0 }
end

;; Otwiera (lub tworzy) store pod `root`; odrzuca nowszy lub nieznany FORMAT.
pub fn open(root: string) -> OpenResult is
    fs::mkdir(text::path_join(root, "objects"))
    let ff: string = text::path_join(root, "FORMAT")
    let cur: int = format_version()
    if fs::exists(ff) is
        let existing: string = text::trim(fs::read(ff))
        let version: int = text::parse_int(existing, -1)
        if version > cur is
            return OpenResult { ok: false, store: none_store(),
                error: "Store pod '" + root + "' ma FORMAT=" + existing + ", ta wersja FastTree obsługuje do " + text::istr(cur) + ". Zaktualizuj fasttree." }
        end
        if version < 1 is
            return OpenResult { ok: false, store: none_store(),
                error: "Store pod '" + root + "' ma nierozpoznany plik FORMAT ('" + existing + "')." }
        end
        return OpenResult { ok: true, error: "", store: Store { root: root, format_version: version } }
    end
    let w: bool = fs::write(ff, text::istr(cur))
    if !w is
        return OpenResult { ok: false, store: none_store(), error: "nie można zapisać " + ff }
    end
    return OpenResult { ok: true, error: "", store: Store { root: root, format_version: cur } }
end

;; Fizyczna ścieżka obiektu (hash musi być poprawnym 64-znakowym hexem).
pub fn object_path(s: Store, hex: string) -> string is
    let root: string = s.root
    let n: int = hex.len()
    return text::path_join(text::path_join(text::path_join(root, "objects"), hex[0..2]), hex[2..n])
end

pub fn has(s: Store, hex: string) -> bool is
    if !hashing::is_valid_hash(hex) is return false end
    return fs::exists(object_path(s, hex))
end

pub struct PutResult is
    pub ok:    bool
    pub hash:  string
    pub error: string
end

;; Zapis idempotentny: istniejący obiekt (dedup) nie jest nadpisywany.
pub fn put(s: Store, data: [int]) -> PutResult is
    let h: string = hashing::hash_bytes(data)
    let path: string = object_path(s, h)
    if !fs::exists(path) is
        fs::mkdir(text::dirname(path))
        let tmp: string = path + ".tmp." + text::istr(sys::pid())
        let b: bytes = data
        fs::write_bytes(tmp, b)
        let n: int = data.len()
        let sz: int = fs::size(tmp)
        if sz != n is
            sys::rm_f(tmp)
            return PutResult { ok: false, hash: "", error: "zapis obiektu nie powiódł się: " + tmp }
        end
        fs::rename(tmp, path)
    end
    return PutResult { ok: true, hash: h, error: "" }
end

pub struct GetResult is
    pub ok:    bool
    pub found: bool
    pub data:  [int]
    pub error: string
end

pub fn bytes_to_ints(b: bytes) -> [int] is
    let n: int = b.len()
    let mut out: [int] = []
    let mut i: int = 0
    while i < n is
        out.push(b[i] & 255)
        i += 1
    end
    return out
end

pub fn get(s: Store, hex: string) -> GetResult is
    if !hashing::is_valid_hash(hex) is
        return GetResult { ok: false, found: false, data: [], error: "niepoprawny hash: '" + hex + "'" }
    end
    let path: string = object_path(s, hex)
    if !fs::exists(path) is
        return GetResult { ok: true, found: false, data: [], error: "" }
    end
    let b: bytes = fs::read_bytes(path)
    return GetResult { ok: true, found: true, data: bytes_to_ints(b), error: "" }
end

;; Hashe, których store jeszcze nie ma lokalnie.
pub fn missing(s: Store, hashes: [string]) -> [string] is
    let mut out: [string] = []
    for h in hashes is
        if !has(s, h) is out.push(h) end
    end
    return out
end

;; Wszystkie obiekty w CAS (wejście dla GC). Pomija pliki *.tmp.*.
pub fn list_all(s: Store) -> [string] is
    let mut out: [string] = []
    let dir: string = text::path_join(s.root, "objects")
    if !fs::is_dir(dir) is return out end
    let shards: [string] = fs::list_dir(dir)
    let ns: int = shards.len()
    let mut si: int = 0
    while si < ns is
        ;; elementy z `for x in [string]` nie mają znanego typu dla `.len()`
        ;; (H# 0.9 liczy wtedy śmieci) — stąd indeksowanie do typowanej zmiennej.
        let shard: string = shards[si]
        let sl: int = shard.len()
        si += 1
        if sl != 2 is continue end
        let sd: string = text::path_join(dir, shard)
        if !fs::is_dir(sd) is continue end
        let files: [string] = fs::list_dir(sd)
        let nf: int = files.len()
        let mut fi: int = 0
        while fi < nf is
            let f: string = files[fi]
            fi += 1
            let fl: int = f.len()
            if fl == 62 && !text::contains(f, ".") is
                let hx: string = shard + f
                if hashing::is_valid_hash(hx) is out.push(hx) end
            end
        end
    end
    return out
end

;; Usuwa obiekt; false, jeśli go nie było (idempotentne).
pub fn delete_object(s: Store, hex: string) -> bool is
    if !hashing::is_valid_hash(hex) is return false end
    let path: string = object_path(s, hex)
    if fs::exists(path) is
        fs::remove(path)
        return true
    end
    return false
end

;; Rozmiar obiektu w bajtach (0, gdy brak).
pub fn object_size(s: Store, hex: string) -> int is
    if !has(s, hex) is return 0 end
    return fs::size(object_path(s, hex))
end
