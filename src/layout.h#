mod text
mod sys
use "std -> fs" from "fs"

;; ── Układ plików LegendaryOS ─────────────────────────────────────────────────
;;
;; Zamiast uniksowego /usr /var /etc /opt LegendaryOS ma pięć korzeni:
;;
;;   /system    niezmienny obraz systemu (composefs/EROFS z FastTree). To, co w
;;              Fedorze jest w /usr (bin, lib, lib64, libexec, share, sbin...).
;;   /state     jedyne trwałe, zapisywalne miejsce systemu: konfiguracja (etc),
;;              dane zmienne (var), repo FastTree, baza lpm, wdrożenia, overlaye.
;;   /packages  magazyn pakietów w stylu nix: store/<hash>-<nazwa>-<wersja>,
;;              profile (generacje) przełączane atomowo.
;;   /tools     narzędzia HackerOS / Zenit Linux: git -> squashfs, montowane
;;              tylko do odczytu (nic nie jest rozpakowywane przy uruchomieniu).
;;   /home      dane użytkowników — jedyny katalog zapisywalny przez użytkownika.
;;   /manifest.toml  opis aktywnego wdrożenia (patrz lmanifest.h#).
;;
;; Kompatybilność: stare ścieżki (/usr, /bin, /lib, /etc, /var ...) są
;; symlinkami do nowych korzeni, więc binarki Fedory działają bez zmian.
;; Wszystkie funkcje biorą `root` (domyślnie "/"), więc da się je testować
;; i używać przy budowie obrazów w chroocie.

pub fn schema_version() -> int is return 1 end

pub struct Layout is
    pub root:     string
    pub system:   string
    pub state:    string
    pub packages: string
    pub tools:    string
    pub home:     string
    pub manifest: string
end

pub fn at(root: string) -> Layout is
    return Layout {
        root:     root,
        system:   text::path_join(root, "system"),
        state:    text::path_join(root, "state"),
        packages: text::path_join(root, "packages"),
        tools:    text::path_join(root, "tools"),
        home:     text::path_join(root, "home"),
        manifest: text::path_join(root, "manifest.toml") }
end

;; Domyślny układ: korzeń z $LEGENDARY_ROOT albo "/".
pub fn default_layout() -> Layout is
    return at(sys::getenv_or("LEGENDARY_ROOT", "/"))
end

;; ── Podkatalogi (stałe ścieżki, używane przez lpm i fasttree) ──────────────
pub fn state_etc(l: Layout) -> string is return text::path_join(l.state, "etc") end
pub fn state_var(l: Layout) -> string is return text::path_join(l.state, "var") end
pub fn ft_root(l: Layout) -> string is return text::path_join(l.state, "fasttree") end
pub fn lpm_dir(l: Layout) -> string is return text::path_join(l.state, "lpm") end
pub fn lpm_cache(l: Layout) -> string is return text::path_join(lpm_dir(l), "cache") end
pub fn lpm_journal(l: Layout) -> string is return text::path_join(lpm_dir(l), "journal") end
pub fn deployments_dir(l: Layout) -> string is return text::path_join(l.state, "deployments") end
pub fn overlays_dir(l: Layout) -> string is return text::path_join(l.state, "overlays") end
pub fn pkg_store(l: Layout) -> string is return text::path_join(l.packages, "store") end
pub fn pkg_profiles(l: Layout) -> string is return text::path_join(l.packages, "profiles") end
pub fn pkg_tmp(l: Layout) -> string is return text::path_join(l.packages, ".tmp") end
pub fn pkg_roots(l: Layout) -> string is return text::path_join(l.packages, "roots") end

;; Katalogi, które ensure() tworzy w /state.
pub fn state_subdirs() -> [string] is
    return ["etc", "var", "var/log", "var/lib", "var/cache", "var/tmp", "srv", "root",
            "fasttree", "lpm", "lpm/cache", "lpm/journal", "deployments", "overlays", "boot"]
end

;; Pary "symlink=cel" (cel względem katalogu symlinku) — warstwa zgodności.
pub fn compat_links() -> [string] is
    return ["usr=system", "bin=system/bin", "sbin=system/sbin", "lib=system/lib",
            "lib64=system/lib64", "etc=state/etc", "var=state/var", "srv=state/srv",
            "root=state/root", "opt=system/opt"]
end

pub struct LayoutResult is
    pub ok:     bool
    pub error:  string
    pub created: [string]
end

;; Tworzy brakujące katalogi układu. Idempotentne; niczego nie kasuje.
pub fn ensure(l: Layout) -> LayoutResult is
    let mut created: [string] = []
    let mut dirs: [string] = [l.system, l.state, l.packages, l.tools, l.home]
    let sub: [string] = state_subdirs()
    let mut i: int = 0
    while i < sub.len() is
        dirs.push(text::path_join(l.state, sub[i]))
        i += 1
    end
    dirs.push(pkg_store(l))
    dirs.push(pkg_profiles(l))
    dirs.push(pkg_tmp(l))
    dirs.push(pkg_roots(l))
    dirs.push(text::path_join(l.system, "opt"))
    let mut j: int = 0
    while j < dirs.len() is
        let d: string = dirs[j]
        j += 1
        if !fs::is_dir(d) is
            fs::mkdir(d)
            if !fs::is_dir(d) is
                return LayoutResult { ok: false, created: created, error: "nie można utworzyć " + d }
            end
            created.push(d)
        end
    end
    return LayoutResult { ok: true, error: "", created: created }
end

;; Tworzy symlinki zgodności (tylko tam, gdzie nic nie istnieje).
pub fn apply_compat_links(l: Layout) -> [string] is
    let mut made: [string] = []
    let pairs: [string] = compat_links()
    let mut i: int = 0
    while i < pairs.len() is
        let kv: [string] = text::split_once(pairs[i], "=")
        i += 1
        let link: string = text::path_join(l.root, kv[0])
        if !sys::exists_any(link) is
            if sys::symlink(kv[1], link) is made.push(link) end
        end
    end
    return made
end

;; Lista problemów układu (pusta = poprawny).
pub fn validate(l: Layout) -> [string] is
    let mut p: [string] = []
    let req: [string] = [l.system, l.state, l.packages, l.tools, l.home]
    let mut i: int = 0
    while i < req.len() is
        if !fs::is_dir(req[i]) is p.push("brak katalogu " + req[i]) end
        i += 1
    end
    let sub: [string] = state_subdirs()
    let mut j: int = 0
    while j < sub.len() is
        let d: string = text::path_join(l.state, sub[j])
        j += 1
        if !fs::is_dir(d) is p.push("brak katalogu stanu " + d) end
    end
    let pairs: [string] = compat_links()
    let mut k: int = 0
    while k < pairs.len() is
        let kv: [string] = text::split_once(pairs[k], "=")
        k += 1
        let link: string = text::path_join(l.root, kv[0])
        if sys::is_symlink(link) is
            if sys::readlink(link) != kv[1] is
                p.push("symlink " + link + " wskazuje na '" + sys::readlink(link) + "', oczekiwano '" + kv[1] + "'")
            end
        else is
            if sys::exists(link) is
                p.push(link + " istnieje, ale nie jest symlinkiem zgodności -> " + kv[1])
            end
        end
    end
    if !fs::exists(l.manifest) is p.push("brak " + l.manifest) end
    return p
end

;; ── Niezmienność ─────────────────────────────────────────────────────────────
;; /system jest zawsze tylko do odczytu (composefs). /state, /packages i /tools
;; są montowane `ro`; transakcja lpm podnosi je do `rw` na czas operacji.
;; Zwraca "" gdy OK albo komunikat błędu. Nie robi nic, gdy ścieżka nie jest
;; osobnym punktem montowania (np. testy, chroot przy budowie obrazu).
pub fn set_writable(path: string, writable: bool) -> string is
    if !sys::ok("mountpoint -q " + sys::sq(path)) is return "" end
    let mode: string = "ro"
    if writable is mode = "rw" end
    let r: sys::Exec = sys::exec("mount -o remount," + mode + " " + sys::sq(path))
    if r.code != 0 is return "remount," + mode + " " + path + ": " + text::trim(r.out) end
    return ""
end

pub fn unlock_mutable(l: Layout) -> string is
    let dirs: [string] = [l.state, l.packages, l.tools]
    let mut i: int = 0
    while i < dirs.len() is
        let e: string = set_writable(dirs[i], true)
        if e != "" is return e end
        i += 1
    end
    return ""
end

pub fn lock_mutable(l: Layout) -> string is
    let dirs: [string] = [l.tools, l.packages, l.state]
    let mut last: string = ""
    let mut i: int = 0
    while i < dirs.len() is
        let e: string = set_writable(dirs[i], false)
        if e != "" is last = e end
        i += 1
    end
    return last
end
