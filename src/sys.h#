mod text
use "std -> process" from "proc"
use "std -> fs" from "fs"
use "std -> env" from "env"
use "std -> os" from "os"
use "std -> time" from "t"

;; Warstwa systemowa: uruchamianie narzędzi zewnętrznych (tar, cp, curl,
;; mkcomposefs, veritysetup, mount ...) z KODEM WYJŚCIA oraz listowanie
;; drzewa plików z metadanymi (typ, tryb, rozmiar, inode, cel symlinku).
;;
;; std -> process zwraca tylko stdout+stderr, bez kodu wyjścia, więc
;; `exec` dokleja do polecenia znacznik z `$?` i go wycina z wyniku.

pub struct Exec is
    pub code: int
    pub out:  string
end

;; Cytowanie argumentu dla `sh -c` (pojedyncze cudzysłowy).
pub fn sq(s: string) -> string is
    let parts: [string] = text::split(s, "'")
    return "'" + text::join(parts, "'\\''") + "'"
end

;; Uruchamia `script` w `sh -c`; stdout i stderr są scalone w `out`.
pub fn exec(script: string) -> Exec is
    let full: string = "( " + script + " ) 2>&1; echo \"__FT_RC__$?\""
    let raw: string = proc::run_args("sh", ["-c", full])
    let marker: string = "__FT_RC__"
    let i: int = text::rfind(raw, marker)
    if i < 0 is
        return Exec { code: 127, out: raw }
    end
    let n: int = raw.len()
    let mk: int = marker.len()
    let codes: string = raw[i + mk..n]
    let code: int = text::parse_int(codes, 127)
    return Exec { code: code, out: raw[0..i] }
end

pub fn ok(script: string) -> bool is
    let r: Exec = exec(script)
    return r.code == 0
end

;; Czy narzędzie jest w PATH.
pub fn have_tool(name: string) -> bool is
    let p: string = proc::which(name)
    return p != ""
end

pub fn getenv_or(key: string, dflt: string) -> string is
    let v: string = env::get(key)
    if v == "" is return dflt end
    return v
end

pub fn mkdir_p(path: string) is
    fs::mkdir(path)
end

pub fn exists(path: string) -> bool is
    return fs::exists(path)
end

pub fn is_symlink(path: string) -> bool is
    return ok("test -L " + sq(path))
end

;; Istnieje jako plik/katalog LUB jako (być może zawieszony) symlink.
pub fn exists_any(path: string) -> bool is
    return fs::exists(path) || is_symlink(path)
end

pub fn rm_rf(path: string) is
    let r: Exec = exec("rm -rf -- " + sq(path))
end

pub fn rm_f(path: string) is
    let r: Exec = exec("rm -f -- " + sq(path))
end

pub fn symlink(target: string, link: string) -> bool is
    return ok("ln -s -- " + sq(target) + " " + sq(link))
end

pub fn readlink(path: string) -> string is
    let r: Exec = exec("readlink -- " + sq(path))
    return text::trim(r.out)
end

pub fn read_text(path: string) -> string is
    return fs::read(path)
end

pub fn write_text(path: string, content: string) -> bool is
    return fs::write(path, content)
end

pub fn tmp_dir() -> string is
    return getenv_or("TMPDIR", "/tmp")
end

pub fn pid() -> int is
    return os::pid()
end

pub fn now_ms() -> int is
    return t::now_ms()
end

pub fn now_unix() -> int is
    return t::now_unix()
end

;; Wpis drzewa plików. kind: "f" plik, "d" katalog, "l" symlink.
pub struct TreeEntry is
    pub path:   string
    pub kind:   string
    pub mode:   int
    pub size:   int
    pub inode:  string
    pub nlink:  int
    pub target: string
end

pub struct TreeResult is
    pub ok:      bool
    pub error:   string
    pub entries: [TreeEntry]
end

;; Rekurencyjne listowanie `root` (bez samego korzenia), symlinki NIE są
;; śledzone — odpowiednik walkDirRec z yieldFilter = {pcFile, pcDir,
;; pcLinkToFile, pcLinkToDir}. Pliki specjalne (fifo, gniazda, urządzenia)
;; są pomijane. Kolejność: rodzic przed dziećmi.
;;
;; OGRANICZENIE: ścieżki zawierające znak tabulacji lub nowej linii nie są
;; wspierane — `list_tree` zwraca wtedy błąd zamiast zgadywać.
pub fn list_tree(root: string) -> TreeResult is
    let fmt: string = "%y\t%m\t%s\t%D:%i\t%n\t%P\t%l\n"
    let raw: string = proc::run_args("find", [root, "-mindepth", "1", "-printf", fmt])
    let lines: [string] = text::lines(raw)
    let mut out: [TreeEntry] = []
    let n: int = lines.len()
    let mut i: int = 0
    while i < n is
        let line: string = lines[i]
        let f: [string] = text::split(line, "\t")
        let fc: int = f.len()
        if fc != 7 is
            return TreeResult { ok: false, entries: [], error: "list_tree: nieobsługiwana ścieżka lub błąd find w '" + root + "': " + line }
        end
        let kind: string = f[0]
        if kind == "f" || kind == "d" || kind == "l" is
            out.push(TreeEntry {
                path: f[5], kind: kind, mode: text::parse_octal(f[1]),
                size: text::parse_int(f[2], 0), inode: f[3],
                nlink: text::parse_int(f[4], 1), target: f[6] })
        end
        i += 1
    end
    return TreeResult { ok: true, error: "", entries: out }
end

;; stderr: H# 0.9 nie ma wbudowanego `eprint`, więc wołamy libc `dprintf`.
extern static [c] is
    fn dprintf(fd: int, fmt: string, s: string) -> int
end

pub fn eprint(msg: string) is
    let r: int = dprintf(2, "%s\n", msg)
end
