mod text
mod sys
use "std -> fs" from "fs"

;; ── manifest.toml LegendaryOS ───────────────────────────────────────────────
;;
;; /manifest.toml opisuje AKTYWNE wdrożenie: wersję systemu, bazę Fedory, układ
;; plików, listę warstw (pakiety RPM dołożone przez `lpm install`), narzędzia
;; z /tools i listę bibliotek dostarczanych przez system (ABI hosta: GPU itd.).
;; Plik jest częścią obrazu (niezmienny) — nowe wdrożenie = nowy manifest.toml.
;;
;; Parser obsługuje podzbiór TOML wystarczający dla manifestów:
;;   [sekcja]   [sekcja.podsekcja]   [[tablica]]   klucz = "napis" | 12 | true
;;   klucz = ["a", "b"]   (jednoliniowe tablice napisów)   # komentarze
;; Tablice tabel `[[layer]]` są trzymane jako sekcje "layer#1", "layer#2"...

pub struct Entry is
    pub section: string
    pub key:     string
    pub kind:    string   ;; "s" napis, "i" liczba, "b" bool, "a" tablica napisów
    pub value:   string   ;; tablica: elementy rozdzielone "\n"
end

pub struct Doc is
    pub entries: [Entry]
end

pub struct ParseResult is
    pub ok:    bool
    pub error: string
    pub doc:   Doc
end

pub fn empty() -> Doc is
    let e: [Entry] = []
    return Doc { entries: e }
end

;; ── Parser ──────────────────────────────────────────────────────────────────

fn q() -> string is return __builtin_char_code_to_str(34) end
fn bs() -> string is return __builtin_char_code_to_str(92) end

;; Obcina komentarz `#` poza napisami.
fn strip_comment(line: string) -> string is
    let n: int = line.len()
    let mut inq: bool = false
    let mut i: int = 0
    while i < n is
        let c: string = line[i..i + 1]
        if c == bs() && inq is
            i += 2
        else is
            if c == q() is inq = !inq end
            if c == "#" && !inq is return line[0..i] end
            i += 1
        end
    end
    return line
end

;; Czyta napis w cudzysłowie od `start` (na q()); zwraca [wartość, indeks za napisem] albo [] przy błędzie.
fn read_quoted(s: string, start: int) -> [string] is
    let n: int = s.len()
    let mut out: string = ""
    let mut i: int = start + 1
    while i < n is
        let c: string = s[i..i + 1]
        if c == bs() && i + 1 < n is
            let d: string = s[i + 1..i + 2]
            if d == "n" is out = out + "\n"
            else is
                if d == "t" is out = out + "\t" else is out = out + d end
            end
            i += 2
        else is
            if c == q() is return [out, text::istr(i + 1)] end
            out = out + c
            i += 1
        end
    end
    return []
end

fn parse_array(v: string) -> [string] is
    ;; zwraca ["ok", elem...] albo ["err"]
    let n: int = v.len()
    let mut items: [string] = ["ok"]
    let mut i: int = 1
    while i < n - 1 is
        let c: string = v[i..i + 1]
        if c == q() is
            let r: [string] = read_quoted(v, i)
            if r.len() != 2 is return ["err"] end
            items.push(r[0])
            i = text::parse_int(r[1], n)
        else is
            if c == "," || c == " " || c == "\t" is
                i += 1
            else is
                return ["err"]
            end
        end
    end
    return items
end

fn put(d: Doc, section: string, key: string, kind: string, value: string) -> Doc is
    let mut es: [Entry] = d.entries
    let mut i: int = 0
    while i < es.len() is
        let e: Entry = es[i]
        if e.section == section && e.key == key is
            es[i] = Entry { section: section, key: key, kind: kind, value: value }
            return Doc { entries: es }
        end
        i += 1
    end
    es.push(Entry { section: section, key: key, kind: kind, value: value })
    return Doc { entries: es }
end

pub fn parse(src: string) -> ParseResult is
    let lines: [string] = text::lines(src)
    let mut doc: Doc = empty()
    let mut section: string = ""
    let mut counts: [string] = []   ;; "nazwa=ile" dla [[nazwa]]
    let mut i: int = 0
    while i < lines.len() is
        let ln: int = i + 1
        let line: string = text::trim(strip_comment(lines[i]))
        i += 1
        if line == "" is
            ;; pusta linia
        else is
            let n: int = line.len()
            if text::starts_with(line, "[[") is
                if !text::ends_with(line, "]]") is
                    return ParseResult { ok: false, doc: doc, error: "linia " + text::istr(ln) + ": niedomknięte [[...]]" }
                end
                let name: string = text::trim(line[2..n - 2])
                let mut cnt: int = 0
                let mut ci: int = 0
                while ci < counts.len() is
                    let kv: [string] = text::split_once(counts[ci], "=")
                    if kv[0] == name is
                        cnt = text::parse_int(kv[1], 0)
                        counts[ci] = name + "=" + text::istr(cnt + 1)
                    end
                    ci += 1
                end
                if cnt == 0 is counts.push(name + "=1") end
                section = name + "#" + text::istr(cnt + 1)
            else is
                if text::starts_with(line, "[") is
                    if !text::ends_with(line, "]") is
                        return ParseResult { ok: false, doc: doc, error: "linia " + text::istr(ln) + ": niedomknięte [...]" }
                    end
                    section = text::trim(line[1..n - 1])
                else is
                    let eq: int = text::find(line, "=")
                    if eq < 1 is
                        return ParseResult { ok: false, doc: doc, error: "linia " + text::istr(ln) + ": oczekiwano klucz = wartość" }
                    end
                    let key: string = text::trim(line[0..eq])
                    let v: string = text::trim(line[eq + 1..n])
                    if v == "" is
                        return ParseResult { ok: false, doc: doc, error: "linia " + text::istr(ln) + ": pusta wartość klucza '" + key + "'" }
                    end
                    if v[0..1] == q() is
                        let r: [string] = read_quoted(v, 0)
                        if r.len() != 2 is
                            return ParseResult { ok: false, doc: doc, error: "linia " + text::istr(ln) + ": niedomknięty napis" }
                        end
                        doc = put(doc, section, key, "s", r[0])
                    else is
                        if v[0..1] == "[" is
                            if !text::ends_with(v, "]") is
                                return ParseResult { ok: false, doc: doc, error: "linia " + text::istr(ln) + ": tablica musi być w jednej linii i kończyć się ]" }
                            end
                            let a: [string] = parse_array(v)
                            if a[0] != "ok" is
                                return ParseResult { ok: false, doc: doc, error: "linia " + text::istr(ln) + ": tablica może zawierać tylko napisy" }
                            end
                            let mut elems: [string] = []
                            let mut k: int = 1
                            while k < a.len() is
                                elems.push(a[k])
                                k += 1
                            end
                            doc = put(doc, section, key, "a", text::join(elems, "\n"))
                        else is
                            if v == "true" || v == "false" is
                                doc = put(doc, section, key, "b", v)
                            else is
                                let num: int = text::parse_int(v, -999999999)
                                if num == -999999999 is
                                    return ParseResult { ok: false, doc: doc, error: "linia " + text::istr(ln) + ": nieznany typ wartości '" + v + "'" }
                                end
                                doc = put(doc, section, key, "i", v)
                            end
                        end
                    end
                end
            end
        end
    end
    return ParseResult { ok: true, error: "", doc: doc }
end

pub fn load(path: string) -> ParseResult is
    if !fs::exists(path) is
        return ParseResult { ok: false, doc: empty(), error: "brak pliku " + path }
    end
    return parse(fs::read(path))
end

;; ── Odczyt ──────────────────────────────────────────────────────────────────

pub fn has(d: Doc, section: string, key: string) -> bool is
    let mut i: int = 0
    while i < d.entries.len() is
        let e: Entry = d.entries[i]
        if e.section == section && e.key == key is return true end
        i += 1
    end
    return false
end

pub fn get(d: Doc, section: string, key: string, dflt: string) -> string is
    let mut i: int = 0
    while i < d.entries.len() is
        let e: Entry = d.entries[i]
        if e.section == section && e.key == key is return e.value end
        i += 1
    end
    return dflt
end

pub fn get_int(d: Doc, section: string, key: string, dflt: int) -> int is
    return text::parse_int(get(d, section, key, ""), dflt)
end

pub fn get_bool(d: Doc, section: string, key: string, dflt: bool) -> bool is
    let v: string = get(d, section, key, "")
    if v == "true" is return true end
    if v == "false" is return false end
    return dflt
end

pub fn get_list(d: Doc, section: string, key: string) -> [string] is
    let v: string = get(d, section, key, "")
    let mut out: [string] = []
    if v == "" is return out end
    return text::split(v, "\n")
end

;; Nazwy sekcji `[[prefix]]` w kolejności występowania: "layer#1", "layer#2"...
pub fn table_sections(d: Doc, prefix: string) -> [string] is
    let mut out: [string] = []
    let pre: string = prefix + "#"
    let mut i: int = 0
    while i < d.entries.len() is
        let s: string = d.entries[i].section
        i += 1
        if text::starts_with(s, pre) is
            let mut seen: bool = false
            let mut j: int = 0
            while j < out.len() is
                if out[j] == s is seen = true end
                j += 1
            end
            if !seen is out.push(s) end
        end
    end
    return out
end

;; ── Zapis ───────────────────────────────────────────────────────────────────

pub fn put_str(d: Doc, section: string, key: string, v: string) -> Doc is
    return put(d, section, key, "s", v)
end
pub fn put_int(d: Doc, section: string, key: string, v: int) -> Doc is
    return put(d, section, key, "i", text::istr(v))
end
pub fn put_bool(d: Doc, section: string, key: string, v: bool) -> Doc is
    return put(d, section, key, "b", text::bstr(v))
end
pub fn put_list(d: Doc, section: string, key: string, v: [string]) -> Doc is
    return put(d, section, key, "a", text::join(v, "\n"))
end

;; Dopisuje kolejny element tablicy tabel [[name]]; zwraca nazwę sekcji przez Appended.
pub struct Appended is
    pub doc:     Doc
    pub section: string
end

pub fn append_table(d: Doc, name: string) -> Appended is
    let n: int = table_sections(d, name).len()
    return Appended { doc: d, section: name + "#" + text::istr(n + 1) }
end

fn escape(s: string) -> string is
    let mut out: string = ""
    let n: int = s.len()
    let mut i: int = 0
    while i < n is
        let c: string = s[i..i + 1]
        if c == q() || c == bs() is out = out + bs() + c
        else is
            if c == "\n" is out = out + bs() + "n"
            else is
                if c == "\t" is out = out + bs() + "t" else is out = out + c end
            end
        end
        i += 1
    end
    return out
end

fn render_value(e: Entry) -> string is
    if e.kind == "s" is return q() + escape(e.value) + q() end
    if e.kind == "a" is
        if e.value == "" is return "[]" end
        let parts: [string] = text::split(e.value, "\n")
        let mut quoted: [string] = []
        let mut i: int = 0
        while i < parts.len() is
            quoted.push(q() + escape(parts[i]) + q())
            i += 1
        end
        return "[" + text::join(quoted, ", ") + "]"
    end
    return e.value
end

fn header(section: string) -> string is
    let h: int = text::find(section, "#")
    if h >= 0 is return "[[" + section[0..h] + "]]" end
    return "[" + section + "]"
end

;; Serializacja: sekcje w kolejności pierwszego użycia; klucze w kolejności dodania.
pub fn emit(d: Doc) -> string is
    let mut order: [string] = []
    let mut i: int = 0
    while i < d.entries.len() is
        let s: string = d.entries[i].section
        i += 1
        let mut seen: bool = false
        let mut j: int = 0
        while j < order.len() is
            if order[j] == s is seen = true end
            j += 1
        end
        if !seen is order.push(s) end
    end
    let mut out: string = ""
    let mut k: int = 0
    while k < order.len() is
        let s: string = order[k]
        k += 1
        if s != "" is out = out + header(s) + "\n" end
        let mut m: int = 0
        while m < d.entries.len() is
            let e: Entry = d.entries[m]
            m += 1
            if e.section == s is out = out + e.key + " = " + render_value(e) + "\n" end
        end
        out = out + "\n"
    end
    return out
end

pub fn save(path: string, d: Doc) -> string is
    let tmp: string = path + ".tmp." + text::istr(sys::pid())
    if !fs::write(tmp, emit(d)) is return "nie można zapisać " + tmp end
    fs::rename(tmp, path)
    return ""
end

;; ── Manifest systemu ────────────────────────────────────────────────────────

;; Biblioteki, których pakiety z /packages NIGDY nie dołączają do własnego
;; closure — zawsze pochodzą z systemu (/system + sterowniki). To jest sedno
;; unikania konfliktów ze sterownikami NVIDIA/Mesa: pakiet linkuje się z
;; interfejsem (libGL, libvulkan...), a implementację dostarcza host.
pub fn default_host_provided() -> [string] is
    return ["libc.so.6", "libm.so.6", "libpthread.so.0", "libdl.so.2", "librt.so.1",
            "ld-linux-x86-64.so.2", "ld-linux-aarch64.so.1", "libresolv.so.2",
            "libGL.so.1", "libGLX.so.0", "libEGL.so.1", "libGLESv2.so.2", "libOpenGL.so.0",
            "libvulkan.so.1", "libgbm.so.1", "libdrm.so.2", "libwayland-client.so.0",
            "libcuda.so.1", "libnvidia-ml.so.1", "libnvidia-encode.so.1", "libnvcuvid.so.1",
            "libva.so.2", "libvdpau.so.1", "libxcb.so.1", "libX11.so.6"]
end

pub struct NewOs is
    pub name:        string
    pub version:     string
    pub base:        string   ;; "fedora"
    pub base_release: string  ;; "43"
    pub arch:        string
    pub channel:     string
    pub tag:         string   ;; tag FastTree obrazu systemu
    pub parent:      string
    pub generation:  int
    pub kind:        string   ;; "base" | "layered"
    pub created:     string
end

pub fn new_os_manifest(n: NewOs) -> Doc is
    let mut d: Doc = empty()
    d = put_str(d, "os", "name", n.name)
    d = put_str(d, "os", "version", n.version)
    d = put_str(d, "os", "base", n.base)
    d = put_str(d, "os", "base_release", n.base_release)
    d = put_str(d, "os", "arch", n.arch)
    d = put_str(d, "os", "channel", n.channel)
    d = put_int(d, "layout", "schema", 1)
    d = put_str(d, "layout", "system", "/system")
    d = put_str(d, "layout", "state", "/state")
    d = put_str(d, "layout", "packages", "/packages")
    d = put_str(d, "layout", "tools", "/tools")
    d = put_str(d, "layout", "home", "/home")
    d = put_str(d, "deployment", "tag", n.tag)
    d = put_str(d, "deployment", "parent", n.parent)
    d = put_int(d, "deployment", "generation", n.generation)
    d = put_str(d, "deployment", "kind", n.kind)
    d = put_str(d, "deployment", "created", n.created)
    d = put_str(d, "init", "service_manager", "zenitd")
    d = put_str(d, "init", "path", "/system/lib/zenit/zenitd")
    d = put_list(d, "abi", "host_provided", default_host_provided())
    return d
end

;; Dokłada warstwę (pakiet RPM dołożony przez `lpm install`) do manifestu.
pub fn add_layer(d: Doc, name: string, nevra: string, repo: string) -> Doc is
    let a: Appended = append_table(d, "layer")
    let mut x: Doc = a.doc
    x = put_str(x, a.section, "name", name)
    x = put_str(x, a.section, "nevra", nevra)
    x = put_str(x, a.section, "repo", repo)
    return x
end

;; Dokłada narzędzie z /tools.
pub fn add_tool(d: Doc, name: string, git: string, rev: string, sqfs: string) -> Doc is
    let a: Appended = append_table(d, "tool")
    let mut x: Doc = a.doc
    x = put_str(x, a.section, "name", name)
    x = put_str(x, a.section, "git", git)
    x = put_str(x, a.section, "rev", rev)
    x = put_str(x, a.section, "sqfs", sqfs)
    return x
end

;; Walidacja manifestu: lista problemów (pusta = OK).
pub fn validate_manifest(d: Doc) -> [string] is
    let mut p: [string] = []
    let req: [string] = ["os.name", "os.version", "os.base", "layout.schema", "deployment.tag", "deployment.generation", "init.service_manager"]
    let mut i: int = 0
    while i < req.len() is
        let kv: [string] = text::split_once(req[i], ".")
        if !has(d, kv[0], kv[1]) is p.push("brakuje " + req[i]) end
        i += 1
    end
    if has(d, "layout", "schema") && get_int(d, "layout", "schema", 0) > 1 is
        p.push("manifest ma schemat " + get(d, "layout", "schema", "?") + ", ta wersja obsługuje do 1")
    end
    if has(d, "init", "service_manager") && get(d, "init", "service_manager", "") != "zenitd" is
        p.push("init.service_manager musi być 'zenitd' (LegendaryOS nie używa systemd)")
    end
    return p
end
