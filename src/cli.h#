;; Parsowanie argumentów i dyspozytor komend. Każda komenda zwraca kod
;; wyjścia procesu (0 = sukces), więc `validate`/`build` nadają się do CI.

struct Parsed is
    cmd:  string
    args: [string]       ;; argumenty pozycyjne po komendzie
    opts: opts::Options
    bad:  string         ;; niepusty = błąd parsowania (komunikat)
end

fn flag_takes_value(f: string) -> bool is
    return f == "--arch" || f == "--suite" || f == "--ref" || f == "--iso-name" || f == "--target" ||
           f == "--kind" || f == "--device"
end

fn apply_value(o: opts::Options, f: string, v: string) -> opts::Options is
    let mut n: opts::Options = o
    if f == "--arch" is n.arch = v end
    if f == "--suite" is n.suite = v end
    if f == "--ref" is n.ref_name = v end
    if f == "--iso-name" is n.iso_name = v end
    if f == "--target" is n.target = v end
    if f == "--kind" is n.kind = v end
    if f == "--device" is n.device = v end
    return n
end

fn apply_switch(o: opts::Options, f: string) -> opts::Options is
    let mut n: opts::Options = o
    if f == "--verbose" || f == "-v" is n.verbose = true end
    if f == "--dry-run" || f == "-n" is n.dry_run = true end
    if f == "--keep-staging" is n.keep_staging = true end
    if f == "--no-base" is n.no_base = true end
    if f == "--yes" || f == "-y" is n.assume_yes = true end
    if f == "--strict" is n.strict = true end
    if f == "--clean" is n.clean_first = true end
    if f == "--no-color" is n.no_color = true end
    if f == "--keep-going" is n.keep_going = true end
    return n
end

fn is_switch(f: string) -> bool is
    return f == "--verbose" || f == "-v" || f == "--dry-run" || f == "-n" || f == "--keep-staging" ||
           f == "--no-base" || f == "--yes" || f == "-y" || f == "--strict" || f == "--clean" ||
           f == "--no-color" || f == "--keep-going"
end

;; argv[0] = program, argv[1] = komenda, reszta = flagi i argumenty.
pub fn parse(argv: [string]) -> Parsed is
    let mut o: opts::Options = opts::defaults()
    let mut pos: [string] = []
    let mut cmd: string = ""
    let mut bad: string = ""
    let mut i: int = 1
    while i < array_len(argv) is
        let a: string = argv[i]
        i += 1
        if cmd == "" && !string_starts_with(a, "-") is
            cmd = a
            continue
        end
        if cmd == "" && (a == "--help" || a == "-h") is
            cmd = "help"
            continue
        end
        if cmd == "" && (a == "--version" || a == "-V") is
            cmd = "version"
            continue
        end
        if string_starts_with(a, "--") && string_find(a, "=") > 0 is
            let eq: int = string_find(a, "=")
            let f: string = string_slice(a, 0, eq)
            if flag_takes_value(f) is
                o = apply_value(o, f, string_slice(a, eq + 1, string_len(a)))
                continue
            end
        end
        if flag_takes_value(a) is
            if i >= array_len(argv) is
                bad = "flaga " + a + " wymaga wartości"
            else is
                o = apply_value(o, a, argv[i])
                i += 1
            end
            continue
        end
        if is_switch(a) is
            o = apply_switch(o, a)
            continue
        end
        if a == "--help" || a == "-h" is
            cmd = "help"
            continue
        end
        if string_starts_with(a, "-") && a != "-" is
            bad = "nieznana flaga: " + a
            continue
        end
        pos.push(a)
    end
    return Parsed { cmd: cmd, args: pos, opts: o, bad: bad }
end

fn arg_or(pr: Parsed, idx: int, fallback: string) -> string is
    if idx < array_len(pr.args) is return pr.args[idx] end
    return fallback
end

