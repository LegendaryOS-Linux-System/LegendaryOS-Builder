;; ── wspólne ──────────────────────────────────────────────────────────

struct LoadResult is
    ok:      bool
    project: project::Project
end

fn load_and_check(root: string, o: opts::Options) -> LoadResult is
    let p: project::Project = project::load(root)
    let mut v: project::ValidationResult = project::validate(p)
    if o.strict is v = project::promote_warnings(v) end
    diag::print_issues(p, v)
    if project::is_ok(v) is
        if project::warnings_count(v) == 0 is ui::ok("projekt jest poprawny") end
    end
    return LoadResult { ok: project::is_ok(v), project: p }
end

fn targets_or_fail(p: project::Project, o: opts::Options) -> [target::Target] is
    let ts: [target::Target] = target::resolve_all(p, o, target::host_arch())
    if array_len(ts) == 0 is
        ui::fail("żaden cel nie pasuje do konfiguracji/filtrów (--target / --arch)")
    end
    return ts
end

;; ── komendy ──────────────────────────────────────────────────────────

fn cmd_new(pr: Parsed) -> int is
    if array_len(pr.args) < 1 is
        ui::fail("użycie: legendaryos-builder new <nazwa> [--kind pc|phone|both] [--device ID]")
        return 2
    end
    if scaffold::create(pr.args[0], pr.opts) is return 0 end
    return 1
end

fn cmd_validate(pr: Parsed) -> int is
    let loaded: LoadResult = load_and_check(arg_or(pr, 0, "."), pr.opts)
    if loaded.ok is return 0 end
    ui::blank()
    ui::fail("walidacja nie powiodła się -- popraw błędy powyżej")
    return 1
end

fn cmd_run_scripts(pr: Parsed) -> int is
    let root: string = arg_or(pr, 0, ".")
    let results: [scriptrunner::ScriptResult] = scriptrunner::run_all(root, pr.opts)
    if scriptrunner::all_ok(results) is return 0 end
    return 1
end

fn cmd_stage(pr: Parsed) -> int is
    let loaded: LoadResult = load_and_check(arg_or(pr, 0, "."), pr.opts)
    if !loaded.ok is return 1 end
    let ts: [target::Target] = targets_or_fail(loaded.project, pr.opts)
    if array_len(ts) == 0 is return 1 end
    let mut i: int = 0
    while i < array_len(ts) is
        if !livebuild::stage(loaded.project, pr.opts, ts[i]) is return 1 end
        i += 1
    end
    return 0
end

fn cmd_lb_config(pr: Parsed) -> int is
    let loaded: LoadResult = load_and_check(arg_or(pr, 0, "."), pr.opts)
    if !loaded.ok is return 1 end
    let ts: [target::Target] = targets_or_fail(loaded.project, pr.opts)
    if array_len(ts) == 0 is return 1 end
    let mut i: int = 0
    while i < array_len(ts) is
        if !livebuild::lb_config(loaded.project, pr.opts, ts[i]) is return 1 end
        i += 1
    end
    return 0
end

fn cmd_lb_build(pr: Parsed) -> int is
    let loaded: LoadResult = load_and_check(arg_or(pr, 0, "."), pr.opts)
    if !loaded.ok is return 1 end
    let ts: [target::Target] = targets_or_fail(loaded.project, pr.opts)
    if array_len(ts) == 0 is return 1 end
    let mut produced: [string] = []
    let mut i: int = 0
    while i < array_len(ts) is
        if !livebuild::lb_build(loaded.project, pr.opts, ts[i]) is return 1 end
        let made: [string] = livebuild::finish(loaded.project, pr.opts, ts[i])
        if array_len(made) == 0 && !pr.opts.dry_run is return 1 end
        produced = array_concat(produced, made)
        i += 1
    end
    print_artifacts(loaded.project, produced)
    return 0
end

fn print_artifacts(p: project::Project, produced: [string]) is
    if array_len(produced) == 0 is return end
    ui::title("Artefakty")
    let out_dir: string = path_join(project::build_dir(p), "out")
    let mut i: int = 0
    while i < array_len(produced) is
        let size: string = sh::capture("du -h " + sh::sq(path_join(out_dir, produced[i])) + " 2>/dev/null | cut -f1")
        ui::kv(size, produced[i])
        i += 1
    end
    ui::muted("katalog: " + out_dir)
end

fn cmd_build(pr: Parsed) -> int is
    let root: string = arg_or(pr, 0, ".")
    ui::plain(ui::banner(version::version()))
    let loaded: LoadResult = load_and_check(root, pr.opts)
    if !loaded.ok is
        ui::blank()
        ui::fail("build przerwany -- struktura projektu jest niepoprawna")
        return 1
    end
    let p: project::Project = loaded.project
    let o: opts::Options = pr.opts
    let ts: [target::Target] = targets_or_fail(p, o)
    if array_len(ts) == 0 is return 1 end
    if o.clean_first is sh::rm_rf(project::build_dir(p)) end

    ui::title("Plan")
    let mut i: int = 0
    while i < array_len(ts) is
        ui::kv(ts[i].kind, target::label(ts[i]) + "  ->  " + str_join(ts[i].images, ", "))
        i += 1
    end

    ui::title("Skrypty")
    let results: [scriptrunner::ScriptResult] = scriptrunner::run_all(root, o)
    if !scriptrunner::all_ok(results) is
        ui::fail("build przerwany -- skrypt scripts/*.hl zwrócił błąd")
        return 1
    end

    let mut produced: [string] = []
    i = 0
    while i < array_len(ts) is
        ui::title("Cel " + to_string(i + 1) + "/" + to_string(array_len(ts)) + ": " + target::label(ts[i]))
        if !livebuild::stage(p, o, ts[i]) is return 1 end
        if !livebuild::lb_config(p, o, ts[i]) is return 1 end
        if !livebuild::lb_build(p, o, ts[i]) is return 1 end
        let made: [string] = livebuild::finish(p, o, ts[i])
        if array_len(made) == 0 && !o.dry_run is return 1 end
        produced = array_concat(produced, made)
        i += 1
    end

    if !o.dry_run is
        let base_dir: string = path_join(ts[0].work_dir, ".base")
        let notes: string = release::write_notes(p, o, ts, produced, base_dir)
        ui::ok("notatki wydania: " + notes)
        if !o.keep_staging is
            let mut k: int = 0
            while k < array_len(ts) is
                sh::rm_rf(path_join(ts[k].work_dir, ".staging"))
                k += 1
            end
        end
    end
    print_artifacts(p, produced)
    ui::blank()
    ui::ok("gotowe")
    return 0
end

fn cmd_clean(pr: Parsed) -> int is
    let root: string = arg_or(pr, 0, ".")
    if !fs_is_file(path_join(root, "config.hk")) is
        ui::fail(root + " nie wygląda na projekt LegendaryOS (brak config.hk) -- nic nie usuwam")
        return 1
    end
    let dir: string = path_join(root, "build")
    ui::info("usuwam " + dir)
    if pr.opts.dry_run is
        ui::muted("[dry-run]")
        return 0
    end
    sh::rm_rf(dir)
    return 0
end

fn cmd_sync_base(pr: Parsed) -> int is
    let root: string = arg_or(pr, 0, ".")
    let p: project::Project = project::load(root)
    let ref_name: string = project::base_ref(p, pr.opts)
    let url: string = project::base_url(p)
    if gitsync::bootstrap_mirror(url, ref_name, project::token(p)) is
        ui::ok("lustro bazy gotowe: " + gitsync::mirror_dir() + " @ " + gitsync::head_info(gitsync::mirror_dir()))
        return 0
    end
    return 1
end

fn cmd_targets(pr: Parsed) -> int is
    let loaded: LoadResult = load_and_check(arg_or(pr, 0, "."), pr.opts)
    if !loaded.ok is return 1 end
    let ts: [target::Target] = target::resolve_all(loaded.project, pr.opts, target::host_arch())
    ui::title("Cele (host: " + target::host_arch() + ")")
    let mut i: int = 0
    while i < array_len(ts) is
        let t: target::Target = ts[i]
        let mut extra: string = ""
        if t.qemu_arch != "" is extra = "  [qemu: " + t.qemu_static + "]" end
        ui::kv(t.kind, target::label(t) + "  ->  " + str_join(t.images, ", ") + extra)
        i += 1
    end
    if array_len(ts) == 0 is ui::warn("brak celów") end
    return 0
end

fn cmd_devices() -> int is
    ui::title("Profile urządzeń")
    let list: [devices::Device] = devices::all()
    let mut i: int = 0
    while i < array_len(list) is
        ui::cmd_row(list[i].id, list[i].name + "  [" + list[i].arch + ", boot: " + list[i].boot + "]")
        if list[i].notes != "" is ui::muted("    " + list[i].notes) end
        i += 1
    end
    ui::blank()
    ui::hint("użycie w config.hk:  -> targets => [phone:arm64:<id>]")
    return 0
end

fn cmd_doctor(pr: Parsed) -> int is
    let root: string = arg_or(pr, 0, ".")
    let has_project: bool = fs_is_file(path_join(root, "config.hk"))
    let p: project::Project = project::load(root)
    let missing: int = doctor::run_checks(p, has_project, pr.opts)
    ui::blank()
    if missing == 0 is
        ui::ok("wszystko gotowe do budowy")
        return 0
    end
    ui::fail("brakuje wymagań: " + to_string(missing))
    return 1
end

fn cmd_info(pr: Parsed) -> int is
    let loaded: LoadResult = load_and_check(arg_or(pr, 0, "."), pr.opts)
    if !loaded.ok is return 1 end
    let p: project::Project = loaded.project
    let o: opts::Options = pr.opts
    ui::title(project::distro_name(p) + " " + project::proj_version(p) + " (" + project::tag(p) + ")")
    ui::kv("projekt", project::name(p))
    ui::kv("suite", project::suite(p, o))
    ui::kv("baza", hkconf::get_or(p.config, "release", "base", "hackeros") + " @ " + project::base_ref(p, o))
    ui::kv("iso-name", project::iso_name(p, o))
    let ts: [target::Target] = target::resolve_all(p, o, target::host_arch())
    let mut i: int = 0
    while i < array_len(ts) is
        ui::kv("cel", target::label(ts[i]) + "  (" + to_string(array_len(packages::package_names(p, ts[i]))) + " pakietów)")
        i += 1
    end
    ui::kv("kolory", ui::level_name())
    return 0
end

fn cmd_release_notes(pr: Parsed) -> int is
    let loaded: LoadResult = load_and_check(arg_or(pr, 0, "."), pr.opts)
    if !loaded.ok is return 1 end
    let p: project::Project = loaded.project
    let ts: [target::Target] = targets_or_fail(p, pr.opts)
    if array_len(ts) == 0 is return 1 end
    let out_dir: string = path_join(project::build_dir(p), "out")
    let listing: string = sh::capture("ls -1 " + sh::sq(out_dir) + " 2>/dev/null | grep -v RELEASE-NOTES")
    let mut produced: [string] = []
    if listing != "" is produced = string_split(listing, "\n") end
    let file: string = release::write_notes(p, pr.opts, ts, produced, path_join(ts[0].work_dir, ".base"))
    ui::ok("zapisano " + file)
    return 0
end

fn cmd_completions(pr: Parsed) -> int is
    let sh_name: string = arg_or(pr, 0, "bash")
    let out: string = completions::for_shell(sh_name)
    if out == "" is
        ui::fail("nieznana powłoka '" + sh_name + "' (bash | zsh | fish)")
        return 2
    end
    write(out)
    return 0
end

pub fn dispatch(argv: [string]) -> int is
    let pr: Parsed = parse(argv)
    ui::setup(pr.opts.no_color)
    diag::setup(pr.opts.no_color)

    if pr.bad != "" is
        ui::fail(pr.bad)
        ui::hint("legendaryos-builder --help")
        return 2
    end
    let cmd: string = pr.cmd
    if cmd == "" || cmd == "help" is
        print_help()
        return 0
    end
    if cmd == "version" is
        write(version::name() + " " + version::version())
        return 0
    end

    if cmd == "new" is return cmd_new(pr) end
    if cmd == "validate" is return cmd_validate(pr) end
    if cmd == "build" is return cmd_build(pr) end
    if cmd == "clean" is return cmd_clean(pr) end
    if cmd == "sync-base" is return cmd_sync_base(pr) end
    if cmd == "targets" is return cmd_targets(pr) end
    if cmd == "devices" is return cmd_devices() end
    if cmd == "doctor" is return cmd_doctor(pr) end
    if cmd == "info" is return cmd_info(pr) end
    if cmd == "release-notes" is return cmd_release_notes(pr) end
    if cmd == "completions" is return cmd_completions(pr) end
    if cmd == "selftest" is return selftest::run() end

    if cmd == "stage" is return cmd_stage(pr) end
    if cmd == "run-scripts" is return cmd_run_scripts(pr) end
    if cmd == "lb-config" is return cmd_lb_config(pr) end
    if cmd == "lb-build" is return cmd_lb_build(pr) end

    ui::fail("nieznana komenda: " + cmd)
    ui::hint("legendaryos-builder --help")
    return 2
end
