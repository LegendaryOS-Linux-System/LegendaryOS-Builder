#!/usr/bin/hl
using <gen 2>

%BIN_NAME: str = legendaryos-builder
%BUILD_OUT: str = cache/build/release/legendaryos-builder
%INSTALL_PATH: str = /usr/bin/legendaryos-builder

~> ==> Sprawdzanie zależności (bit, h#)...

::which bit
? err
    ~> BŁĄD: nie znaleziono `bit` (menedżer pakietów H#) w PATH.
    ~> Zainstaluj go najpierw: https://github.com/bit-io/bit
    > exit 1
done

::which h#
? err
    ~> BŁĄD: nie znaleziono `h#` (kompilator H#) w PATH.
    ~> Zainstaluj go najpierw: https://github.com/HackerOS-Linux-System/H-Sharp
    > exit 1
done

~> ==> Pobieranie bibliotek (bit install: colors, nidus)...
> bit install
? err
    ~> BŁĄD: `bit install` nie powiodło się -- sprawdź [dependencies] w Bit.hk.
    > exit 1
done

~> ==> Sprawdzanie typów (h# check)...
> h# check src/main.h#
? err
    ~> BŁĄD: sprawdzanie typów nie powiodło się.
    > exit 1
done

~> ==> Budowanie @BIN_NAME (bit build --release)...
> bit build --release
? err
    ~> BŁĄD: budowa nie powiodła się.
    > exit 1
done

> test -f @BUILD_OUT
? err
    ~> BŁĄD: oczekiwano binarki pod @BUILD_OUT, ale jej nie ma.
    > exit 1
done

~> ==> Testy wbudowane (selftest)...
> @BUILD_OUT selftest
? err
    ~> BŁĄD: selftest nie przeszedł -- nie instaluję.
    > exit 1
done

~> ==> Instalacja do @INSTALL_PATH (wymaga sudo)...
> sudo install -Dm755 @BUILD_OUT @INSTALL_PATH
? err
    ~> BŁĄD: instalacja nie powiodła się (brak uprawnień?).
    > exit 1
done

~> ==> Dopełnianie komend (bash/zsh/fish)...
> sudo sh -c "@INSTALL_PATH completions bash > /usr/share/bash-completion/completions/legendaryos-builder"
> sudo sh -c "@INSTALL_PATH completions zsh > /usr/share/zsh/vendor-completions/_legendaryos-builder"
> sudo sh -c "@INSTALL_PATH completions fish > /usr/share/fish/vendor_completions.d/legendaryos-builder.fish"

~> ==> Gotowe! Uruchom: legendaryos-builder --help
