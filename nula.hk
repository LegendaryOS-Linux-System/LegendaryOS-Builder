[package]
-> name        => legendaryos-builder
-> version     => 0.2.0
-> description => Builder obrazów ISO i OCI dla LegendaryOS (Fedora + zenitd + FastTree, układ /system /state /packages /tools)
-> authors     => ["LegendaryOS Team"]
-> license     => MIT
-> keywords    => ["iso", "oci", "fedora", "fasttree", "zenitd", "legendaryos", "immutable"]
-> readme      => README.md
-> lang        => [h#, z#, hl++]

[edition]
-> edition   => 2026
-> toolchain => 0.9

! nula wykrywa biblioteki w kodzie (use "bit -> libfasttree" w src/main.h#). Od 0.2.0 NIE MA [vendor] ani
! scripts/vendor-fasttree.sh: libfasttree jest używany jako biblioteka (fasada ft::api::*), bez kopii źródeł
! i bez wołania programu `fasttree`. Pakiety do rootfs składa osobne narzędzie `lepm` (../lepm), nie dnf.
[pins]
-> libfasttree => path ../libfasttree

[layout]
-> src         => src
-> mod         => mod
-> source-code => source-code

[commands]
-> check
--> run => bit check
--> description => Sprawdź typy
-> validate
--> run => bit run -- validate ../LegendaryOS
--> description => Zwaliduj źródła dystrybucji
-> plan
--> run => bit run -- plan ../LegendaryOS
--> description => Pokaż kroki budowy (dry-run)
-> bootstrap-plan
--> run => bit run -- build ../LegendaryOS --only packages --dry-run
--> description => Pokaż polecenie lepm bootstrap (bez wykonywania)
